@page "/"
@implements IDisposable
@using Contactor.Boards
@using Contactor.Web.Features.BoardRules
@using Contactor.Web.Features.Boards
@using Contactor.Web.Features.Events
@using Contactor.Web.Features.Groups
@using Contactor.Web.Features.Identity
@using Contactor.Web.Features.Inputs
@using Contactor.Web.Features.Languages
@using Contactor.Web.Features.Relays
@using Contactor.Web.Features.Schedules
@using Contactor.Web.Persistence
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject BoardRegistry Registry
@inject RelayControl Control
@inject RelayChanges Changes
@inject CurrentUser CurrentUser
@inject LocalClock Clock
@inject TimeProvider Time
@inject ScheduleOutlook Outlook
@inject IDbContextFactory<ContactorDbContext> DbFactory
@inject GroupsHandler Groups
@inject InputsHandler Inputs
@inject AnalogInputsHandler Analog
@inject InputActionsHandler InputActions
@inject GroupSequencer Sequencer
@inject ILogger<Relays> Log
@inject RelayStatusText StatusText
@inject BoardsText BoardsText
@inject BoardProblemText ProblemText
@inject GroupStatusText GroupStatus
@inject InputsText InputsText
@inject AppLanguage Language
@inject OwnRulesHandler OwnRules
@inject OwnRulesService OwnRuleRows
@inject OwnRulesText OwnRulesText
@inject RelayPowerOnHandler PowerOn

<PageTitle>@(Texts["Common.PageTitle", Texts["Common.Screen.Relays"]])</PageTitle>

@* The board's own rules each board's box and cards show, kept as they are drawn: a change that alters none of them
   redraws nothing (OnOwnRulesChanged). *@
@{ KeepShownRules(); }

<div class="screen">
    <header class="header">
        <div class="title">
            <h1>Contactor</h1>
            <p class="summary">
                @if (_user is not null)
                {
                    @Texts["Relays.Hi", _user.DisplayName]
                }
                @* Before a board's first answer nothing is known to be on. *@
                @if (AnyAnswered)
                {
                    var all = CountOf(Boards);
                    @(_user is not null ? " · " : "")<strong>@Texts["Relays.OnCount", all.On, all.Active]</strong>
                }
            </p>
        </div>
        <div class="actions">
            @* On a desktop "New group" sits here, beside "All off"; on a phone or tablet it is under the cards. *@
            @if (Boards.Count > 0)
            {
                <a href="group/new" class="new-group in-header">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
                    @Texts["Relays.NewGroup"]
                </a>
            }
            @* No board: nothing to turn off, and "Add a board" is the way on. *@
            @if (Several)
            {
                @* Every board at once, so it asks first; each board has its own "All off" in its section. *@
                <button type="button" class="all-boards-off" disabled="@(!AnyConnected || _busy)" @onclick="() => _confirmAllBoards = true">@Texts["Relays.AllBoardsOff"]</button>
            }
            else if (Boards.Count == 1)
            {
                <button type="button" class="all-off" data-vibrate disabled="@(!State.IsConnected || _busy)" @onclick="() => TurnBoardOffAsync(OnlyBoardId)">@Texts["Relays.AllOff"]</button>
            }
        </div>
    </header>

    @if (Several)
    {
        <div class="boards-bar">
            @if (_allBoardsMessage is not null)
            {
                <p class="error" role="alert">@_allBoardsMessage</p>
            }
            @* The board filter is this browser's: a tap posts the new choice, which comes back as a cookie (RelaysEndpoints). *@
            <BoardPicker Screen="BoardFilterScreen.Relays" Boards="Boards" Filter="Filter" Counts="_counts" Showing="@ShowingText" />
            @* A board out of contact is never out of sight: a line for each one the filter hides. *@
            @foreach (var board in Boards.Where(b => !Filter.Shows(b.BoardId) && !b.State.IsConnected))
            {
                <p class="lost-line" role="status" @key="board.BoardId">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"></path><path d="M12 17h.01"></path><path d="M10.3 3.9L2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg>
                    <span><strong>@board.Name:</strong> @NoContactSince(board.State)</span>
                </p>
            }
        </div>
    }
    else if (Boards.Count == 0)
    {
        @* Every board removed: nothing to show or switch. *@
        <div class="connection">
            <p class="no-board" role="status">@Texts["Common.NoBoard"]</p>
            <a href="board/new" class="add-board">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
                @Texts["Common.AddBoard"]
            </a>
        </div>
    }
    else
    {
        @* One board: nothing to filter, so no chips; the side menu shows the board (BoardPicker). *@
        <div class="connection">
            @ConnectionLine(State, null)
            @OwnRulesBox(OnlyOne, null)
            @if (_allOffFailedBoardId is not null)
            {
                <p class="error" role="alert">@Texts["Common.BoardNotResponding"]</p>
            }
        </div>
    }

    <main class="relays">
        @* Every analog value is kept again as it is drawn: a reading that changes none of them redraws nothing. *@
        @{ _shownAnalog.Clear(); }
        @* Groups first, then the relays, each in a grid of its own, so cards line up and Tab goes row by row. *@
        @if (ShownGroups.Any())
        {
            <section class="section" aria-labelledby="groups-heading">
                <h2 class="section-title" id="groups-heading">@Texts["Relays.Groups"]</h2>
                <div class="cards group-cards">
                    @foreach (var group in ShownGroups)
                    {
                        @GroupCard(group)
                    }
                </div>
            </section>
        }

        @if (Several)
        {
            @* A section per board, in the boards' order: its name, its own connection and "All off", its relays and inputs. *@
            @foreach (var board in ShownBoards)
            {
                var state = board.State;
                var count = CountOf(board.BoardId);
                var relays = VisibleRelaysOf(board.BoardId).ToList();
                var unavailable = UnavailableRelaysOf(board.BoardId).ToList();
                var inputs = VisibleInputsOf(board.BoardId).ToList();
                var analog = VisibleAnalogOf(board.BoardId).ToList();
                <section class="section board" aria-labelledby="@($"board-{board.BoardId}")" @key="board.BoardId">
                    <div class="board-head">
                        <h2 class="board-name" id="@($"board-{board.BoardId}")">@board.Name</h2>
                        <span class="model">@(board.Model?.Name ?? Texts["Common.NoModel"])@(state.HasAnswered ? $" · {Texts["Relays.OnCount", count.On, count.Active]}" : "")</span>
                        <button type="button" class="board-off" data-vibrate aria-label="@Texts["Relays.AllOffOn", board.Name]" disabled="@(!state.IsConnected || _busy)" @onclick="() => TurnBoardOffAsync(board.BoardId)">@Texts["Relays.AllOff"]</button>
                    </div>
                    <div class="board-line">
                        @ConnectionLine(state, board.Name)
                        @OwnRulesBox(board, board.Name)
                        @if (_allOffFailedBoardId == board.BoardId)
                        {
                            <p class="error" role="alert">@Texts["Common.BoardNotResponding"]</p>
                        }
                    </div>
                    @if (relays.Count > 0)
                    {
                        <h3 class="section-title">@Texts["Relays.Relays"]</h3>
                        <div class="cards relay-cards">
                            @foreach (var relay in relays)
                            {
                                @RelayCard(relay)
                            }
                        </div>
                    }
                    @if (unavailable.Count > 0)
                    {
                        <h3 class="section-title">@Texts["OwnRules.Unavailable.Heading"]</h3>
                        <div class="cards relay-cards">
                            @foreach (var relay in unavailable)
                            {
                                @UnavailableCard(relay)
                            }
                        </div>
                    }
                    @if (inputs.Count > 0 || analog.Count > 0)
                    {
                        <h3 class="section-title">@Texts["Relays.Inputs"]</h3>
                        <div class="cards input-cards">
                            @foreach (var input in inputs)
                            {
                                @InputCard(input)
                            }
                            @foreach (var input in analog)
                            {
                                @AnalogCard(input)
                            }
                        </div>
                    }
                </section>
            }
        }
        else
        {
            @* No relay card to show (all in groups, or the rest hidden as inactive): no empty section and no extra gap. *@
            @if (VisibleRelays.Any())
            {
                <section class="section" aria-labelledby="@(ShowRelaysHeading ? "relays-heading" : null)">
                    @if (ShowRelaysHeading)
                    {
                        <h2 class="section-title" id="relays-heading">@Texts["Relays.Relays"]</h2>
                    }
                    <div class="cards relay-cards">
                        @foreach (var relay in VisibleRelays)
                        {
                            @RelayCard(relay)
                        }
                    </div>
                </section>
            }

            @* The relays the board controls by itself (e.g. a Waveshare relay in linkage mode): no ON/OFF, only "Reset". *@
            @if (UnavailableRelays.Any())
            {
                <section class="section" aria-labelledby="unavailable-heading">
                    <h2 class="section-title" id="unavailable-heading">@Texts["OwnRules.Unavailable.Heading"]</h2>
                    <div class="cards relay-cards">
                        @foreach (var relay in UnavailableRelays)
                        {
                            @UnavailableCard(relay)
                        }
                    </div>
                </section>
            }

            @* The board's inputs: what it reads, e.g. a door contact, then its analog inputs, e.g. a temperature. No button:
               the app can't switch them. *@
            @if (VisibleInputs.Any() || VisibleAnalog.Any())
            {
                <section class="section" aria-labelledby="inputs-heading">
                    <h2 class="section-title" id="inputs-heading">@Texts["Relays.Inputs"]</h2>
                    <div class="cards input-cards">
                        @foreach (var input in VisibleInputs)
                        {
                            @InputCard(input)
                        }
                        @foreach (var input in VisibleAnalog)
                        {
                            @AnalogCard(input)
                        }
                    </div>
                </section>
            }
        }

        @if (Boards.Count > 0)
        {
            <a href="group/new" class="new-group">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
                @Texts["Relays.NewGroup"]
            </a>
        }

        @if (InactiveCount > 0)
        {
            <button type="button" class="show-inactive" aria-expanded="@(_showInactive ? "true" : "false")" @onclick="() => _showInactive = !_showInactive">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                @InactiveButtonText
            </button>
        }
    </main>

    @if (_confirmAllBoards)
    {
        <div class="backdrop">
            <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title">
                <h2 id="confirm-title">@BoardsText.ConfirmAllOff(RelaysOnNow, Boards.Count)</h2>
                <p>@Texts["Relays.ConfirmAllOff.Text"]</p>
                <div class="dialog-buttons">
                    <button type="button" class="cancel" @onclick="() => _confirmAllBoards = false">@Texts["Common.Cancel"]</button>
                    <button type="button" class="confirm" data-vibrate disabled="@(_busy || !AnyConnected)" @onclick="TurnOffAllBoardsAsync">@Texts["Relays.TurnOff"]</button>
                </div>
            </div>
        </div>
    }

    <TabBar Current="TabBar.Tab.Relays" SideList="@(Boards.Count > 0 ? BoardList : null)" />
</div>

@code {
    private List<Relay> _relays = [];
    private BoardCounts _counts = BoardCounts.None;
    private IReadOnlyList<GroupView> _groups = [];
    private IReadOnlyList<InputView> _inputs = [];
    private IReadOnlyList<AnalogInputView> _analog = [];

    // What each analog card shows: a new reading redraws the page only when it changes one (OnAnalogChanged).
    private readonly ShownAnalogValues _shownAnalog = new(showsVolts: false);

    // The board's own rules each board's warning and cards show, by board id: kept as the page is drawn.
    private readonly Dictionary<int, IReadOnlyList<OwnRule>> _shownRules = [];

    // The other rules each board's "Turn them off" takes with it (OwnRulesHandler.AlsoTurnsOff), by board id: kept as
    // the page is drawn.
    private readonly Dictionary<int, IReadOnlyList<OwnRule>> _shownAlso = [];

    // The rules each board's "Turn them off" turns off (OwnRulesHandler.TurnsOff), by board id: kept as the page is drawn.
    private readonly Dictionary<int, IReadOnlyList<OwnRule>> _shownTurnsOff = [];

    // The relays each board controls by itself, by board id: kept as the page is drawn.
    private readonly Dictionary<int, ChannelMask> _shownUnavailable = [];

    // "Turn them off" that went wrong, on the board's warning.
    private (int BoardId, string Message)? _rulesError;

    // "Reset" that went wrong, under the relay's or the group's card, by the relay's or the group's key.
    private (string Key, string Message)? _resetError;

    // The relays each group's power-cut warning names, by the group's id: kept as the page is drawn.
    private readonly Dictionary<int, ChannelMask> _shownNotSafe = [];

    // "Make it safe" that went wrong, under the group's warning.
    private (int GroupId, string Message)? _powerOnError;

    // The inputs that control each relay and each group, by its id.
    private ILookup<int, InputControl> _relayInputs = Array.Empty<InputControl>().ToLookup(c => 0);
    private ILookup<int, InputControl> _groupInputs = Array.Empty<InputControl>().ToLookup(c => 0);
    private int? _failedGroupId;
    private string? _groupError;
    private ITimer? _tick;

    // Set when the page closes, on the page's own thread: a page closed while it loads doesn't subscribe, and an event
    // already on its way doesn't load or draw a closed page.
    private bool _disposed;
    private Dictionary<int, RelayRuntime> _runtimes = [];
    private Dictionary<string, string> _names = [];
    private Dictionary<int, EventLogEntry> _lastOff = [];
    private IReadOnlyDictionary<int, RelayOutlook> _outlook = new Dictionary<int, RelayOutlook>();
    private IReadOnlyDictionary<int, RelayOutlook> _groupOutlook = new Dictionary<int, RelayOutlook>();
    private SignedInUser? _user;
    private bool _showInactive;
    private bool _busy;

    // The board whose "All off" found it without contact; its section (or, with one board, the connection line) says so.
    private int? _allOffFailedBoardId;
    private int? _failedRelayId;

    // "Turn off all boards": asking first, and then the boards it couldn't reach.
    private bool _confirmAllBoards;
    private string? _allBoardsMessage;

    // A press the board didn't confirm, shown under its relay until the person chooses.
    private UnconfirmedPress? _unconfirmed;
    private bool _inGroup;

    // The last press was refused: a pulse the app started runs on that relay.
    private bool _pulsing;

    // The press was refused because its board is being removed (BoardClosedException).
    private bool _beingRemoved;

    /// <summary>The boards this browser picked to show (<see cref="BoardFilter"/>), as the page was opened.</summary>
    [CascadingParameter]
    public BoardFilters? PickedBoards { get; set; }

    // Every board but one "Add a board" hasn't finished: that one shows once it is done.
    private IReadOnlyList<LiveBoard> Boards => Registry.Shown;

    // Two or more boards: a section per board, "All boards" in the filter, and "Turn off all boards". One board has one
    // list of relays, no chips, and only the board in the side menu (BoardPicker).
    private bool Several => Boards.Count > 1;

    // With one board: that board. Before the app has a board, none (no relays, never answers). One read of the list:
    // a board added or removed between two reads can't make it throw.
    private LiveBoard? OnlyOne => Boards is [var only] ? only : null;

    private int? OnlyBoardId => OnlyOne?.BoardId;

    // The one board's state; with several boards each card takes its own board's (StateOf).
    private BoardState State => OnlyOne?.State ?? BoardState.Initial;

    // Made again only when the boards or the picked filter change: it is read for each relay.
    private BoardFilter Filter
    {
        get
        {
            var boards = Boards;
            var picked = PickedBoards?.Relays ?? BoardFilter.All;
            if (_filter is not { } cached || !ReferenceEquals(cached.Boards, boards) || !ReferenceEquals(cached.Picked, picked))
            {
                _filter = cached = (boards, picked, picked.For([.. boards.Select(b => b.BoardId)]));
            }

            return cached.Filter;
        }
    }

    private (IReadOnlyList<LiveBoard> Boards, BoardFilter Picked, BoardFilter Filter)? _filter;

    private IReadOnlyList<LiveBoard> ShownBoards => [.. Boards.Where(b => Filter.Shows(b.BoardId))];

    private IEnumerable<GroupView> ShownGroups => _groups.Where(g => Filter.Shows(g.BoardId));

    private bool AnyAnswered => Boards.Any(b => b.State.HasAnswered);

    private bool AnyConnected => Boards.Any(b => b.State.IsConnected);

    // What "Turn off all boards" asks about: the relays on now, on every board.
    private int RelaysOnNow => Boards.Sum(b => b.State.Relays.Count);

    // A pulse the app started runs on the relay: its button is locked until it has ended (AppPulses).
    private bool IsPulsing(Relay relay)
    {
        return Registry.Find(relay.BoardId)?.IsPulsing(relay.Channel) == true;
    }

    private BoardState StateOf(int boardId)
    {
        return Registry.Find(boardId)?.State ?? BoardState.Initial;
    }

    private string BoardNameOf(int boardId)
    {
        return Registry.Find(boardId)?.Name ?? "";
    }

    // A group counts as one, and its relays aren't listed on their own. Only what the board has answered counts as on.
    private (int On, int Active) CountOf(int boardId)
    {
        return _counts.Of(boardId, StateOf(boardId));
    }

    private (int On, int Active) CountOf(IEnumerable<LiveBoard> boards)
    {
        var counts = boards.Select(b => CountOf(b.BoardId)).ToList();
        return (counts.Sum(c => c.On), counts.Sum(c => c.Active));
    }

    // "Showing 2 of 9 boards · 7 of 28 on" while filtered.
    private string? ShowingText
    {
        get
        {
            if (Filter.IsAll)
            {
                return null;
            }

            var shown = CountOf(ShownBoards);
            return BoardsText.Showing(ShownBoards.Count, Boards.Count, shown.On, shown.Active);
        }
    }

    private string NoContactSince(BoardState state)
    {
        return !state.HasAnswered ? Texts["Relays.Lost.Yet"]
            : state.LastContactUtc is { } last ? Texts["Relays.Lost.Since", StatusText.When(Clock.ToLocal(last.UtcDateTime), Clock.Now)]
            : Texts["Relays.Lost.None"];
    }

    // The relays with an ON/OFF: not one its board controls by itself, which has a section of its own.
    private IEnumerable<Relay> VisibleRelays => _relays.Where(r => (r.IsActive || _showInactive) && Filter.Shows(r.BoardId) && !IsUnavailable(r));

    // The relays the board controls by itself and ignores the app's commands for (BoardState.Unavailable).
    private IEnumerable<Relay> UnavailableRelays => _relays.Where(r => (r.IsActive || _showInactive) && Filter.Shows(r.BoardId) && IsUnavailable(r));

    private IEnumerable<Relay> UnavailableRelaysOf(int boardId) => UnavailableRelays.Where(r => r.BoardId == boardId);

    private bool IsUnavailable(Relay relay)
    {
        return StateOf(relay.BoardId).Unavailable.Contains(relay.Channel);
    }

    private IEnumerable<InputView> VisibleInputs => _inputs.Where(i => (i.IsActive || _showInactive) && Filter.Shows(i.BoardId));

    private IEnumerable<AnalogInputView> VisibleAnalog => _analog.Where(i => (i.IsActive || _showInactive) && Filter.Shows(i.BoardId));

    private IEnumerable<Relay> VisibleRelaysOf(int boardId) => VisibleRelays.Where(r => r.BoardId == boardId);

    private IEnumerable<InputView> VisibleInputsOf(int boardId) => VisibleInputs.Where(i => i.BoardId == boardId);

    private IEnumerable<AnalogInputView> VisibleAnalogOf(int boardId) => VisibleAnalog.Where(i => i.BoardId == boardId);

    private int InactiveRelays => _relays.Count(r => !r.IsActive && Filter.Shows(r.BoardId));

    // Analog inputs count as inputs: for the person, an input is an input.
    private int InactiveInputs => _inputs.Count(i => !i.IsActive && Filter.Shows(i.BoardId)) + _analog.Count(i => !i.IsActive && Filter.Shows(i.BoardId));

    private int InactiveCount => InactiveRelays + InactiveInputs;

    // "Relays" only sets the relays apart from the groups or the inputs (its section is only there over cards).
    private bool ShowRelaysHeading => _groups.Count > 0 || VisibleInputs.Any() || VisibleAnalog.Any() || UnavailableRelays.Any();

    private string InactiveButtonText => InputsText.Inactive(InactiveRelays, InactiveInputs, _showInactive);

    private string UpdatedText(BoardState state)
    {
        var age = Clock.UtcNow - (state.LastContactUtc?.UtcDateTime ?? Clock.UtcNow);
        return age < TimeSpan.FromMinutes(1) ? Texts["Relays.Updated.Now"] : Texts["Relays.Updated.MinutesAgo", (int)age.TotalMinutes];
    }

    // A board's connection: online, or a red box. With one board it is "the relay board"; with several, the board's name.
    private RenderFragment ConnectionLine(BoardState state, string? boardName) => __builder =>
    {
        if (state.IsConnected)
        {
            <p class="online"><span class="dot" aria-hidden="true"></span>@Texts[boardName is null ? "Relays.Online.One" : "Relays.Online.Several", UpdatedText(state)]</p>
        }
        else
        {
            <div class="offline" role="status">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"></path><path d="M12 17h.01"></path><path d="M10.3 3.9L2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg>
                <div>
                    @* Why, when the board says: "The password is wrong. See Settings." in place of the line under the heading. *@
                    @if (state.HasAnswered)
                    {
                        <strong>@(boardName is null ? Texts["Relays.NoContact.One"] : Texts["Relays.NoContact.Named", boardName])</strong>
                        <span>@(state.Problem is { } problem ? Texts["Relays.Problem.SeeSettings", ProblemText.Long(problem)] : state.LastContactUtc is { } last ? Texts["Relays.NoContact.Since", StatusText.When(Clock.ToLocal(last.UtcDateTime), Clock.Now)] : Texts["Relays.NoContact.MayBeWrong"])</span>
                    }
                    else
                    {
                        <strong>@(boardName is null ? Texts["Relays.NoContactYet.One"] : Texts["Relays.NoContactYet.Named", boardName])</strong>
                        <span>@(state.Problem is { } problem ? Texts["Relays.Problem.SeeSettings", ProblemText.Long(problem)] : Texts["Relays.NoContact.FirstAnswer"])</span>
                    }
                </div>
            </div>
        }
    };

    // A warning under the board's connection line while it has rules of its own that switch relays without the app,
    // e.g. the VM201's timers, that no person kept. Only while the board answers; nothing for a board that can't tell.
    private RenderFragment OwnRulesBox(LiveBoard? board, string? boardName) => __builder =>
    {
        if (board is null || _shownRules.GetValueOrDefault(board.BoardId) is not { Count: > 0 } rules)
        {
            return;
        }

        <div class="offline own-rules" role="status">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"></path><path d="M12 17h.01"></path><path d="M10.3 3.9L2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg>
            <div>
                <strong>@OwnRulesText.Heading(rules, boardName)</strong>
                <span>@OwnRulesText.CanSwitch(rules)</span>
                @* A rule that runs on the board right now, in a group of its own (issue #552). *@
                <OwnRulesRunning Channels="@([.. rules.Where(r => OwnRules.RunsOnBoard(board.BoardId, r)).Select(r => r.Relay).Distinct()])" Names="RelayNames(board.BoardId)" />
                @* Only the rules the app can turn off: not a timer the board runs now and ends by itself. *@
                @if (_shownTurnsOff.GetValueOrDefault(board.BoardId) is { Count: > 0 } turnsOff)
                {
                    @* Said before the press: other relays' rules that go with these ("Also turns off the board's timer for Heat."). *@
                    @if (_shownAlso.GetValueOrDefault(board.BoardId) is { Count: > 0 } also)
                    {
                        <span class="also">@OwnRulesText.AlsoTurnsOff(also, RelayNames(board.BoardId))</span>
                    }
                    <button type="button" class="turn-off-rules" disabled="@(_busy || !board.State.IsConnected)" @onclick="() => TurnOffRulesAsync(board.BoardId, turnsOff)">@OwnRulesText.TurnOffAll(turnsOff.Count)</button>
                }
                @if (_rulesError is { } error && error.BoardId == board.BoardId)
                {
                    <span class="rules-error" role="alert">@error.Message</span>
                }
            </div>
        </div>
    };

    // A line on the card of a relay the board's own rules can switch: "(clock) The board's timer can switch it".
    private RenderFragment OwnRuleLine(Relay relay) => __builder =>
    {
        if (_shownRules.GetValueOrDefault(relay.BoardId) is not { Count: > 0 } rules || !rules.Any(r => r.Relay == relay.Channel))
        {
            return;
        }

        <span class="input-line own-rule-line">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
            <span>@OwnRulesText.CardLine(rules.Where(r => r.Relay == relay.Channel).Select(r => r.Kind))</span>
        </span>
    };

    // A line on the card of a group whose relays the board's own rules can switch, naming them by their role in the
    // group: "(clock) The board's timer can switch Heat". The relays have no card of their own.
    private RenderFragment OwnRuleGroupLine(GroupView group) => __builder =>
    {
        if (_shownRules.GetValueOrDefault(group.BoardId) is not { Count: > 0 } rules)
        {
            return;
        }

        var members = group.Members.Where(m => rules.Any(r => r.Relay == m.Channel)).ToList();
        if (members.Count == 0)
        {
            return;
        }

        var channels = members.Select(m => m.Channel).ToHashSet();
        <span class="input-line own-rule-line">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
            <span>@OwnRulesText.GroupLine(rules.Where(r => channels.Contains(r.Relay)).Select(r => r.Kind), members.Select(m => m.RoleName))</span>
