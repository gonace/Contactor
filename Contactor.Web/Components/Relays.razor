    // An analog input: its value on the right, as large as its name, and a line only when there is no value to show.
    // No outline around the value: it isn't a button.
    private RenderFragment AnalogCard(AnalogInputView input) => __builder =>
    {
        var board = Registry.Find(input.BoardId);
        var value = _shownAnalog.Show(input, board?.Capabilities.Analog, board?.State ?? BoardState.Initial);
        var waiting = value.State == AnalogValueState.Waiting;
        var problem = value.State is AnalogValueState.NoReading or AnalogValueState.AboveRange;
        <div class="card input analog @(input.IsActive ? "" : "inactive") @(waiting ? "unknown" : "")" @key="@($"a{input.Id}")">
            <a class="text" href="analog/@input.Id">
                <span class="label">@Texts["Relays.AnalogLabel", input.Channel]</span>
                <span class="name">@input.Name</span>
                @if (waiting)
                {
                    <span class="status">@StatusText.Waiting</span>
                }
                else if (problem)
                {
                    <span class="status problem">@Texts[value.State == AnalogValueState.NoReading ? "Analog.NoReading" : "Analog.AboveRange"]</span>
                }
            </a>
            @* Without a value, a screen reader hears "No value" rather than the dash. *@
