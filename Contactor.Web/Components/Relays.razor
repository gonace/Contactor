    // What each board's warning shows now: only while the board answers. Not a relay the board controls by itself:
    // that one is shown as unavailable instead, with its own "Reset".
    private IReadOnlyList<OwnRule> RulesToShow(LiveBoard board)
    {
        return board.State.IsConnected ? [.. OwnRules.Warnings(board.BoardId).Where(r => r.Kind != OwnRuleKind.InputLinkage)] : [];
    }

    // The warning's rules that "Turn them off" turns off: none on a board that can't, nor a rule it can't turn off now.
    private IReadOnlyList<OwnRule> TurnsOffToShow(LiveBoard board, IReadOnlyList<OwnRule> rules)
    {
        return rules.Count > 0 ? OwnRules.TurnsOff(board.BoardId, rules) : [];
    }

    // What turning off the warning's rules takes with it: only for a board that turns them off.
    private IReadOnlyList<OwnRule> AlsoToShow(LiveBoard board, IReadOnlyList<OwnRule> rules)
    {
        return rules.Count > 0 && board.Capabilities.OwnRulesOrCantTell.TurnsOff ? OwnRules.AlsoTurnsOff(board.BoardId, rules) : [];
    }

    // A board's relays by their channel, to their names.
    private Dictionary<int, string> RelayNames(int boardId)
    {
        return _relays.Where(r => r.BoardId == boardId).GroupBy(r => r.Channel).ToDictionary(g => g.Key, g => g.First().Name);
    }

    private void KeepShownRules()
    {
        _shownRules.Clear();
        _shownAlso.Clear();
        _shownTurnsOff.Clear();
        _shownUnavailable.Clear();
        foreach (var board in Boards)
        {
            _shownRules[board.BoardId] = RulesToShow(board);
            _shownTurnsOff[board.BoardId] = TurnsOffToShow(board, _shownRules[board.BoardId]);
            _shownAlso[board.BoardId] = AlsoToShow(board, _shownTurnsOff[board.BoardId]);
            _shownUnavailable[board.BoardId] = board.State.Unavailable;
        }

        _shownNotSafe.Clear();
        foreach (var group in _groups)
        {
            _shownNotSafe[group.Id] = ChannelMask.Of(NotSafe(group).Select(m => m.Channel));
        }
    }

    // From a board's read loop: only the relays' states after a power cut changed. A redraw only when a group's warning
    // would name other relays.
    private void OnPowerOnChanged(object? sender, BoardStateChange change)
    {
        _ = RedrawForPowerOnAsync(change.BoardId);
    }

    private async Task RedrawForPowerOnAsync(int boardId)
    {
        using var language = Language.Use();
        try
        {
            await InvokeAsync(() =>
            {
                // On the page's own thread, as Dispose is: a closed page draws nothing.
                if (_disposed)
                {
                    return;
                }

                if (_groups.Any(g => g.BoardId == boardId && ChannelMask.Of(NotSafe(g).Select(m => m.Channel)) != _shownNotSafe.GetValueOrDefault(g.Id)))
                {
                    StateHasChanged();
                }
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the change was on its way.
        }
    }

    // "Make it safe": sets the group's relays the board turns on by itself after a power cut to Off on the board, as the
    // person pressed, and logs it. Nothing is sent or queued without a connection.
