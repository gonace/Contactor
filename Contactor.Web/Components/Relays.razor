    // The desktop's side menu: every board, to pick which to show.
    private RenderFragment BoardList => __builder =>
    {
        <BoardPicker Side="true" Screen="BoardFilterScreen.Relays" Boards="Boards" Filter="Filter" Counts="_counts" />
    };

    private RenderFragment GroupCard(GroupView group) => __builder =>
    {
        var state = StateOf(group.BoardId);
        var groupOn = group.IsOn(state);
        var missing = group.MissingRelay(Registry.Find(group.BoardId)?.Capabilities.RelayCount ?? 0);
        var level = GroupPlanner.Level(group.Steps, state);
        var unavailable = group.Members.Where(m => state.Unavailable.Contains(m.Channel)).ToList();
        var reach = GroupPlanner.Reach(group.Steps, state);

        // Lit while any of it runs in order, e.g. only Fan 1; not while a relay is on out of order.
        var lit = group.Runtime.Phase == GroupPhases.Starting || (groupOn && reach > 0 && reach <= level + 1);
        @* With several boards the label names the group's board: "GROUP · WORKSHOP 1 → 2". *@
        var chain = Several ? $"{BoardNameOf(group.BoardId).ToUpperInvariant()} {group.Channels}" : GroupStatus.Chain(group);
        <div class="card group @(lit && state.HasAnswered ? "on" : null) @(group.Runtime.Phase == GroupPhases.Stopping && state.HasAnswered ? "stopping" : null) @(state.HasAnswered ? null : "unknown")" @key="@($"g{group.Id}")">
            <div class="top">
                <span class="icon" aria-hidden="true"><GroupIcon Icon="@group.Icon" /></span>
                <a class="text" href="group/@group.Id">
                    <span class="label">@Texts["Relays.GroupLabel", chain]</span>
                    <span class="name">@group.Name</span>
                    <span class="status @(group.Runtime.Phase != GroupPhases.Idle && state.HasAnswered ? "busy" : null)">@(!state.HasAnswered ? StatusText.Waiting : missing is { } m ? GroupStatus.MissingRelay(m) : GroupStatus.For(group, state, Clock.UtcNow, Clock.ToLocal, NameOf, _groupOutlook.GetValueOrDefault(group.Id)))</span>
                    @InputLines(_groupInputs[group.Id])
                    @OwnRuleGroupLine(group)
                    @if (_failedGroupId == group.Id)
                    {
                        <span class="error" role="alert">@_groupError</span>
                    }
                </a>
                @if (state.HasAnswered)
                {
                    @* A group the board controls a relay of by itself doesn't start; it still stops. *@
                    <button type="button"
                            data-vibrate
                            class="toggle"
                            aria-pressed="@(groupOn ? "true" : "false")"
                            aria-label="@Texts[groupOn ? "Common.TurnOff" : "Common.TurnOn", group.Name]"
                            disabled="@(!state.IsConnected || _busy || missing is not null || (!groupOn && unavailable.Count > 0))"
                            @onclick="() => ToggleGroupAsync(group.Id, groupOn)">@Texts[groupOn ? "Common.Switch.On" : "Common.Switch.Off"]</button>
                }
                else
                {
                    <button type="button" class="toggle unknown" aria-label="@Texts["Common.NameAndState", group.Name, StatusText.Waiting]" disabled>–</button>
                }
            </div>
            @if (unavailable.Count > 0)
            {
                @GroupUnavailableBox(group, unavailable)
            }
            @if (NotSafe(group) is { Count: > 0 } notSafe)
            {
                @GroupPowerOnBox(group, notSafe)
            }
            <ol class="chips" aria-label="@Texts["Groups.Steps"]">
                @for (var i = 0; i < group.Steps.Count; i++)
                {
                    var step = group.Steps[i];
                    var on = step.Relays.Count(r => state.IsOn(r.Channel));
                    var chipState = on == 0 ? null : on == step.Relays.Count ? "on" : "partly";
                    <li>
                        @if (i > 0)
                        {
                            <span class="arrow" aria-hidden="true">→</span>
                        }
                        <span class="chip @chipState"><span class="dot" aria-hidden="true"></span>@step.Name<span class="visually-hidden">@(!state.HasAnswered ? Texts["Relays.Chip.Unknown"] : chipState == "partly" ? Texts["Relays.Chip.Partly"] : Texts[chipState == "on" ? "Relays.Chip.On" : "Relays.Chip.Off"])</span></span>
                    </li>
                }
            </ol>
        </div>
    };

    private RenderFragment RelayCard(Relay relay) => __builder =>
    {
        var state = StateOf(relay.BoardId);
        var on = state.IsOn(relay.Channel);
        var pulsing = IsPulsing(relay);
        <div class="card @(on ? "on" : "") @(relay.IsActive ? "" : "inactive") @(state.HasAnswered ? "" : "unknown")" @key="relay.Id">
            <a class="text" href="relay/@relay.Id">
                <span class="label">@Texts["Relays.RelayLabel", relay.Channel]</span>
                <span class="name">@relay.Name</span>
                <span class="status">@(state.HasAnswered ? StatusFor(relay, on) : StatusText.Waiting)</span>
                @InputLines(_relayInputs[relay.Id])
                @OwnRuleLine(relay)
                @if (_failedRelayId == relay.Id && _inGroup)
                {
                    <span class="error" role="alert">@Texts["Relays.InGroup"]</span>
                }
                else if (_failedRelayId == relay.Id && _beingRemoved)
                {
                    <span class="error" role="alert">@Texts["Boards.BeingRemoved"]</span>
                }
                else if (_failedRelayId == relay.Id && _pulsing)
                {
                    <span class="error" role="alert">@Texts["Relays.Pulsing"]</span>
                }
            </a>
            @if (state.HasAnswered && pulsing)
            {
                @* A pulse the app started runs: no press until it has ended (AppPulses). *@
                <button type="button" class="toggle" aria-pressed="@(on ? "true" : "false")" aria-label="@Texts["Common.NameAndState", relay.Name, Texts["Common.Pulsing"]]" disabled>@Texts["Common.Pulsing"]</button>
            }
            else if (state.HasAnswered)
            {
                <button type="button"
                        data-vibrate
                        class="toggle"
                        aria-pressed="@(on ? "true" : "false")"
                        aria-label="@Texts[on ? "Common.TurnOff" : "Common.TurnOn", relay.Name]"
                        disabled="@(!state.IsConnected || _busy)"
                        @onclick="() => ToggleAsync(relay, on)">@Texts[on ? "Common.Switch.On" : "Common.Switch.Off"]</button>
