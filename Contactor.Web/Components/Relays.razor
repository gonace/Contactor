    // From a board's read loop: only its own rules changed.
    private void OnOwnRulesChanged(object? sender, BoardStateChange change)
    {
        _ = RedrawForRulesAsync(change.BoardId);
    }

    // A rule kept, found or gone: OwnRulesService's rows, which the warnings leave the kept rules out by.
    private void OnOwnRuleRowsChanged(object? sender, int boardId)
    {
        _ = RedrawForRulesAsync(boardId);
    }

    // A redraw only when the board's warning or cards would show other rules.
    private async Task RedrawForRulesAsync(int boardId)
    {
        using var language = Language.Use();
        try
        {
            await InvokeAsync(() =>
            {
                // On the page's own thread, as Dispose is: a closed page draws nothing.
                if (_disposed || Boards.FirstOrDefault(b => b.BoardId == boardId) is not { } board)
                {
                    return;
                }

                var rules = RulesToShow(board);
                var turnsOff = TurnsOffToShow(board, rules);
                if (!rules.SequenceEqual(_shownRules.GetValueOrDefault(boardId) ?? [])
                    || !turnsOff.SequenceEqual(_shownTurnsOff.GetValueOrDefault(boardId) ?? [])
                    || !AlsoToShow(board, turnsOff).SequenceEqual(_shownAlso.GetValueOrDefault(boardId) ?? [])
                    || board.State.Unavailable != _shownUnavailable.GetValueOrDefault(boardId))
                {
                    StateHasChanged();
                }
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the change was on its way.
        }
    }

    // These events come from other threads (a board's read loop, another person's circuit).
    private void OnBoardChanged(object? sender, BoardStateChange change)
    {
        _ = RefreshAsync(reload: false);
    }

    // Only a board's analog readings changed, on most polls: a redraw only when a card's value or line changes.
    private void OnAnalogChanged(object? sender, BoardStateChange change)
    {
        _ = RedrawForReadingAsync(change.BoardId);
    }

    // A board was added: its relays, inputs and section.
    private void OnBoardsChanged(object? sender, EventArgs e)
    {
        _ = RefreshAsync(reload: true);
    }

    private void OnRelaysChanged(object? sender, EventArgs e)
    {
        _ = RefreshAsync(reload: true);
    }

    // On the page's own thread, as it draws, so a reading can't come between drawing a card and keeping what it shows.
    private async Task RedrawForReadingAsync(int boardId)
    {
        using var language = Language.Use();
        try
        {
            await InvokeAsync(() =>
            {
                // On the page's own thread, as Dispose is: a closed page draws nothing.
                if (_disposed)
                {
                    return;
                }

                if (Registry.Find(boardId) is { } board && _shownAnalog.Changes(boardId, board.Capabilities.Analog, board.State))
                {
                    StateHasChanged();
                }
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the reading was on its way.
        }
    }

    private async Task RefreshAsync(bool reload)
    {
        using var language = Language.Use();
        try
        {
            await InvokeAsync(async () =>
            {
                // On the page's own thread, as Dispose is: a closed page loads and draws nothing.
                if (_disposed)
                {
                    return;
                }

                if (reload)
                {
                    await LoadAsync();
                }

                // The board shows the relay as the person wanted it: nothing left to decide.
                if (_unconfirmed is { } press && press.IsSettledBy(StateOf(_relays.FirstOrDefault(r => r.Id == press.RelayId)?.BoardId ?? 0)))
                {
                    _unconfirmed = null;
                }

                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the update was on its way.
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Not shown to the person: the page keeps what it shows, and the next refresh tries again.
            Log.LogWarning(ex, "The page could not reload {What}", "the relays, groups and inputs");
        }
    }
}
