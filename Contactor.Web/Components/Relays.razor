    // The group's relays whose board turns them on by itself after a power cut (GroupPowerOn).
    private IReadOnlyList<GroupMemberView> NotSafe(GroupView group)
    {
        var board = Registry.Find(group.BoardId);
        var channels = GroupPowerOn.NotSafe(board?.Capabilities.PowerOn, board?.State.PowerOn, group.Members.Select(m => m.Channel));
