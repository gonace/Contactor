@implements IDisposable
@using Contactor.Boards
@using Contactor.Web.Features.Identity
@using Contactor.Web.Features.Boards
@inject CurrentUser CurrentUser
@inject BoardTrafficSetting Debugging
@inject BoardRegistry Registry
@inject TimeProvider TimeProvider

<div class="bottom @(SideMenuOnly ? "side-only" : null)">
    @if (_debugging)
    {
        @* Toasts with the board's traffic for whoever turned Debugging on; the keep-alive is left out. *@
        <div class="toasts" role="log" aria-live="polite" aria-label="Traffic to the relay board">
            @foreach (var toast in ToastsNow)
            {
                <p class="toast @(toast.Item.IsError ? "error" : null)" @key="toast">
                    <span class="text">
                        @Arrow(toast.Item)
                        @if (toast.Board is not null)
                        {
                            <span class="where">@toast.Board</span>
                        }
                        @toast.Item.Text
                    </span>
                    @if (toast.Item.Hex is not null)
                    {
                        <span class="hex">@toast.Item.Hex</span>
                    }
                </p>
            }
        </div>
    }

    <nav class="tabs @(SideList is null ? null : "has-list")" aria-label="Main menu">
        <a href="" aria-current="@(Current == Tab.Relays ? "page" : null)">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v9"></path><path d="M6.4 6.4a8 8 0 1 0 11.2 0"></path></svg>
            Relays
        </a>
        <a href="events" aria-current="@(Current == Tab.Events ? "page" : null)">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13"></path><path d="M8 12h13"></path><path d="M8 18h13"></path><path d="M3 6h.01"></path><path d="M3 12h.01"></path><path d="M3 18h.01"></path></svg>
            Events
        </a>
        <a href="settings" aria-current="@(Current == Tab.Settings ? "page" : null)">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            Settings
        </a>
        @if (_debugging || Current == Tab.Debug)
        {
            <a href="debug" aria-current="@(Current == Tab.Debug ? "page" : null)">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 17l6-6-6-6"></path><path d="M12 19h8"></path></svg>
                Debug
            </a>
        }
        @if (SideList is not null)
        {
            @* Only in the desktop's side menu, under the tabs; it scrolls on its own while the tabs and the version stay. *@
            <div class="side-list">@SideList</div>
        }
        @* Only in the desktop's side menu; on a phone and a tablet the version is at the bottom of Settings. *@
        @* The commit on a line of its own, so the narrow menu never cuts it off. *@
        <span class="version">@AppBuild.Current.Text.Replace(" · ", "\n", StringComparison.Ordinal)</span>
    </nav>
</div>

@code {
    /// <summary>Toasts shown at once; an older one goes when a new one comes.</summary>
    public const int MaxToasts = 3;

    /// <summary>How long a toast stays.</summary>
    public static readonly TimeSpan ToastTime = TimeSpan.FromSeconds(6);

    public enum Tab
    {
        Relays,
        Events,
        Settings,
        Debug,
    }

    private readonly List<Toast> _toasts = [];
    private readonly Lock _lock = new();

    // Every board's trace, and any board added while the page is open; with several boards a toast names its board.
    private BoardTraceWatch? _watch;
    private string? _email;
    private bool _debugging;
    private bool _disposed;

    [Parameter]
    public Tab Current { get; set; }

    /// <summary>
    /// Only the desktop's side menu, no bottom tab bar: for the pages under a tab (a relay, a group, a schedule, a new
    /// group), which on a phone have a back link instead.
    /// </summary>
    [Parameter]
    public bool SideMenuOnly { get; set; }

    /// <summary>What a page shows in the desktop's side menu under the tabs, e.g. the Relays screen's boards.</summary>
    [Parameter]
    public RenderFragment? SideList { get; set; }

    // A copy: the timers change the list off the render thread.
    private Toast[] ToastsNow
    {
        get
        {
            lock (_lock)
            {
                return [.. _toasts];
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _email = (await CurrentUser.GetAsync())?.Email;
        if (_email is null)
        {
            return;
        }

        Debugging.Changed += OnDebuggingChanged;
        _watch = new BoardTraceWatch(Registry, OnTraced);

        _debugging = await Debugging.IsOnAsync(_email, CancellationToken.None);
    }

    public void Dispose()
    {
        Debugging.Changed -= OnDebuggingChanged;
        _watch?.Dispose();

        lock (_lock)
        {
            _disposed = true;
            foreach (var toast in _toasts)
            {
                toast.Timer.Dispose();
            }

            _toasts.Clear();
        }
    }

    private static string Arrow(BoardTraceItem item)
    {
        return item.Direction switch
        {
            BoardTraceDirection.Sent => "→",
            BoardTraceDirection.Received => "←",
            _ => "·",
        };
    }

    // From another page, or this one: the person turned Debugging on or off.
    private void OnDebuggingChanged(object? sender, string email)
    {
        if (email == _email)
        {
            _ = ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            var on = await Debugging.IsOnAsync(_email!, CancellationToken.None);
            await InvokeAsync(() =>
            {
                _debugging = on;
                if (!on)
                {
                    RemoveAll();
                }

                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed meanwhile.
        }
    }

    // From a board's connection loop.
    private void OnTraced(LiveBoard board, BoardTraceItem item)
    {
        if (!_debugging || item.IsRoutine)
        {
            return;
        }

        lock (_lock)
        {
            if (_disposed)
            {
                return;
            }

            Toast? toast = null;
            var timer = TimeProvider.CreateTimer(_ => Remove(toast!), null, ToastTime, Timeout.InfiniteTimeSpan);
            toast = new Toast(item, Registry.All.Count > 1 ? board.Name : null, timer);
            _toasts.Add(toast);
            while (_toasts.Count > MaxToasts)
            {
                _toasts[0].Timer.Dispose();
                _toasts.RemoveAt(0);
            }
        }

        _ = RefreshAsync();
    }

    private void Remove(Toast toast)
    {
        lock (_lock)
        {
            if (!_toasts.Remove(toast))
            {
                return;
            }

            toast.Timer.Dispose();
        }

        _ = RefreshAsync();
    }

    private void RemoveAll()
    {
        lock (_lock)
        {
            foreach (var toast in _toasts)
            {
                toast.Timer.Dispose();
            }

            _toasts.Clear();
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the update was on its way.
        }
    }

    // Board: the board's name, with two or more boards. A class, not a record: the page tells toasts apart by reference
    // (@key), as two boards' items can have the same id.
    private sealed class Toast
    {
        public Toast(BoardTraceItem item, string? board, ITimer timer)
        {
            Item = item;
            Board = board;
            Timer = timer;
        }

        public BoardTraceItem Item { get; }

        public string? Board { get; }

        public ITimer Timer { get; }
    }
}
