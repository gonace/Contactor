@page "/board/new"
@implements IDisposable
@using Contactor.Boards
@using Contactor.Web.Features.BoardRules
@using Contactor.Web.Features.Boards
@using Contactor.Web.Features.Identity
@using Contactor.Web.Features.Languages
@using Contactor.Web.Features.Relays
@using Contactor.Web.Features.Setup
@using Contactor.Web.Persistence
@inject BoardRegistry Registry
@inject BoardAddressHandler Address
@inject BoardRemoval Removal
@inject OwnRulesHandler OwnRules
@inject OwnRulesService OwnRulesRows
@inject OwnRulesText OwnRulesWords
@inject SetupHandler Setup
@inject CurrentUser CurrentUser
@inject NavigationManager Navigation
@inject ILogger<BoardNew> Log
@inject AppLanguage Language

<PageTitle>@(Texts["Common.PageTitle", Texts["Common.Screen.AddBoard"]])</PageTitle>

<div class="screen">
    <header class="header" inert="@_sheetOpen">
        @if (_step == StepBoard)
        {
            @if (_boardId is null)
            {
                <a href="settings" class="back">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
                    @Texts["Common.Cancel"]
                </a>
            }
            else
            {
                <button type="button" class="back" disabled="@Busy" @onclick="CancelAsync">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
                    @Texts["Common.Cancel"]
                </button>
            }
        }
        else
        {
            var shown = _step;
            <button type="button" class="back" disabled="@Busy" @onclick="() => Back(shown)">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
                @Texts["Common.Back"]
            </button>
        }
        <span class="step-count">@Texts["Boards.New.Step", StepShown, StepCount]</span>
    </header>

    <div class="progress" aria-hidden="true" inert="@_sheetOpen">
        @for (var i = 1; i <= StepCount; i++)
        {
            <span class="@(i <= StepShown ? "done" : null)"></span>
        }
    </div>

    <main class="content">
        @if (_step == StepBoard)
        {
            <BoardModelPicker @ref="_picker" @bind-Type="_type" Busy="Busy" OpenChanged="OnListOpened">
                <div class="field">
                    <label for="board-name">@Texts["Boards.Name"]</label>
                    <input id="board-name" type="text" maxlength="@Board.NameMaxLength" autocomplete="off" placeholder="@DefaultName" @bind="_name" @bind:event="oninput" />
                    <p class="hint">@Texts["Boards.New.NameHint"]</p>
                </div>
            </BoardModelPicker>
        }
        else if (Chosen is not { Model: not null } board)
        {
            <p class="missing">@Texts["Boards.New.Gone"]</p>
        }
        else if (_step == StepWhere)
        {
            <BoardWhereStep @ref="_where" Board="board" Values="_whereFields" UserEmail="@_user?.Email" Busy="Busy"
                            BusyChanged="busy => _stepBusy = busy" ErrorChanged="error => _error = error" ChooseModel="() => Back(StepWhere)" />
        }
        else if (_step == StepRules)
        {
            <BoardOwnRulesStep @ref="_rulesStep" Board="board" UserEmail="@_user?.Email"
                               BusyChanged="busy => _stepBusy = busy" ErrorChanged="error => _error = error" />
        }
        else
        {
            <BoardRelaysStep @ref="_relaysStep" Board="board" Rows="_relays" UserEmail="@_user?.Email" />
        }
    </main>

    <div class="next" inert="@_sheetOpen">
        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }
        @{
            var step = _step;
            var gone = step > StepBoard && Chosen is null;
        }
        @if (step == StepRules && !gone)
        {
            var asked = OwnRules.ToAsk(_boardId!.Value);
            @if (Chosen!.Capabilities.OwnRulesOrCantTell.TurnsOff)
            {
                <button type="button" class="finish" disabled="@Busy" @onclick="TurnOffRulesAsync">@OwnRulesWords.TurnOffAll(asked.Count)</button>
            }
            <button type="button" class="secondary" disabled="@(Busy || !OwnRules.CanKeep(_boardId.Value, asked))" @onclick="KeepRulesAsync">@OwnRulesWords.KeepAll(asked.Count)</button>
        }
        else if (step < StepRelays)
        {
            <button type="button" disabled="@(Busy || gone || (step == StepBoard && BoardCatalogue.Find(_type) is null))" @onclick="() => GoOnAsync(step)">@Texts["Common.Next"]</button>
        }
        else
        {
            <button type="button" class="finish" disabled="@(Busy || gone)" @onclick="FinishAsync">@Texts["Boards.New.Done"]</button>
        }
        @if (step == StepWhere && !gone)
        {
            <button type="button" class="link" disabled="@Busy" @onclick="GoOnWithoutConnectionAsync">@Texts["Boards.New.WithoutConnection"]</button>
        }
        @if (step > StepBoard)
        {
            <button type="button" class="link" disabled="@Busy" @onclick="CancelAsync">@Texts["Common.Cancel"]</button>
        }
    </div>
</div>

<TabBar Current="TabBar.Tab.Settings" SideMenuOnly="true" />

@code {
    private const int StepBoard = 1;
    private const int StepWhere = 2;

    // "This board has timers of its own": only for a board that answers with rules of its own no person kept.
    private const int StepRules = 3;
    private const int StepRelays = 4;

    private int _step = StepBoard;

    // Whether "Name your relays" came after the rules step, so the count keeps it once its rules are gone.
    private bool _throughRules;

    // What the header and the progress bar last showed of the rules step, so a board's change redraws only when it
    // comes or goes.
    private bool _rulesInCount;
    private string _type = "";
    private string _name = "";
    private SignedInUser? _user;

    // Set when the page closes, on the page's own thread: a page closed while it loads doesn't subscribe, and an event
    // already on its way doesn't draw a closed page.
    private bool _disposed;

    private bool _sheetOpen;
    private bool _busy;
    private bool _stepBusy;
    private bool _moved;
    private string? _error;
    private BoardModelPicker? _picker;
    private BoardWhereStep? _where;
    private BoardRelaysStep? _relaysStep;
    private BoardOwnRulesStep? _rulesStep;
    private BoardWhereStep.Fields _whereFields = new();
    private List<BoardRelaysStep.Row> _relays = [];

    // The board these steps made, from "Next" on the first step; null before. Cancel removes it again. It stays
    // unfinished (hidden on Relays, removed at the next start) until "Done" or "Go on without a connection".
    private int? _boardId;

    private LiveBoard? Chosen => _boardId is { } id ? Registry.Find(id) : null;

    private bool Busy => _busy || _stepBusy;

    // The rules step counts while it may come (the board answers with rules to ask about), while it shows, and after it;
    // otherwise it is skipped and never counted.
    private bool RulesInCount => _step switch
    {
        StepRules => true,
        StepRelays => _throughRules,
        _ => BoardOwnRulesStep.ShouldAsk(Chosen, OwnRules),
    };

    private int StepCount => RulesInCount ? 4 : 3;

    // The step's number as shown: one less after a rules step that was skipped.
    private int StepShown => _step > StepRules && !RulesInCount ? _step - 1 : _step;

    // The name an empty field gives the board: the model's, made unique among the other boards.
    private string DefaultName => BoardCatalogue.Find(_type)?.Model is { } model
        ? BoardRegistry.UniqueName(model, [.. Registry.All.Where(b => b.BoardId != _boardId).Select(b => b.Name)])
        : Texts["Boards.New.NameExample"];

    protected override async Task OnInitializedAsync()
    {
        _user = await CurrentUser.GetAsync();

        // Dispose ran during the load: subscribing now would leave the handlers for the life of the app. Dispose and this
        // both run on the page's own thread, so nothing can come between the check and the subscription.
        if (_disposed)
        {
            return;
        }

        Registry.BoardsChanged += OnBoardsChanged;
        Registry.StateChanged += OnBoardChanged;
        Registry.OwnRulesChanged += OnBoardChanged;
        OwnRulesRows.Changed += OnRulesChanged;
    }

    public void Dispose()
    {
        _disposed = true;
        Registry.BoardsChanged -= OnBoardsChanged;
        Registry.StateChanged -= OnBoardChanged;
        Registry.OwnRulesChanged -= OnBoardChanged;
        OwnRulesRows.Changed -= OnRulesChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_moved)
        {
            _moved = false;
            await (_step switch
            {
                StepBoard when _picker is not null => _picker.FocusAsync(),
                StepWhere when _where is not null => _where.FocusAsync(),
                StepRules when _rulesStep is not null => _rulesStep.FocusAsync(),
                StepRelays when _relaysStep is not null => _relaysStep.FocusAsync(),
                _ => ValueTask.CompletedTask,
            });
        }
    }

    // A list of "Which relay board?" opened or closed: the rest is inert meanwhile, and an earlier message goes.
    private void OnListOpened(bool open)
    {
        _sheetOpen = open;
        if (open)
        {
            _error = null;
        }
    }

    private void Back(int fromStep)
    {
        if (!Busy && _step == fromStep && _step > StepBoard)
        {
            // Back past a rules step that has nothing to ask any more.
            _step = _step == StepRelays && !BoardOwnRulesStep.ShouldAsk(Chosen, OwnRules) ? StepWhere : _step - 1;
            _error = null;
            _moved = true;
        }
    }

    private async Task GoOnAsync(int fromStep)
    {
        if (Busy || _step != fromStep)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            if (_step == StepBoard)
            {
                await MakeBoardAsync();
            }
            else if (_step == StepWhere && _where is not null && await _where.GoOnAsync())
            {
                MoveFromWhere();
            }
        }
        catch (Exception ex)
        {
            Fail(ex, "A step of adding a relay board failed");
        }
        finally
        {
            _busy = false;
        }
    }

    // "Next" on the first step: the board is made now, so the next step can look for it. Back here, the same model
    // keeps it (a new name renames it); another model takes it out again and makes a new one.
    private async Task MakeBoardAsync()
    {
        if (_user is null)
        {
            return;
        }

        if (BoardCatalogue.Find(_type)?.Model is not { } model)
        {
            _error = Texts["Boards.New.ChooseBoard"];
            return;
        }

        var name = _name.Trim();
        if (name.Length > Board.NameMaxLength)
        {
            _error = Texts["Boards.Save.NameTooLong", Board.NameMaxLength];
            return;
        }

        if (Chosen is { } made && made.Model?.Id == model.Id)
        {
            // An empty name is the model's, made unique, as when it was made.
            var newName = name.Length > 0 ? name : DefaultName;
            if ((_error = await Address.RenameAsync(made.BoardId, newName, _user.Email, CancellationToken.None)) is not null)
            {
                return;
            }

            Move(StepWhere);
            return;
        }

        if (_boardId is { } earlier && !await TakeOutAsync(earlier))
        {
            return;
        }

        var board = await Registry.AddBoardAsync(model, name, CancellationToken.None);
        _boardId = board.BoardId;
        _whereFields = await BoardWhereStep.LoadAsync(Address, board, CancellationToken.None);
        _relays = await BoardRelaysStep.LoadAsync(Setup, board.BoardId, CancellationToken.None);
        Move(StepWhere);
    }

    private async Task GoOnWithoutConnectionAsync()
    {
        if (Busy || _step != StepWhere || _where is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            // Going on without a connection finishes adding it: the board is kept and shown on Relays from now on.
            if (await _where.GoOnWithoutConnectionAsync())
            {
                // Removed meanwhile: the next step has no board to name.
                if (_boardId is not { } id || !await Registry.FinishAddingAsync(id, CancellationToken.None))
                {
                    _error = Texts["Boards.New.Gone"];
                    return;
                }

                // Without a connection, the rules step is skipped: Relays warns once the board answers.
                _throughRules = false;
                Move(StepRelays);
            }
        }
        catch (Exception ex)
        {
            Fail(ex, "Saving the relay board's address failed");
        }
        finally
        {
            _busy = false;
        }
    }

    // "Done": the relays' names and "In use", then the relay list, where the new board is now. Relays shows every board
    // then (a page load, which clears its filter's cookie), so a filter can't hide the board just added.
    private async Task FinishAsync()
    {
        if (Busy || _step != StepRelays || _user is null || Chosen is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            _error = await BoardRelaysStep.SaveAsync(Setup, _relays, _user.Email, CancellationToken.None);
            if (_error is null && _boardId is { } id && !await Registry.FinishAddingAsync(id, CancellationToken.None))
            {
                _error = Texts["Boards.New.Gone"];
            }
        }
        catch (Exception ex)
        {
            Fail(ex, "Saving the new relay board's relays failed");
        }
        finally
        {
            _busy = false;
        }

        if (_error is null)
        {
            Navigation.NavigateTo(RelaysEndpoints.ShowAllPath.TrimStart('/'), forceLoad: true);
        }
    }

    // "Cancel": nothing is left behind. A board made here is removed again, as on its page in Settings (anything "Try"
    // left on is turned off first), then back to Settings.
    private async Task CancelAsync()
    {
        if (Busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        var gone = false;
        try
        {
            gone = _boardId is not { } id || await TakeOutAsync(id);
        }
        catch (Exception ex)
        {
            Fail(ex, "Cancelling a new relay board failed");
        }
        finally
        {
            _busy = false;
        }

        if (gone)
        {
            Navigation.NavigateTo("settings");
        }
    }

    // Removes the board made here; false, with the reason shown, when it couldn't be.
    private async Task<bool> TakeOutAsync(int boardId)
    {
        if (_user is null)
        {
            return false;
        }

        var error = await Removal.CancelAddingAsync(boardId, _user.Email, CancellationToken.None);
        if (error is not null && error != Removal.AlreadyRemoved)
        {
            _error = error;
            return false;
        }

        _boardId = null;
        return true;
    }

    // "Next" on "Where is the board?" once it answered: the rules step when it has rules to ask about, else the relays.
    private void MoveFromWhere()
    {
        _throughRules = false;
        Move(BoardOwnRulesStep.ShouldAsk(Chosen, OwnRules) ? StepRules : StepRelays);
    }

    // "Turn them off": on to the relays once the board's state shows them gone; otherwise the step says why and stays.
    private async Task TurnOffRulesAsync()
    {
        if (!Busy && _step == StepRules && _rulesStep is not null && await _rulesStep.TurnOffAsync())
        {
            LeaveRules();
        }
    }

    // "Keep them": on to the relays once kept.
    private async Task KeepRulesAsync()
    {
        if (!Busy && _step == StepRules && _rulesStep is not null && await _rulesStep.KeepAsync())
        {
            LeaveRules();
        }
    }

    private void LeaveRules()
    {
        if (_step == StepRules)
        {
            _throughRules = true;
            Move(StepRelays);
        }
    }

    private void Move(int step)
    {
        _step = step;
        _sheetOpen = false;
        _moved = true;
    }

    private void Fail(Exception ex, string what)
    {
        // An exception that leaves the handler would end the page's live connection.
        Log.LogError(ex, "{What}", what);
        _error = Texts["Common.SomethingWrongTryAgain"];
    }

    // From a board's read loop, or the own rules' loop.
    private void OnBoardChanged(object? sender, BoardStateChange change)
    {
        if (change.BoardId == _boardId)
        {
            _ = RulesChangedAsync();
        }
    }

    private void OnRulesChanged(object? sender, int boardId)
    {
        if (boardId == _boardId)
        {
            _ = RulesChangedAsync();
        }
    }

    // The rules step comes or goes from the count as the board's rules do; on the step, rules that went by themselves
    // (turned off at the board) leave nothing to ask, so the page goes on. Redrawn only for a change it shows.
    private async Task RulesChangedAsync()
    {
        using var language = Language.Use();
        try
        {
            await InvokeAsync(() =>
            {
                if (_disposed)
                {
                    return;
                }

                if (_step == StepRules && !Busy && _boardId is { } id && OwnRules.ToAsk(id).Count == 0)
                {
                    LeaveRules();
                    StateHasChanged();
                    return;
                }

                // On the rules step the buttons follow what can be kept.
                if (_step == StepRules || RulesInCount != _rulesInCount)
                {
                    StateHasChanged();
                }
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed meanwhile.
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        _rulesInCount = RulesInCount;
    }

    // A board added or removed elsewhere: the default name, or this board removed meanwhile.
    private void OnBoardsChanged(object? sender, EventArgs e)
    {
        _ = RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        using var language = Language.Use();
        try
        {
            await InvokeAsync(() =>
            {
                // On the page's own thread, as Dispose is: a closed page draws nothing.
                if (!_disposed)
                {
                    StateHasChanged();
                }
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed meanwhile.
        }
    }
}
