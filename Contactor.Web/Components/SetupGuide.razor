@page "/setup"
@implements IDisposable
@using System.Globalization
@using Contactor.Boards
@using Contactor.Web.Features.Access
@using Contactor.Web.Features.Boards
@using Contactor.Web.Features.Cloudflare
@using Contactor.Web.Features.Identity
@using Contactor.Web.Features.Relays
@using Contactor.Web.Features.Setup
@using Contactor.Web.Persistence
@inject SetupHandler Setup
@inject SetupSignInHandler SignIns
@inject BoardAddressHandler Address
@inject UsersHandler Users
@inject IRelayBoard Board
@inject IBoardConnection Connection
@inject BoardSwitch Boards
@inject CurrentUser CurrentUser
@inject TimeProvider Time
@inject LocalClock Clock
@inject NavigationManager Navigation
@inject ILogger<SetupGuide> Log

<PageTitle>Setup · Contactor</PageTitle>

<div class="screen">
    @* While a list of "Which relay board?" is open, everything but the list and its field takes no focus or clicks. *@
    <header class="header" inert="@(_sheet != Sheet.None)">
        @if (CanGoBack)
        {
            var shown = _step;
            <button type="button" class="back" disabled="@_busy" @onclick="() => Back(shown)">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
                Back
            </button>
        }
        else
        {
            <span></span>
        }
        <span class="step-count">STEP @StepInPart OF @StepsInPart</span>
    </header>

    <div class="part" inert="@(_sheet != Sheet.None)">@(InPart1 ? "PART 1 OF 2 · THE APP" : "PART 2 OF 2 · THE BOARD")</div>
    <div class="progress" aria-hidden="true" inert="@(_sheet != Sheet.None)">
        @for (var i = 1; i <= StepsInPart; i++)
        {
            <span class="@(i <= StepInPart ? "done" : null)"></span>
        }
    </div>

    <main class="content">
        @if (_step == StepWayIn)
        {
            @WayInStep
        }
        else if (_step == StepSignIn)
        {
            @SignInStep
        }
        else if (_step == StepAbout)
        {
            <div class="intro">
                <h1 tabindex="-1" @ref="_heading">About you</h1>
                <p>Your name in Contactor. Then four short questions about your relay board. You can change all of it later under Settings.</p>
            </div>
            <div class="field">
                <label for="name">Your name</label>
                <input id="name" type="text" maxlength="@User.DisplayNameMaxLength" autocomplete="given-name" @bind="_name" @bind:event="oninput" />
                <p class="hint">Shown in the app and under Events, e.g. "@(string.IsNullOrWhiteSpace(_name) ? "Jane" : _name.Trim()) turned on Compressor".</p>
            </div>
            <div class="info">
                <span class="label">YOU'LL NEED</span>
                <p>The relay board switched on and plugged into the same network as this app. Your router lists its address among its connected devices.</p>
            </div>
        }
        else if (_step == StepBoard)
        {
            var chosen = BoardCatalogue.Find(_type)?.Model;
            <div class="intro" inert="@(_sheet != Sheet.None)">
                <h1 tabindex="-1" @ref="_heading">Which relay board?</h1>
                <p>Choose the brand first, then the model. Both are printed on the board.</p>
            </div>
            <div class="field" inert="@(_sheet == Sheet.Model)" @onkeydown="OnSheetKey">
                <span class="field-label" id="brand-label">Brand</span>
                <button type="button" class="select @(_sheet == Sheet.Brand ? "open" : null)" aria-haspopup="dialog" aria-expanded="@(_sheet == Sheet.Brand ? "true" : "false")"
                        aria-labelledby="brand-label brand-value" @ref="_brandField" @onclick="() => Open(Sheet.Brand)">
                    <span class="select-text" id="brand-value">
                        @if (_brand is null)
                        {
                            <span class="placeholder">Choose the brand</span>
                        }
                        else
                        {
                            <span>@_brand</span>
                        }
                    </span>
                    <svg class="chevron" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                </button>
                @if (_sheet == Sheet.Brand)
                {
                    @List
                }
            </div>
            <div class="field" inert="@(_sheet == Sheet.Brand)" @onkeydown="OnSheetKey">
                <span class="field-label" id="model-label">Model</span>
                <button type="button" class="select @(_sheet == Sheet.Model ? "open" : null)" aria-haspopup="dialog" aria-expanded="@(_sheet == Sheet.Model ? "true" : "false")"
                        aria-labelledby="model-label model-value" disabled="@(_brand is null)" @ref="_modelField" @onclick="() => Open(Sheet.Model)">
                    <span class="select-text" id="model-value">
                        @if (chosen is not null)
                        {
                            <span>@chosen.ModelName</span>
                            <span class="note">@SetupText.Capabilities(chosen.Capabilities)</span>
                        }
                        else
                        {
                            <span class="placeholder">@(_brand is null ? "Choose the brand first" : "Choose the model")</span>
                        }
                    </span>
                    <svg class="chevron" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                </button>
                @if (_sheet == Sheet.Model)
                {
                    @List
                }
            </div>
            <p class="hint" inert="@(_sheet != Sheet.None)">Not on the list? Contactor only lists the boards it can switch.</p>
        }
        else if (_step == StepWhere)
        {
            <div class="intro">
                <h1 tabindex="-1" @ref="_heading">Where is the board?</h1>
                <p>@Model.Name · its address on your network.</p>
            </div>
            <div class="fields">
                <div class="field">
                    <label for="host">Address</label>
                    <input id="host" type="text" inputmode="decimal" autocomplete="off" autocapitalize="off" spellcheck="false"
                           maxlength="@BoardSetting.HostMaxLength" placeholder="192.168.1.50" @bind="_host" @bind:event="oninput" />
                </div>
                <div class="field port">
                    <label for="port">Port</label>
                    <input id="port" type="text" inputmode="numeric" autocomplete="off" maxlength="5" placeholder="@Model.DefaultPort" @bind="_port" @bind:event="oninput" />
                </div>
            </div>
            <p class="hint">Your router lists the board among its connected devices. Leave the port empty unless you changed it on the board.</p>

            @if (Model.HasLogin)
            {
                <label for="no-login" class="check">
                    <input id="no-login" type="checkbox" @bind="_noLogin" />
                    <span>@(Model.PasswordOnly ? "The board has no password" : "The board has no login")</span>
                </label>
                @if (!_noLogin)
                {
                    <div class="fields">
                        @if (!Model.PasswordOnly)
                        {
                            <div class="field">
                                <label for="username">User name</label>
                                <input id="username" type="text" autocomplete="off" autocapitalize="off" spellcheck="false"
                                       maxlength="@Model.LoginMaxLength" @bind="_username" @bind:event="oninput" />
                            </div>
                        }
                        <div class="field">
                            <label for="password">Password</label>
                            <input id="password" type="password" autocomplete="new-password"
                                   maxlength="@Model.LoginMaxLength" placeholder="@(_hasPassword ? "unchanged" : "none")"
                                   @bind="_newPassword" @bind:event="oninput" />
                        </div>
                    </div>
                    <p class="hint">@(Model.PasswordOnly ? Model.LoginHint : $"The same as on the board's own web page. {Model.LoginHint ?? $"At most {Model.LoginMaxLength} characters."}")</p>
                }
            }

            @if (_checking)
            {
                <div class="board-status" role="status">
                    <span class="dot waiting" aria-hidden="true"></span>
                    <span class="status-text"><strong>Looking for the board</strong><span>at @Connection.Endpoint</span></span>
                </div>
            }
            else if (_notFound)
            {
                <div class="not-found" role="alert">
                    <span>No answer from @Connection.Endpoint. Check that the board has power and a network cable, and that the address is right.</span>
                    <button type="button" class="small" disabled="@_busy" @onclick="() => CheckAsync(goOn: false)">Check again</button>
                </div>
            }
            else if (Board.State.IsConnected && Connection.Endpoint.HasHost)
            {
                <div class="board-status" role="status">
                    <span class="dot" aria-hidden="true"></span>
                    <span class="status-text">
                        <strong>Board online</strong>
                        <span>Found @Board.Capabilities.RelayCount @(Board.Capabilities.RelayCount == 1 ? "relay" : "relays") at @Connection.Endpoint@(_checkedAt is { } at ? $" · checked {at.ToString("HH:mm:ss", CultureInfo.InvariantCulture)}" : "")</span>
                    </span>
                    <button type="button" class="small" disabled="@_busy" @onclick="() => CheckAsync(goOn: false)">Check again</button>
                </div>
            }
        }
        else if (_step == StepRelays)
        {
            <div class="intro">
                <h1 tabindex="-1" @ref="_heading">Name your relays</h1>
                <p>Name each relay after what it switches. "Try" turns it on for @((int)SetupHandler.TryLength.TotalSeconds) seconds, so you can hear which one it is. Untick the ones you don't use.</p>
            </div>
            @if (!Board.State.IsConnected)
            {
                <p class="hint">"Try" works once the app has contact with the relay board.</p>
            }
            <ul class="relays">
                @foreach (var relay in _relays)
                {
                    var on = Board.State.IsOn(relay.Id);
                    <li class="relay" @key="relay.Id">
                        <label class="label" for="@($"relay-{relay.Id}")">RELAY @relay.Id</label>
                        <div class="row">
                            <input id="@($"relay-{relay.Id}")" type="text" maxlength="@Relay.NameMaxLength" autocomplete="off"
                                   placeholder="@Relay.DefaultName(relay.Id)" @bind="relay.Name" @bind:event="oninput" />
                            <button type="button" class="small try" aria-pressed="@(on ? "true" : "false")"
                                    aria-label="@($"Try relay {relay.Id}")"
                                    disabled="@(on || relay.Trying || relay.GroupName is not null || !Board.State.IsConnected)"
                                    @onclick="() => TryAsync(relay)">@(on ? "On" : "Try")</button>
                        </div>
                        <label class="check" for="@($"use-{relay.Id}")">
                            <input id="@($"use-{relay.Id}")" type="checkbox" @bind="relay.IsActive" />
                            <span>In use</span>
                        </label>
                        @if (relay.GroupName is not null)
                        {
                            <p class="hint">In the group @relay.GroupName, which switches it.</p>
                        }
                        @if (relay.Error is not null)
                        {
                            <p class="error" role="alert">@relay.Error</p>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            var inUse = _relays.Count(r => r.IsActive);
            var first = _relays.FirstOrDefault(r => r.IsActive);
            <div class="intro">
                <span class="done-mark" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"></path></svg>
                </span>
                <h1 tabindex="-1" @ref="_heading">All set@(string.IsNullOrWhiteSpace(_name) ? "" : $", {_name.Trim()}")</h1>
                <p>@(Board.State.IsConnected ? "Your relay board is ready." : "The app keeps looking for your relay board. You can change its address under Settings.")</p>
            </div>
            <dl class="summary">
                <div>
                    <dt class="label">BOARD</dt>
                    <dd>@(Connection.Endpoint.HasHost ? $"{Model.Name} at {Connection.Endpoint.Host}" : $"{Model.Name}, no address yet")</dd>
                </div>
                <div>
                    <dt class="label">RELAYS</dt>
                    <dd>@SetupText.RelaysInUse(inUse, _relays.Count - inUse)</dd>
                </div>
            </dl>
            <h2>Good next steps</h2>
            <div class="links">
                <a href="group/new">Make a group, e.g. a fan heater <span aria-hidden="true">→</span></a>
                @if (first is not null)
                {
                    <a href="@($"relay/{first.Id}")">Add a schedule, e.g. to @first.Shown <span aria-hidden="true">→</span></a>
                }
            </div>
        }
    </main>

    <div class="next" inert="@(_sheet != Sheet.None)">
        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }
        @if (_elsewhere is not null)
        {
            <a href="@_elsewhere" class="finish">Open @(new Uri(_elsewhere).Host)</a>
        }
        else if (_step < StepDone)
        {
            var shown = _step;
            <button type="button" disabled="@(_busy || (_step == StepBoard && BoardCatalogue.Find(_type) is null))" @onclick="() => GoOnAsync(shown)">Next</button>
            @if (_step == StepWhere)
            {
                <button type="button" class="link" disabled="@_busy" @onclick="GoOnWithoutConnectionAsync">Go on without a connection</button>
            }
        }
        else
        {
            <a href="" class="finish">Go to Relays</a>
        }
    </div>

</div>

@code {
    // The steps in order. Part 1 sets up the app; its first step, the setup code, is a page of its own
    // (SetupCodePage), so the guide's Part 1 starts at its step 2. Part 2 is the board.
    private const int StepWayIn = 1;
    private const int StepSignIn = 2;
    private const int StepAbout = 3;
    private const int StepBoard = 4;
    private const int StepWhere = 5;
    private const int StepRelays = 6;
    private const int StepDone = 7;
    private const int StepsInPart = 4;

    private bool InPart1 => _step <= StepAbout;

    private int StepInPart => InPart1 ? _step + 1 : _step - StepAbout;

    // Not back past the way in (the code is typed), nor from "About you" to the sign-in: that is saved, and this page
    // may be at the new address.
    private bool CanGoBack => _elsewhere is null
        && (_step == StepSignIn || _step > StepBoard || (_step == StepBoard && SignIns.SignIn?.Id != SignInCatalogue.NoneId));

    // Step 2's open list: under its field on a tablet or desktop, from the bottom of the screen on a phone.
    private RenderFragment List => __builder =>
    {
        <div class="sheet-backdrop" @onclick="Close"></div>
        <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-title">
            <span class="grab" aria-hidden="true"></span>
            <h2 id="sheet-title" tabindex="-1" @ref="_sheetTitle">@(_sheet == Sheet.Brand ? "Brand" : $"{_brand} model")</h2>
            <div class="sheet-options">
                @if (_sheet == Sheet.Brand)
                {
                    @foreach (var brand in BoardCatalogue.Brands)
                    {
                        var name = brand.Name;
                        <button type="button" class="sheet-option @(name == _brand ? "chosen" : null)" aria-current="@(name == _brand ? "true" : null)" @onclick="() => ChooseBrand(name)">
                            <span class="option-text">
                                <span class="name">@name</span>
                                <span class="note">@(brand.Models.Count == 1 ? "1 model" : $"{brand.Models.Count} models")</span>
                            </span>
                            @if (name == _brand)
                            {
                                <svg class="tick" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>
                            }
                        </button>
                    }
                }
                else
                {
                    @foreach (var model in BoardCatalogue.Brands.FirstOrDefault(m => m.Name == _brand)?.Models ?? [])
                    {
                        var id = model.Id;
                        <button type="button" class="sheet-option @(id == _type ? "chosen" : null)" aria-current="@(id == _type ? "true" : null)" @onclick="() => ChooseModel(id)">
                            <span class="option-text">
                                <span class="name">@model.ModelName</span>
                                <span class="note">@SetupText.Capabilities(model.Capabilities)</span>
                            </span>
                            @if (id == _type)
                            {
                                <svg class="tick" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>
                            }
                        </button>
                    }
                }
            </div>
        </div>
    };

    // "How do people reach the app?": every way in; Cloudflare also asks for its tunnel's token and address.
    private RenderFragment WayInStep => __builder =>
    {
        <div class="intro">
            <h1 tabindex="-1" @ref="_heading">How do people reach the app?</h1>
            <p>Where should people be able to open Contactor?</p>
        </div>
        <div class="choices" role="radiogroup" aria-label="Ways in">
            @foreach (var way in AccessCatalogue.All)
            {
                var id = way.Id;
                <label class="choice @(id == _wayIn ? "chosen" : null)">
                    <input type="radio" name="way-in" checked="@(id == _wayIn)" @onchange="() => _wayIn = id" />
                    <span class="choice-text">
                        <span class="name">@way.Name @if (way.Simplest)
                            {
                                <span class="tag">SIMPLEST</span>
                            }</span>
                        <span class="note">@way.Description</span>
                    </span>
                </label>
            }
        </div>
        @if (_wayIn == CloudflareMethods.TunnelId)
        {
            <div class="field">
                <label for="tunnel-token">Tunnel token</label>
                <input id="tunnel-token" type="password" autocomplete="new-password" spellcheck="false" maxlength="@CloudflareSetting.TunnelTokenMaxLength"
                       placeholder="@(SignIns.WayIn?.Id == CloudflareMethods.TunnelId ? "unchanged" : "")" @bind="_tunnelToken" @bind:event="oninput" />
                <p class="hint">Zero Trust → Networks → Tunnels → your tunnel. It is the long code after <code>--token</code> in the install command.</p>
            </div>
            <div class="field">
                <label for="tunnel-address">Address</label>
                <input id="tunnel-address" type="text" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false"
                       maxlength="@CloudflareSetting.HostNameMaxLength" placeholder="relays.example.com" @bind="_tunnelAddress" @bind:event="oninput" />
                <p class="hint">The tunnel's public hostname: where people will open Contactor. In Cloudflare, point it at <code>http://contactor:8080</code>.</p>
            </div>
        }
    };

    // "How do people sign in?": every sign-in, what fits the way in can be chosen, the rest is greyed out.
    private RenderFragment SignInStep => __builder =>
    {
        var cloudflare = SignIns.WayIn?.Id == CloudflareMethods.TunnelId;
        var (address, connected) = SignIns.Tunnel;
        var options = SignIns.SignIns();
        var recommended = options.FirstOrDefault(o => o.Recommended);
        <div class="intro">
            <h1 tabindex="-1" @ref="_heading">@(_elsewhere is null ? "How do people sign in?" : "Go on at your new address")</h1>
            <p>@(_elsewhere is not null
                ? $"Contactor now only answers through Cloudflare. Open it there and sign in with your e-mail{(_setupDone ? "." : ": the guide goes on.")}"
                : recommended is not null ? $"Recommended with {SignIns.WayIn?.Name}: {recommended.Method.Name}." : "With a sign-in, the events show who did what.")</p>
        </div>
        @if (_elsewhere is null)
        {
            <div class="choices" role="radiogroup" aria-label="Sign-ins">
                @foreach (var option in options)
                {
                    var id = option.Method.Id;
                    <label class="choice @(id == _signInId ? "chosen" : null) @(option.Allowed ? null : "off")">
                        <input type="radio" name="sign-in" checked="@(id == _signInId)" disabled="@(!option.Allowed)" @onchange="() => _signInId = id" />
                        <span class="choice-text">
                            <span class="name">@option.Method.Name @if (option.Recommended)
                                {
                                    <span class="tag">RECOMMENDED</span>
                                }
                                else if (option.Method.NotRecommended && option.Allowed)
                                {
                                    <span class="tag warn">NOT RECOMMENDED</span>
                                }</span>
                            <span class="note">@(option.Reason ?? option.Method.Description)</span>
                        </span>
                    </label>
                }
            </div>
            @if (_signInId == CloudflareMethods.AccessId)
            {
                <div class="field">
                    <label for="team-domain">Team domain</label>
                    <input id="team-domain" type="text" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false"
                           maxlength="@CloudflareSetting.HostNameMaxLength" placeholder="myteam.cloudflareaccess.com" @bind="_teamDomain" @bind:event="oninput" />
                    <p class="hint">Zero Trust → Settings → Team name and domain.</p>
                </div>
                <div class="field">
                    <label for="audience">AUD tag</label>
                    <input id="audience" type="text" autocomplete="off" autocapitalize="off" spellcheck="false"
                           maxlength="@CloudflareSetting.AudienceMaxLength" @bind="_audience" @bind:event="oninput" />
                    <p class="hint">Zero Trust → Access controls → Applications → the application for @(address ?? "your address") → Edit → Additional settings.</p>
                </div>
            }
            else if (_signInId == SignInCatalogue.NoneId)
            {
                <p class="warning" role="note">Anyone on your network can switch the relays, and the events can't say who did it. Choose a sign-in to reach the app from outside.</p>
            }
        }
        @if (cloudflare)
        {
            <div class="board-status" role="status">
                <span class="dot @(connected ? null : "waiting")"></span>
                <span class="status-text">
                    <b>@(connected ? "Tunnel connected" : "Waiting for the tunnel to connect")</b>
                    <span>@(connected && address is not null ? $"Cloudflare answers at {address}." : "It can take a minute. Check the token if it doesn't.")</span>
                </span>
            </div>
        }
    };

    private readonly List<RelayRow> _relays = [];
    private ElementReference _heading;
    private SignedInUser? _user;
    private int _step = StepAbout;

    // Part 1's choices and fields.
    private string _wayIn = "";
    private string _signInId = "";
    private string _tunnelToken = "";
    private string _tunnelAddress = "";
    private string _teamDomain = "";
    private string _audience = "";

    // Once the sign-in is chosen, this page no longer answers here: the address to go on at.
    private string? _elsewhere;

    // An installation in use whose sign-in was reset: the new address opens on the relays, not the guide.
    private bool _setupDone;
    private string _name = "";
    private string _type = "";
    private string? _brand;
    private Sheet _sheet;
    private ElementReference _brandField;
    private ElementReference _modelField;
    private ElementReference _sheetTitle;

    // Where the focus goes after the render: into a list just opened, or back to its field once it closes. The
    // references are read after the render, when the list is there.
    private Sheet? _focusNext;
    private string _host = "";
    private string _port = "";
    private bool _noLogin;
    private string _username = "";
    private string _newPassword = "";
    private bool _hasPassword;
    private bool _checking;
    private bool _notFound;
    private bool _busy;
    private bool _moved;
    private string? _error;

    // Whether the last save changed the address or login, so a connection still open is to the old ones.
    private bool _moving;

    // When the last check found the board, for "checked 14:02:05".
    private DateTime? _checkedAt;

    // The steps after "Which relay board?" only come once a board is chosen there.
    private BoardModel Model => Boards.Model!;

    protected override async Task OnInitializedAsync()
    {
        // An installation whose sign-in was reset is done, and still opens on the sign-in.
        var part1 = SignIns.Step;
        _user = await CurrentUser.GetAsync();
        var setupDone = await Setup.IsDoneAsync(CancellationToken.None);
        if (ShouldLeave(_user is not null, part1 == SetupPart1Step.Done, setupDone))
        {
            Navigation.NavigateTo("", replace: true);
            return;
        }

        // A setup connection that outlived setup mode (its sign-in is chosen, nobody is signed in here): only the way
        // on. Sending it to the relays would bring it straight back here.
        if (part1 == SetupPart1Step.Done && _user is null)
        {
            _setupDone = setupDone;
            _elsewhere = NewAddress();
            _step = StepSignIn;
            return;
        }

        _step = part1 switch
        {
            SetupPart1Step.WayIn => StepWayIn,
            SetupPart1Step.SignIn => StepSignIn,

            // With No sign-in everyone is the same person: nothing to say about you.
            _ when SignIns.SignIn?.Id == SignInCatalogue.NoneId => StepBoard,
            _ => StepAbout,
        };
        _wayIn = SignIns.WayIn?.Id ?? AccessCatalogue.All.First(w => w.Simplest).Id;
        _signInId = DefaultSignIn();
        _tunnelAddress = SignIns.Tunnel.Address ?? "";
        _teamDomain = SignIns.Access.TeamDomain;
        _audience = SignIns.Access.Audience;
        SignIns.TunnelChanged += OnTunnelChanged;

        _name = _user?.DisplayName ?? "";
        _type = Boards.Model?.Id ?? "";
        _brand = Boards.Model?.Brand;
        if (Boards.Model is not null)
        {
            await LoadBoardAsync();
        }

        Board.StateChanged += OnBoardChanged;
    }

    // The chosen board's address, login and relays, for steps 3 to 5.
    private async Task LoadBoardAsync()
    {
        var endpoint = await Address.GetAsync(CancellationToken.None);
        _host = endpoint.Host;
        _port = endpoint.Port == Model.DefaultPort ? "" : endpoint.Port.ToString(CultureInfo.InvariantCulture);
        var login = await Address.GetLoginAsync(CancellationToken.None);
        _username = login.Username;
        _hasPassword = login.HasPassword;
        _noLogin = login.Username.Length == 0 && !login.HasPassword;

        var relays = await Setup.RelaysAsync(CancellationToken.None);
        _relays.Clear();
        _relays.AddRange(relays.Select(r => new RelayRow(r)));
    }

    public void Dispose()
    {
        Board.StateChanged -= OnBoardChanged;
        SignIns.TunnelChanged -= OnTunnelChanged;
    }

    // From the tunnel's own thread: "Tunnel connected" on the sign-in step.
    private void OnTunnelChanged(object? sender, EventArgs e)
    {
        _ = RefreshTunnelAsync();
    }

    private async Task RefreshTunnelAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The page closed meanwhile.
        }
    }

    /// <summary>
    /// Whether the guide sends the person to the relays: only someone signed in, once Part 1 and the guide are done.
    /// Anyone else stays, or the gate would send them straight back.
    /// </summary>
    public static bool ShouldLeave(bool signedIn, bool part1Done, bool setupDone) => signedIn && part1Done && setupDone;

    // Where the guide goes on once the sign-in is chosen: the tunnel's address (the guide, or the relays once it is
    // done). Without an address, which the guide never leaves this way, the app's own.
    private string NewAddress()
    {
        return SignIns.Tunnel.Address is { Length: > 0 } address
            ? $"https://{address}/{(_setupDone ? "" : "setup")}"
            : Navigation.BaseUri;
    }

    // The sign-in chosen to begin with: the one recommended for the way in, else the first that fits it.
    private string DefaultSignIn()
    {
        var options = SignIns.SignIns();
        return (options.FirstOrDefault(o => o.Recommended) ?? options.FirstOrDefault(o => o.Allowed))?.Method.Id ?? "";
    }

    // A new step's heading takes the focus, so a screen reader reads where it is.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_moved)
        {
            _moved = false;
            await _heading.FocusAsync();
        }
        else if (_focusNext is { } focus)
        {
            _focusNext = null;
            await (focus switch
            {
                Sheet.Brand => _brandField,
                Sheet.Model => _modelField,
                _ => _sheetTitle,
            }).FocusAsync();
        }
    }

    private void Back(int fromStep)
    {
        if (!_busy && _step == fromStep && CanGoBack)
        {
            _step--;
            _sheet = Sheet.None;
            _error = null;
            _notFound = false;
            _moved = true;
        }
    }

    private async Task GoOnAsync(int fromStep)
    {
        if (_busy || _step != fromStep)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            switch (_step)
            {
                case StepWayIn:
                    await ChooseWayInAsync();
                    break;
                case StepSignIn:
                    await ChooseSignInAsync();
                    break;
                case StepAbout:
                    await SaveNameAsync();
                    break;
                case StepBoard:
                    await ChooseBoardAsync();
                    break;
                case StepWhere:
                    _busy = false;
                    await CheckAsync(goOn: true);
                    break;
                case StepRelays:
                    await SaveRelaysAsync();
                    break;
            }
        }
        catch (Exception ex)
        {
            Fail(ex, "A step of the setup guide failed");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChooseWayInAsync()
    {
        _error = await SignIns.ChooseWayInAsync(_wayIn, _tunnelToken, _tunnelAddress, CancellationToken.None);
        if (_error is null)
        {
            _tunnelToken = "";
            _signInId = DefaultSignIn();
            Move(StepSignIn);
        }
    }

    private async Task ChooseSignInAsync()
    {
        _error = await SignIns.ChooseSignInAsync(_signInId, _teamDomain, _audience, CancellationToken.None);
        if (_error is not null)
        {
            return;
        }

        // No sign-in: this page is let in from now on, as everyone; loaded again, it goes on with the board.
        if (_signInId == SignInCatalogue.NoneId)
        {
            Navigation.NavigateTo("setup", forceLoad: true);
            return;
        }

        // Nobody is signed in in this page: from now on only the new address
        // answers. The handler took the sign-in only with an address saved.
        _setupDone = await Setup.IsDoneAsync(CancellationToken.None);
        _elsewhere = NewAddress();
        _moved = true;
    }

    private async Task SaveNameAsync()
    {
        if (_user is not null)
        {
            _error = await Users.RenameAsync(_user.Email, _name, CancellationToken.None);
            if (_error is not null)
            {
                return;
            }

            _name = _name.Trim();
        }

        Move(StepBoard);
    }

    private async Task ChooseBoardAsync()
    {
        // Someone else finished the guide while this page was open: the model is never changed afterwards.
        if (await Setup.IsDoneAsync(CancellationToken.None))
        {
            Navigation.NavigateTo("");
            return;
        }

        if (BoardCatalogue.Find(_type) is not { } chosen)
        {
            _error = "Choose your relay board.";
            return;
        }

        // The app switches to the board while it runs, and the guide goes straight on.
        var before = Boards.Model;
        await Setup.ChooseBoardAsync(_type, CancellationToken.None);
        if (before?.Id != chosen.Model.Id)
        {
            await LoadBoardAsync();

            // An address saved for the board chosen before kept that board's own port: offer the new one's instead.
            if (before is not null && _port == before.DefaultPort.ToString(CultureInfo.InvariantCulture))
            {
                _port = "";
            }
        }

        Move(StepWhere);
    }

    // Saves the address and login, then waits for the board. Going on only once it answers; "Go on without a
    // connection" is there for a board that doesn't yet.
    private async Task CheckAsync(bool goOn)
    {
        if (_busy || _user is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        _notFound = false;
        try
        {
            // Watching from before the save: the board may be back at its new address before the save returns.
            using var contact = BoardContact.Watch(Board);
            if (!await SaveAddressAsync())
            {
                return;
            }

            _checking = true;
            StateHasChanged();
            // "Check again" with nothing changed asks the board itself, so the check is a real one.
            var found = !goOn && !_moving && Board.State.IsConnected
                ? await BoardContact.AskAsync(Board, BoardContact.Timeout, Time, CancellationToken.None)
                : await contact.WaitAsync(_moving, BoardContact.Timeout, Time, CancellationToken.None);
            _checkedAt = found ? Clock.Now : null;
            _checking = false;
            _notFound = !found;
            if (found && goOn)
            {
                Move(StepRelays);
            }
        }
        catch (Exception ex)
        {
            Fail(ex, "Checking the relay board failed");
        }
        finally
        {
            _checking = false;
            _busy = false;
        }
    }

    private async Task<bool> SaveAddressAsync()
    {
        if (_user is null)
        {
            return false;
        }

        var port = Model.DefaultPort;
        if (_port.Trim().Length > 0 && !int.TryParse(_port.Trim(), NumberStyles.None, CultureInfo.InvariantCulture, out port))
        {
            _error = "The port is a number from 1 to 65535.";
            return false;
        }

        var (endpoint, login) = (Connection.Endpoint, Connection.Login);
        _error = await Address.SaveAsync(_host, port, _user.Email, CancellationToken.None)
            ?? (Model.HasLogin ? await Address.SaveLoginAsync(_username, _newPassword, _noLogin, _user.Email, CancellationToken.None) : null);
        if (_error is not null)
        {
            return false;
        }

        _moving = BoardContact.HasMoved(Connection, endpoint, login);
        _hasPassword = (await Address.GetLoginAsync(CancellationToken.None)).HasPassword;
        _newPassword = "";
        return true;
    }

    private async Task GoOnWithoutConnectionAsync()
    {
        if (_busy || _step != StepWhere)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            // An address typed in is still saved, so the app keeps looking for the board there.
            if (_host.Trim().Length == 0 || await SaveAddressAsync())
            {
                Move(StepRelays);
            }
        }
        catch (Exception ex)
        {
            Fail(ex, "Saving the relay board's address failed");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TryAsync(RelayRow relay)
    {
        if (_user is null || relay.Trying)
        {
            return;
        }

        relay.Trying = true;
        relay.Error = null;
        try
        {
            await Setup.TryAsync(relay.Id, _user.Email, CancellationToken.None);
        }
        catch (BoardNotConnectedException)
        {
            relay.Error = "No contact with the relay board. Try again in a moment.";
        }
        catch (RelayInGroupException)
        {
            relay.Error = RelayInGroupException.Text;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "\"Try\" failed for relay {RelayId}", relay.Id);
            relay.Error = "Something went wrong. Try again.";
        }
        finally
        {
            relay.Trying = false;
        }
    }

    private async Task SaveRelaysAsync()
    {
        if (_user is null)
        {
            return;
        }

        _error = await Setup.SaveRelaysAsync(_relays.Select(r => new SetupRelayChoice(r.Id, r.Name, r.IsActive)), _user.Email, CancellationToken.None);
        if (_error is null)
        {
            await Setup.MarkDoneAsync(CancellationToken.None);
            Move(StepDone);
        }
    }

    // Step 2's lists: a brand, then that brand's models.
    private void Open(Sheet sheet)
    {
        if (_busy || _step != StepBoard || (sheet == Sheet.Model && _brand is null))
        {
            return;
        }

        if (_sheet == sheet)
        {
            Close();
            return;
        }

        _sheet = sheet;
        _error = null;
        _focusNext = Sheet.None;
    }

    // A new brand clears the model and opens its models at once: the next thing to choose.
    private void ChooseBrand(string brand)
    {
        if (_busy || _sheet != Sheet.Brand)
        {
            return;
        }

        if (brand == _brand)
        {
            Close();
            return;
        }

        _brand = brand;
        _type = "";
        _sheet = Sheet.Model;
        _focusNext = Sheet.None;
    }

    private void ChooseModel(string id)
    {
        if (_busy || _sheet != Sheet.Model)
        {
            return;
        }

        _type = id;
        Close();
    }

    private void Close()
    {
        // The field the list belongs to; a closed list's field would be gone with the step.
        _focusNext = _sheet == Sheet.None ? null : _sheet;
        _sheet = Sheet.None;
    }

    private void OnSheetKey(KeyboardEventArgs e)
    {
        // On the field, so Escape also closes the list from the field's own button.
        if (e.Key == "Escape" && _sheet != Sheet.None)
        {
            Close();
        }
    }

    private void Move(int step)
    {
        _step = step;
        _sheet = Sheet.None;
        _notFound = false;
        _moved = true;
    }

    private void Fail(Exception ex, string what)
    {
        // An exception that leaves the handler would end the page's live connection.
        Log.LogError(ex, "{What}", what);
        _error = "Something went wrong. Try again.";
    }

    // From the board's read loop.
    private void OnBoardChanged(object? sender, BoardState state)
    {
        _ = RefreshAsync(state);
    }

    private async Task RefreshAsync(BoardState state)
    {
        try
        {
            await InvokeAsync(() =>
            {
                // The board answered after all: "No answer" would be wrong now.
                if (state.IsConnected && !_checking)
                {
                    _notFound = false;
                }

                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the update was on its way.
        }
    }

    private enum Sheet
    {
        None,
        Brand,
        Model,
    }

    private sealed class RelayRow
    {
        public RelayRow(SetupRelay relay)
        {
            Id = relay.Id;
            Name = relay.HasDefaultName ? "" : relay.Name;
            IsActive = relay.IsActive;
            GroupName = relay.GroupName;
        }

        public int Id { get; }

        public string Name { get; set; }

        public bool IsActive { get; set; }

        public string? GroupName { get; }

        public bool Trying { get; set; }

        public string? Error { get; set; }

        /// <summary>Its name as the summary shows it.</summary>
        public string Shown => string.IsNullOrWhiteSpace(Name) ? Relay.DefaultName(Id) : Name.Trim();
    }
}
