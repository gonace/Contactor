@page "/setup"
@implements IDisposable
@using System.Globalization
@using Contactor.Boards
@using Contactor.Web.Features.Access
@using Contactor.Web.Features.Boards
@using Contactor.Web.Features.Cloudflare
@using Contactor.Web.Features.Tailscale
@using Contactor.Web.Features.Identity
@using Contactor.Web.Features.Relays
@using Contactor.Web.Features.Setup
@using Contactor.Web.Persistence
@inject SetupHandler Setup
@inject SetupSignInHandler SignIns
@inject BoardAddressHandler Address
@inject UsersHandler Users
@inject BoardRegistry Registry
@inject CurrentUser CurrentUser
@inject NavigationManager Navigation
@inject ILogger<SetupGuide> Log

<PageTitle>Setup · Contactor</PageTitle>

<div class="screen">
    @* While a list of "Which relay board?" is open, everything but the list and its field takes no focus or clicks
       (BoardModelPicker makes its own step inert around it). *@
    <header class="header" inert="@_sheetOpen">
        @if (CanGoBack)
        {
            var shown = _step;
            <button type="button" class="back" disabled="@Busy" @onclick="() => Back(shown)">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
                Back
            </button>
        }
        else
        {
            <span></span>
        }
        <span class="step-count">STEP @StepInPart OF @StepsInPart</span>
    </header>

    <div class="part" inert="@_sheetOpen">@(InPart1 ? "PART 1 OF 2 · THE APP" : "PART 2 OF 2 · THE BOARD")</div>
    <div class="progress" aria-hidden="true" inert="@_sheetOpen">
        @for (var i = 1; i <= StepsInPart; i++)
        {
            <span class="@(i <= StepInPart ? "done" : null)"></span>
        }
    </div>

    <main class="content">
        @if (_step == StepWayIn)
        {
            @WayInStep
        }
        else if (_step == StepSignIn)
        {
            @SignInStep
        }
        else if (_step == StepAbout)
        {
            <div class="intro">
                <h1 tabindex="-1" @ref="_heading">About you</h1>
                <p>Your name in Contactor. Then four short questions about your relay board. You can change all of it later under Settings.</p>
            </div>
            <div class="field">
                <label for="name">Your name</label>
                <input id="name" type="text" maxlength="@User.DisplayNameMaxLength" autocomplete="given-name" @bind="_name" @bind:event="oninput" />
                <p class="hint">Shown in the app and under Events, e.g. "@(string.IsNullOrWhiteSpace(_name) ? "Jane" : _name.Trim()) turned on Compressor".</p>
            </div>
            <div class="info">
                <span class="label">YOU'LL NEED</span>
                <p>The relay board switched on and plugged into the same network as this app. Your router lists its address among its connected devices.</p>
            </div>
        }
        else if (_step == StepBoard)
        {
            <BoardModelPicker @ref="_picker" @bind-Type="_type" Busy="Busy" OpenChanged="OnListOpened" />
        }
        else if (Chosen is not { Model: not null } chosen)
        {
            @* The board chosen here is gone (it can't be, while the guide runs): its steps start again. *@
            <p class="hint">Choose your relay board first.</p>
        }
        else if (_step == StepWhere)
        {
            <BoardWhereStep @ref="_where" Board="chosen" Values="_whereFields" UserEmail="@_user?.Email" Busy="Busy"
                            BusyChanged="busy => _stepBusy = busy" ErrorChanged="error => _error = error" />
        }
        else if (_step == StepRelays)
        {
            <BoardRelaysStep @ref="_relaysStep" Board="chosen" Rows="_relays" UserEmail="@_user?.Email" />
        }
        else
        {
            var inUse = _relays.Count(r => r.IsActive);
            var first = _relays.FirstOrDefault(r => r.IsActive);
            var board = Chosen;
            var connected = board?.State.IsConnected == true;
            var endpoint = board?.Endpoint;
            var modelName = board?.Model?.Name ?? "Relay board";
            <div class="intro">
                <span class="done-mark" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"></path></svg>
                </span>
                <h1 tabindex="-1" @ref="_heading">All set@(string.IsNullOrWhiteSpace(_name) ? "" : $", {_name.Trim()}")</h1>
                <p>@(connected ? "Your relay board is ready." : "The app keeps looking for your relay board. You can change its address under Settings.")</p>
            </div>
            <dl class="summary">
                <div>
                    <dt class="label">BOARD</dt>
                    <dd>@(endpoint is { HasHost: true } ? $"{modelName} at {endpoint.Host}" : $"{modelName}, no address yet")</dd>
                </div>
                <div>
                    <dt class="label">RELAYS</dt>
                    <dd>@SetupText.RelaysInUse(inUse, _relays.Count - inUse)</dd>
                </div>
            </dl>
            <h2>Good next steps</h2>
            <div class="links">
                <a href="group/new">Make a group, e.g. a fan heater <span aria-hidden="true">→</span></a>
                @if (first is not null)
                {
                    <a href="@($"relay/{first.Id}")">Add a schedule, e.g. to @first.Shown <span aria-hidden="true">→</span></a>
                }
            </div>
        }
    </main>

    <div class="next" inert="@_sheetOpen">
        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }
        @if (_elsewhere is not null)
        {
            <a href="@_elsewhere" class="finish">Open @(new Uri(_elsewhere).Host)</a>
        }
        else if (_step < StepDone)
        {
            var shown = _step;
            <button type="button" disabled="@(Busy || (_step == StepBoard && BoardCatalogue.Find(_type) is null))" @onclick="() => GoOnAsync(shown)">Next</button>
            @if (_step == StepWhere)
            {
                <button type="button" class="link" disabled="@Busy" @onclick="GoOnWithoutConnectionAsync">Go on without a connection</button>
            }
        }
        else
        {
            <a href="" class="finish">Go to Relays</a>
        }
    </div>

</div>

@code {
    // The steps in order. Part 1 sets up the app; its first step, the setup code, is a page of its own
    // (SetupCodePage), so the guide's Part 1 starts at its step 2. Part 2 is the board.
    private const int StepWayIn = 1;
    private const int StepSignIn = 2;
    private const int StepAbout = 3;
    private const int StepBoard = 4;
    private const int StepWhere = 5;
    private const int StepRelays = 6;
    private const int StepDone = 7;
    private const int StepsInPart = 4;

    private bool InPart1 => _step <= StepAbout;

    private int StepInPart => InPart1 ? _step + 1 : _step - StepAbout;

    // Not back past the way in (the code is typed), nor from "About you" to the sign-in: that is saved, and this page
    // may be at the new address.
    private bool CanGoBack => _elsewhere is null
        && (_step == StepSignIn || _step > StepBoard || (_step == StepBoard && SignIns.SignIn?.Id != SignInCatalogue.NoneId));

    // "How do people reach the app?": every way in; Cloudflare also asks for its tunnel's token and address, Tailscale
    // for an auth key and the app's name.
    private RenderFragment WayInStep => __builder =>
    {
        <div class="intro">
            <h1 tabindex="-1" @ref="_heading">How do people reach the app?</h1>
            <p>Where should people be able to open Contactor?</p>
        </div>
        <div class="choices" role="radiogroup" aria-label="Ways in">
            @foreach (var way in AccessCatalogue.All)
            {
                var id = way.Id;
                <label class="choice @(id == _wayIn ? "chosen" : null)">
                    <input type="radio" name="way-in" checked="@(id == _wayIn)" @onchange="() => _wayIn = id" />
                    <span class="choice-text">
                        <span class="name">@way.Name @if (way.Simplest)
                            {
                                <span class="tag">SIMPLEST</span>
                            }</span>
                        <span class="note">@way.Description</span>
                    </span>
                </label>
            }
        </div>
        @if (_wayIn == CloudflareMethods.TunnelId)
        {
            <div class="field">
                <label for="tunnel-token">Tunnel token</label>
                <input id="tunnel-token" type="password" autocomplete="new-password" spellcheck="false" maxlength="@CloudflareSetting.TunnelTokenMaxLength"
                       placeholder="@(SignIns.WayIn?.Id == CloudflareMethods.TunnelId ? "unchanged" : "")" @bind="_tunnelToken" @bind:event="oninput" />
                <p class="hint">Zero Trust → Networks → Tunnels → your tunnel. It is the long code after <code>--token</code> in the install command.</p>
            </div>
            <div class="field">
                <label for="tunnel-address">Address</label>
                <input id="tunnel-address" type="text" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false"
                       maxlength="@CloudflareSetting.HostNameMaxLength" placeholder="relays.example.com" @bind="_tunnelAddress" @bind:event="oninput" />
                <p class="hint">The tunnel's public hostname: where people will open Contactor. In Cloudflare, point it at <code>http://contactor:8080</code>.</p>
            </div>
        }
        else if (_wayIn == TailscaleMethods.NetworkId)
        {
            <div class="field">
                <label for="auth-key">Auth key</label>
                <input id="auth-key" type="password" autocomplete="new-password" spellcheck="false" maxlength="@TailscaleSetting.AuthKeyMaxLength"
                       placeholder="@(SignIns.WayIn?.Id == TailscaleMethods.NetworkId ? "unchanged" : "tskey-auth-…")" @bind="_authKey" @bind:event="oninput" />
                <p class="hint">Tailscale's admin console → Settings → Keys → Generate auth key, not ephemeral. Under DNS, also turn on MagicDNS and HTTPS Certificates.</p>
            </div>
            <div class="field">
                <label for="tailscale-name">Name on your Tailscale network</label>
                <input id="tailscale-name" type="text" autocomplete="off" autocapitalize="off" spellcheck="false"
                       maxlength="@TailscaleSetting.HostNameMaxLength" placeholder="@TailscaleSetting.DefaultHostName" @bind="_tailscaleName" @bind:event="oninput" />
                <p class="hint">People open Contactor at https://@(string.IsNullOrWhiteSpace(_tailscaleName) ? TailscaleSetting.DefaultHostName : _tailscaleName.Trim().ToLowerInvariant()).<i>your-network</i>.ts.net.</p>
            </div>
        }
    };

    // "How do people sign in?": every sign-in, what fits the way in can be chosen, the rest is greyed out.
    private RenderFragment SignInStep => __builder =>
    {
        var cloudflare = SignIns.WayIn?.Id == CloudflareMethods.TunnelId;
        var tailscale = SignIns.WayIn?.Id == TailscaleMethods.NetworkId ? SignIns.Tailscale : null;
        var (address, connected) = SignIns.Tunnel;
        var options = SignIns.SignIns();
        var recommended = options.FirstOrDefault(o => o.Recommended);
        <div class="intro">
            <h1 tabindex="-1" @ref="_heading">@(_elsewhere is null ? "How do people sign in?" : "Go on at your new address")</h1>
            <p>@(_elsewhere is not null
                ? $"Contactor now only answers through {SignIns.WayIn?.Name}. Open it there{(SignIns.SignIn?.Id == TailscaleMethods.IdentityId ? ", on a phone or computer on your Tailscale network" : " and sign in with your e-mail")}{(_setupDone ? "." : ": the guide goes on.")}"
                : recommended is not null ? $"Recommended with {SignIns.WayIn?.Name}: {recommended.Method.Name}." : "With a sign-in, the events show who did what.")</p>
        </div>
        @if (_elsewhere is null)
        {
            <div class="choices" role="radiogroup" aria-label="Sign-ins">
                @foreach (var option in options)
                {
                    var id = option.Method.Id;
                    <label class="choice @(id == _signInId ? "chosen" : null) @(option.Allowed ? null : "off")">
                        <input type="radio" name="sign-in" checked="@(id == _signInId)" disabled="@(!option.Allowed)" @onchange="() => _signInId = id" />
                        <span class="choice-text">
                            <span class="name">@option.Method.Name @if (option.Recommended)
                                {
                                    <span class="tag">RECOMMENDED</span>
                                }
                                else if (option.Method.NotRecommended && option.Allowed)
                                {
                                    <span class="tag warn">NOT RECOMMENDED</span>
                                }</span>
                            <span class="note">@(option.Reason ?? option.Method.Description)</span>
                        </span>
                    </label>
                }
            </div>
            @if (_signInId == CloudflareMethods.AccessId)
            {
                <div class="field">
                    <label for="team-domain">Team domain</label>
                    <input id="team-domain" type="text" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false"
                           maxlength="@CloudflareSetting.HostNameMaxLength" placeholder="myteam.cloudflareaccess.com" @bind="_teamDomain" @bind:event="oninput" />
                    <p class="hint">Zero Trust → Settings → Team name and domain.</p>
                </div>
                <div class="field">
                    <label for="audience">AUD tag</label>
                    <input id="audience" type="text" autocomplete="off" autocapitalize="off" spellcheck="false"
                           maxlength="@CloudflareSetting.AudienceMaxLength" @bind="_audience" @bind:event="oninput" />
                    <p class="hint">Zero Trust → Access controls → Applications → the application for @(address ?? "your address") → Edit → Additional settings.</p>
                </div>
            }
            else if (_signInId == SignInCatalogue.NoneId)
            {
                <p class="warning" role="note">Anyone on your network can switch the relays, and the events can't say who did it. Choose a sign-in to reach the app from outside.</p>
            }
        }
        @if (cloudflare)
        {
            <div class="board-status" role="status">
                <span class="dot @(connected ? null : "waiting")"></span>
                <span class="status-text">
                    <b>@(connected ? "Tunnel connected" : "Waiting for the tunnel to connect")</b>
                    <span>@(connected && address is not null ? $"Cloudflare answers at {address}." : "It can take a minute. Check the token if it doesn't.")</span>
                </span>
            </div>
        }
        else if (tailscale is not null)
        {
            <div class="board-status" role="status">
                <span class="dot @(tailscale.Online ? null : "waiting")"></span>
                <span class="status-text">
                    <b>@(tailscale.Online ? "On your Tailscale network" : "Joining your Tailscale network")</b>
                    <span>@(tailscale.Problem ?? (tailscale.Online && tailscale.Address is not null ? $"Contactor answers at https://{tailscale.Address}." : "It can take a minute."))</span>
                    @if (tailscale.Problem is not null && tailscale.Link is not null)
                    {
                        <a href="@tailscale.Link.AbsoluteUri" target="_blank" rel="noopener noreferrer">Open Tailscale to turn on HTTPS</a>
                    }
                </span>
            </div>
            <p class="hint">In Tailscale's admin console, under Machines, turn off key expiry for @(SignIns.TailscaleHostName), or it leaves the network after a few months. Under Access controls, let devices reach it only on port 443.</p>
        }
    };

    private List<BoardRelaysStep.Row> _relays = [];
    private ElementReference _heading;
    private SignedInUser? _user;
    private int _step = StepAbout;

    // Part 1's choices and fields.
    private string _wayIn = "";
    private string _signInId = "";
    private string _tunnelToken = "";
    private string _tunnelAddress = "";
    private string _authKey = "";
    private string _tailscaleName = "";
    private string _teamDomain = "";
    private string _audience = "";

    // Once the sign-in is chosen, this page no longer answers here: the address to go on at.
    private string? _elsewhere;

    // An installation in use whose sign-in was reset: the new address opens on the relays, not the guide.
    private bool _setupDone;
    private string _name = "";
    private string _type = "";
    // A list of "Which relay board?" is open (BoardModelPicker): the rest of the page is inert meanwhile.
    private bool _sheetOpen;

    // The board steps; their headings take the focus on a new step.
    private BoardModelPicker? _picker;
    private BoardWhereStep? _where;
    private BoardRelaysStep? _relaysStep;

    // What is typed on "Where is the board?", kept while the guide goes back and forth.
    private BoardWhereStep.Fields _whereFields = new();

    // A step's own save or check is under way ("Check again").
    private bool _stepBusy;
    private bool _busy;
    private bool _moved;
    private string? _error;

    // The board the guide sets up: the app's first, chosen at "Which relay board?"; null before. The same live board
    // for its whole life, so the guide keeps listening to it.
    private int? _boardId;

    private LiveBoard? Chosen => _boardId is { } id ? Registry.Find(id) : null;

    private bool Busy => _busy || _stepBusy;

    protected override async Task OnInitializedAsync()
    {
        // An installation whose sign-in was reset is done, and still opens on the sign-in.
        var part1 = SignIns.Step;
        _user = await CurrentUser.GetAsync();
        var setupDone = await Setup.IsDoneAsync(CancellationToken.None);
        if (ShouldLeave(_user is not null, part1 == SetupPart1Step.Done, setupDone))
        {
            Navigation.NavigateTo("", replace: true);
            return;
        }

        // A setup connection that outlived setup mode (its sign-in is chosen, nobody is signed in here): only the way
        // on. Sending it to the relays would bring it straight back here.
        if (part1 == SetupPart1Step.Done && _user is null)
        {
            _setupDone = setupDone;
            _elsewhere = NewAddress();
            _step = StepSignIn;
            return;
        }

        _step = part1 switch
        {
            SetupPart1Step.WayIn => StepWayIn,
            SetupPart1Step.SignIn => StepSignIn,

            // With No sign-in everyone is the same person: nothing to say about you.
            _ when SignIns.SignIn?.Id == SignInCatalogue.NoneId => StepBoard,
            _ => StepAbout,
        };
        _wayIn = SignIns.WayIn?.Id ?? AccessCatalogue.All.First(w => w.Simplest).Id;
        _signInId = DefaultSignIn();
        _tunnelAddress = SignIns.Tunnel.Address ?? "";
        _tailscaleName = SignIns.TailscaleHostName;
        _teamDomain = SignIns.Access.TeamDomain;
        _audience = SignIns.Access.Audience;
        SignIns.TunnelChanged += OnTunnelChanged;
        SignIns.TailscaleChanged += OnTunnelChanged;

        _name = _user?.DisplayName ?? "";
        // The guide sets up the app's first board; any made before is the one chosen at "Which relay board?".
        if (Registry.All.FirstOrDefault() is { Model: { } model } first)
        {
            _boardId = first.BoardId;
            _type = model.Id;
            await LoadBoardAsync(first);
        }

        Registry.StateChanged += OnBoardChanged;
    }

    // The chosen board's address, login and relays, for steps 3 to 5.
    private async Task LoadBoardAsync(LiveBoard board)
    {
        _whereFields = await BoardWhereStep.LoadAsync(Address, board, CancellationToken.None);
        _relays = await BoardRelaysStep.LoadAsync(Setup, board.BoardId, CancellationToken.None);
    }

    public void Dispose()
    {
        Registry.StateChanged -= OnBoardChanged;
        SignIns.TunnelChanged -= OnTunnelChanged;
        SignIns.TailscaleChanged -= OnTunnelChanged;
    }

    // From the tunnel's or Tailscale's own thread: "Tunnel connected" or "On your Tailscale network" on the sign-in step.
    private void OnTunnelChanged(object? sender, EventArgs e)
    {
        _ = RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The page closed meanwhile.
        }
    }

    /// <summary>
    /// Whether the guide sends the person to the relays: only someone signed in, once Part 1 and the guide are done.
    /// Anyone else stays, or the gate would send them straight back.
    /// </summary>
    public static bool ShouldLeave(bool signedIn, bool part1Done, bool setupDone) => signedIn && part1Done && setupDone;

    // Where the guide goes on once the sign-in is chosen: the tunnel's address, or the app's on the Tailscale network
    // (the guide, or the relays once it is done). Without an address, which the guide never leaves this way, the app's
    // own.
    private string NewAddress()
    {
        var address = SignIns.SignIn?.Id == TailscaleMethods.IdentityId ? SignIns.Tailscale.Address : SignIns.Tunnel.Address;
        return address is { Length: > 0 }
            ? $"https://{address}/{(_setupDone ? "" : "setup")}"
            : Navigation.BaseUri;
    }

    // The sign-in chosen to begin with: the one recommended for the way in, else the first that fits it.
    private string DefaultSignIn()
    {
        var options = SignIns.SignIns();
        return (options.FirstOrDefault(o => o.Recommended) ?? options.FirstOrDefault(o => o.Allowed))?.Method.Id ?? "";
    }

    // A new step's heading takes the focus, so a screen reader reads where it is.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_moved)
        {
            _moved = false;
            await (_step switch
            {
                StepBoard when _picker is not null => _picker.FocusAsync(),
                StepWhere when _where is not null => _where.FocusAsync(),
                StepRelays when _relaysStep is not null => _relaysStep.FocusAsync(),
                _ => _heading.FocusAsync(),
            });
        }
    }

    // A list of "Which relay board?" opened or closed: the rest is inert meanwhile, and an earlier message goes.
    private void OnListOpened(bool open)
    {
        _sheetOpen = open;
        if (open)
        {
            _error = null;
        }
    }

    private void Back(int fromStep)
    {
        if (!Busy && _step == fromStep && CanGoBack)
        {
            _step--;
            _sheetOpen = false;
            _error = null;
            _moved = true;
        }
    }

    private async Task GoOnAsync(int fromStep)
    {
        if (Busy || _step != fromStep)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            switch (_step)
            {
                case StepWayIn:
                    await ChooseWayInAsync();
                    break;
                case StepSignIn:
                    await ChooseSignInAsync();
                    break;
                case StepAbout:
                    await SaveNameAsync();
                    break;
                case StepBoard:
                    await ChooseBoardAsync();
                    break;
                case StepWhere:
                    if (_where is not null && await _where.GoOnAsync())
                    {
                        Move(StepRelays);
                    }

                    break;
                case StepRelays:
                    await SaveRelaysAsync();
                    break;
            }
        }
        catch (Exception ex)
        {
            Fail(ex, "A step of the setup guide failed");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChooseWayInAsync()
    {
        _error = await SignIns.ChooseWayInAsync(_wayIn, new WayInFields(_tunnelToken, _tunnelAddress, _authKey, _tailscaleName), CancellationToken.None);
        if (_error is null)
        {
            _tunnelToken = "";
            _authKey = "";
            _signInId = DefaultSignIn();
            Move(StepSignIn);
        }
    }

    private async Task ChooseSignInAsync()
    {
        _error = await SignIns.ChooseSignInAsync(_signInId, _teamDomain, _audience, CancellationToken.None);
        if (_error is not null)
        {
            return;
        }

        // No sign-in: this page is let in from now on, as everyone; loaded again, it goes on with the board.
        if (_signInId == SignInCatalogue.NoneId)
        {
            Navigation.NavigateTo("setup", forceLoad: true);
            return;
        }

        // Nobody is signed in in this page: from now on only the new address answers. The handler took the sign-in
        // only with an address saved.
        _setupDone = await Setup.IsDoneAsync(CancellationToken.None);
        _elsewhere = NewAddress();
        _moved = true;
    }

    private async Task SaveNameAsync()
    {
        if (_user is not null)
        {
            _error = await Users.RenameAsync(_user.Email, _name, CancellationToken.None);
            if (_error is not null)
            {
                return;
            }

            _name = _name.Trim();
        }

        Move(StepBoard);
    }

    private async Task ChooseBoardAsync()
    {
        // Someone else finished the guide while this page was open: the model is never changed afterwards.
        if (await Setup.IsDoneAsync(CancellationToken.None))
        {
            Navigation.NavigateTo("");
            return;
        }

        if (BoardCatalogue.Find(_type) is not { } chosen)
        {
            _error = "Choose your relay board.";
            return;
        }

        // The app switches to the board while it runs, and the guide goes straight on.
        var before = Chosen?.Model;
        var board = await Setup.ChooseBoardAsync(_type, CancellationToken.None);
        _boardId = board.BoardId;
        if (before?.Id != chosen.Model.Id)
        {
            await LoadBoardAsync(board);

            // An address saved for the board chosen before kept that board's own port: offer the new one's instead.
            if (before is not null && _whereFields.Port == before.DefaultPort.ToString(CultureInfo.InvariantCulture))
            {
                _whereFields.Port = "";
            }
        }

        Move(StepWhere);
    }

    private async Task GoOnWithoutConnectionAsync()
    {
        if (Busy || _step != StepWhere || _where is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            if (await _where.GoOnWithoutConnectionAsync())
            {
                Move(StepRelays);
            }
        }
        catch (Exception ex)
        {
            Fail(ex, "Saving the relay board's address failed");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveRelaysAsync()
    {
        if (_user is null)
        {
            return;
        }

        _error = await BoardRelaysStep.SaveAsync(Setup, _relays, _user.Email, CancellationToken.None);
        if (_error is null)
        {
            await Setup.MarkDoneAsync(CancellationToken.None);
            Move(StepDone);
        }
    }

    private void Move(int step)
    {
        _step = step;
        _sheetOpen = false;
        _moved = true;
    }

    private void Fail(Exception ex, string what)
    {
        // An exception that leaves the handler would end the page's live connection.
        Log.LogError(ex, "{What}", what);
        _error = "Something went wrong. Try again.";
    }

    // From a board's read loop: the guide's own board's, for "All set".
    private void OnBoardChanged(object? sender, BoardStateChange change)
    {
        if (change.BoardId == _boardId)
        {
            _ = RefreshAsync();
        }
    }
}
