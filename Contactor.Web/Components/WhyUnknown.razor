@using Contactor.Web.Features.Inputs

@* An ⓘ right after "since unknown": its reason shows as a tooltip on hover, on keyboard focus, or when pressed (a
   second press, or a tap anywhere else, closes it), since a phone has no hover. The tooltip lines up with the start of
   the nearest positioned line around it (the status line), so it never runs off the screen's edge. *@
<span class="why-wrap">
    <button type="button" class="why" aria-label="@Label" aria-expanded="@(_shown ? "true" : "false")" aria-describedby="@TipId" @onclick="() => _shown = !_shown">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5"></path><path d="M12 8h.01"></path></svg>
    </button>
    <span class="tip @(_shown ? "open" : null)" role="tooltip" id="@TipId">@InputStatusText.WhyUnknown</span>
</span>
@if (_shown)
{
    @* A tap anywhere else closes it, as people expect on a phone. *@
    <button type="button" class="tip-backdrop" tabindex="-1" aria-hidden="true" @onclick="() => _shown = false"></button>
}

@code {
    private bool _shown;

    /// <summary>What a screen reader calls the button, e.g. "Why is the time unknown for Door?".</summary>
    [Parameter]
    [EditorRequired]
    public string Label { get; set; } = "";

    /// <summary>Makes the tooltip's id unique on the page, e.g. the input's number.</summary>
    [Parameter]
    [EditorRequired]
    public int For { get; set; }

    private string TipId => $"why-{For}";
}
