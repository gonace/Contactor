@implements IDisposable
@using Contactor.Boards
@using Contactor.Web.Features.BoardRules
@using Contactor.Web.Features.Boards
@using Contactor.Web.Features.Identity
@using Contactor.Web.Features.Languages
@using Contactor.Web.Persistence
@using Microsoft.EntityFrameworkCore
@inject BoardRegistry Registry
@inject OwnRulesService Rows
@inject OwnRulesHandler Handler
@inject OwnRulesText Words
@inject CurrentUser CurrentUser
@inject LocalClock Clock
@inject IDbContextFactory<ContactorDbContext> DbFactory
@inject ILogger<OwnRulesCard> Log
@inject AppLanguage Language

@* The board's own rules (issue #497), on the board's page and on Settings with one board: each rule the app found,
   with "Turn off" and "Keep" ("Reset" alone for a relay the board controls by itself; a rule that runs on the board
   right now in a group of its own, issue #552), or a line for a board that may have rules the app can't see. None for a board that has
   none. A rule whose turn-off takes other relays' rules with it says so under it ("Also turns off the board's timer
   for Heat."). A board that answers but couldn't read its rules (issue #551) gets a line saying so, under any rows
   from before; one that couldn't read only some relays' rules (issue #554) gets a line saying so and a row for each of them. *@
@if (Board is { } board && (_rows.Count > 0 || Ability(board).MayHaveUnseen || OwnRulesHandler.CouldntRead(board) || !OwnRulesHandler.CouldntReadRelays(board).IsEmpty))
{
    var ability = Ability(board);
    var connected = board.State.IsConnected;
    var couldntRead = OwnRulesHandler.CouldntRead(board);
    var unknownRelays = OwnRulesHandler.CouldntReadRelays(board);
    <section class="card own-rules-card" aria-labelledby="own-rules-@BoardId">
        <h2 id="own-rules-@BoardId">@(_rows.Count == 0 && (couldntRead || !unknownRelays.IsEmpty) ? Texts["OwnRules.Card.Title.Rule"] : Words.CardTitle(_rows.Select(r => r.Kind)))</h2>
        @if (_rows.Count > 0)
        {
            <p class="hint">@Texts["OwnRules.Card.Hint"]</p>
        }
        @if (_rows.Where(r => !Running(r)).ToList() is { Count: > 0 } listed)
        {
            <ul class="rules">
                @foreach (var row in listed)
                {
                    var kept = row.KeptUtc is not null;
                    var canTurnOff = Handler.CanTurnOff(BoardId, new OwnRule(row.Channel, row.Kind));
                    var id = $"own-rule-{BoardId}-{row.Channel}-{OwnRuleKinds.For(row.Kind)}";
                    <li class="rule @(kept ? "kept" : null)" @key="id">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                        <span class="text" id="@id">
                            <span class="label">@Texts["Relays.RelayLabel", row.Channel]</span>
                            <span class="name">@(_names.GetValueOrDefault(row.Channel) ?? Texts["Relays.DefaultName", row.Channel])</span>
                            <span class="note">@(kept ? Texts["OwnRules.Kept"] : Words.Found(Clock.ToLocal(row.FoundUtc), Clock.Now))</span>
                            @if (canTurnOff && Also(row) is { } also)
                            {
                                @* Said before the press: the other relays' rules this "Turn off" takes with it. *@
                                <span class="also">@also</span>
                            }
                        </span>
                        <span class="buttons">
                            @if (canTurnOff)
                            {
                                @* A relay the board controls by itself is reset; the app can't switch it until then. *@
                                <button type="button" class="@(kept ? "secondary" : "primary")" aria-describedby="@id" disabled="@(_busy || !connected)" @onclick="() => TurnOffAsync(row)">@Texts[row.Kind == OwnRuleKind.InputLinkage ? "OwnRules.Reset" : "OwnRules.TurnOff"]</button>
                            }
                            @* Never "Keep" for a relay the board controls by itself: it stays unavailable until reset. Nor
                               for the auto-on or the restart pulse of a relay in a group: a line says why in its place. *@
                            @if (!kept && OwnRulesHandler.CanKeep(row.Kind, _grouped.ContainsKey(row.Channel)))
                            {
                                <button type="button" class="secondary" aria-describedby="@id" disabled="@(_busy || !connected)" @onclick="() => KeepAsync(row)">@Texts["OwnRules.Keep"]</button>
                            }
                            else if (!kept && OwnRulesHandler.CanKeep(row.Kind, inGroup: false))
                            {
                                <span class="cant-keep">@Handler.InGroup(row.Channel, _names.GetValueOrDefault(row.Channel))</span>
                            }
                        </span>
                    </li>
                }
            </ul>
        }
        @if (!unknownRelays.IsEmpty)
        {
            @* The relays whose rules the board couldn't read: never shown as having none. The message once, then a row
               per relay. *@
            <p class="hint">@Texts["OwnRules.Card.CouldntReadRelays" + Plurals.Form(unknownRelays.Count)]</p>
            <ul class="rules">
                @foreach (var channel in unknownRelays.Channels)
                {
                    var id = $"own-rules-unknown-{BoardId}-{channel}";
                    <li class="rule" @key="id">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"></path><path d="M12 17h.01"></path><path d="M10.3 3.9L2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg>
                        <span class="text" id="@id">
                            <span class="label">@Texts["Relays.RelayLabel", channel]</span>
                            <span class="name">@(_names.GetValueOrDefault(channel) ?? Texts["Relays.DefaultName", channel])</span>
                        </span>
                    </li>
                }
            </ul>
        }
        @* A rule that runs on the board right now, in a group of its own: no "Turn off", "Keep" once it has ended. *@
        <OwnRulesRunning BoardId="BoardId" Channels="@([.. _rows.Where(Running).Select(r => r.Channel).Distinct()])" Names="_names" />
        @if (couldntRead)
        {
            @* In place of "may also have": the app doesn't know even the rules it can read. *@
            <p class="hint">@Texts["OwnRules.Card.CouldntRead"]</p>
        }
        else if (ability.MayHaveUnseen)
        {
            <p class="hint">@Texts[ability.Reads ? "OwnRules.Card.MayHaveUnseen" : "OwnRules.Card.CantTell"]</p>
        }
        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }
    </section>
}

@code {
    private IReadOnlyList<OwnRuleRow> _rows = [];
    private Dictionary<int, string> _names = [];

    // The board's relays in a group, by channel: a rule that can't be kept there has no "Keep" (OwnRulesHandler.CanKeep).
    private Dictionary<int, string> _grouped = [];
    private string? _error;
    private bool _busy;
    private int? _loadedFor;

    // Counts the loads, on the page's own thread: only the latest one shows its rows.
    private int _loads;

    // What was drawn: a board's change redraws the card only when its contact, whether its rules could be read, or what
    // goes with its rules changes.
    private bool? _shownConnected;
    private bool _shownCouldntRead;
    private ChannelMask _shownCouldntReadRelays;
    private string _shownAlso = "";

    // Set when the card closes, on the page's own thread: an event already on its way doesn't load or draw it.
    private bool _disposed;

    /// <summary>The board whose rules the card shows.</summary>
    [Parameter]
    [EditorRequired]
    public int BoardId { get; set; }

    private LiveBoard? Board => Registry.Find(BoardId);

    private static OwnRulesAbility Ability(LiveBoard board)
    {
        return board.Capabilities.OwnRulesOrCantTell;
    }

    // Subscribed before the first load: a change while it loads is loaded again after it.
    protected override void OnInitialized()
    {
        Registry.StateChanged += OnBoardChanged;
        Registry.OwnRulesChanged += OnBoardChanged;
        Rows.Changed += OnRowsChanged;
    }

    // Another board, as a link to another board's page gives: its own rows.
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor != BoardId)
        {
            _loadedFor = BoardId;
            _error = null;
            await LoadAsync();
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        _shownConnected = Board?.State.IsConnected;
        _shownCouldntRead = OwnRulesHandler.CouldntRead(Board);
        _shownCouldntReadRelays = OwnRulesHandler.CouldntReadRelays(Board);
        _shownAlso = AlsoShown();
    }

    public void Dispose()
    {
        _disposed = true;
        Registry.StateChanged -= OnBoardChanged;
        Registry.OwnRulesChanged -= OnBoardChanged;
        Rows.Changed -= OnRowsChanged;
    }

    // Whether the row goes in the running group: a rule no person kept that runs on the board right now
    // (OwnRulesHandler.RunsOnBoard). A kept one stays in the list as kept, with no button.
    private bool Running(OwnRuleRow row)
    {
        return row.KeptUtc is null && Handler.RunsOnBoard(BoardId, new OwnRule(row.Channel, row.Kind));
    }

    // "Also turns off the board's timer for Heat.": what turning off the row's rule takes with it, or null.
    private string? Also(OwnRuleRow row)
    {
        return Words.AlsoTurnsOff(Handler.AlsoTurnsOff(BoardId, [new OwnRule(row.Channel, row.Kind)]), _names);
    }

    // Every row's "also" words and whether it can be turned off, to tell when the board's rules going together, or
    // those it can't turn off, changed.
    private string AlsoShown()
    {
        return Board is { } board && Ability(board).TurnsOff
            ? string.Join("\n", _rows.Select(r => $"{Handler.CanTurnOff(BoardId, new OwnRule(r.Channel, r.Kind))} {Also(r)}"))
            : "";
    }

    // The rows, in relay order, and the names of their relays. Only the latest load shows: an older one that finishes
    // after it (two changes close together) would show rows that are gone.
    private async Task LoadAsync()
    {
        var load = ++_loads;
        var boardId = BoardId;
        var rows = Rows.Rows(boardId);

        // The names also without rows while a relay's rules couldn't be read: it is named too.
        if (rows.Count == 0 && OwnRulesHandler.CouldntReadRelays(Board).IsEmpty)
        {
            _rows = [];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var names = await db.Relays.AsNoTracking().Where(r => r.BoardId == boardId).ToDictionaryAsync(r => r.Channel, r => r.Name);
        var grouped = await OwnRulesService.GroupedRelaysAsync(db, boardId, CancellationToken.None);
        if (load != _loads)
        {
            return;
        }

        _names = names;
        _grouped = grouped;
        _rows = [.. rows.OrderBy(r => r.Channel).ThenBy(r => r.Kind)];
    }

    private Task TurnOffAsync(OwnRuleRow row)
    {
        return RunAsync(email => Handler.TurnOffAsync(BoardId, [new OwnRule(row.Channel, row.Kind)], email, CancellationToken.None));
    }

    private Task KeepAsync(OwnRuleRow row)
    {
        return RunAsync(email => Handler.KeepAsync(BoardId, row.Channel, row.Kind, email, CancellationToken.None));
    }

    // A press: what went wrong shows on the card; the rows change by the service (Changed).
    private async Task RunAsync(Func<string, Task<string?>> press)
    {
        if (_busy || await CurrentUser.GetAsync() is not { } user)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            _error = await press(user.Email);
        }
        catch (Exception ex)
        {
            // An exception that leaves the handler would end the page's live connection.
            Log.LogError(ex, "Changing the own rules of relay board {BoardId} failed", BoardId);
            _error = Texts["Common.SomethingWrongTryAgain"];
        }
        finally
        {
            _busy = false;
        }
    }

    // From a board's read loop: the buttons follow the board's contact, the "couldn't read" line and rows and the "also"
    // words its rules.
    private void OnBoardChanged(object? sender, BoardStateChange change)
    {
        if (change.BoardId == BoardId)
        {
            _ = RefreshAsync(reload: false);
        }
    }

    private void OnRowsChanged(object? sender, int boardId)
    {
        if (boardId == BoardId)
        {
            _ = RefreshAsync(reload: true);
        }
    }

    private async Task RefreshAsync(bool reload)
    {
        using var language = Language.Use();
        try
        {
            await InvokeAsync(async () =>
            {
                // On the page's own thread, as Dispose is: a closed card loads and draws nothing.
                if (_disposed)
                {
                    return;
                }

                if (reload || OwnRulesHandler.CouldntReadRelays(Board) != _shownCouldntReadRelays)
                {
                    // Also when the relays whose rules couldn't be read change: their names are loaded with the rows.
                    await LoadAsync();
                    StateHasChanged();
                }
                else if (Board?.State.IsConnected != _shownConnected || OwnRulesHandler.CouldntRead(Board) != _shownCouldntRead || AlsoShown() != _shownAlso)
                {
                    StateHasChanged();
                }
            });
        }
        catch (ObjectDisposedException)
        {
            // The card closed while the change was on its way.
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Not shown to the person: the card keeps what it shows, and the next change tries again.
            Log.LogWarning(ex, "The page could not reload {What}", "the board's own rules");
        }
    }
}
