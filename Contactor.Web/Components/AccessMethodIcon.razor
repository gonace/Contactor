@using Contactor.Web.Features.Access
@using Contactor.Web.Features.Cloudflare
@using Contactor.Web.Features.Tailscale

<svg class="access-method-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (MethodId)
    {
        case AccessCatalogue.LocalId:
            <path d="m3 10 9-7 9 7" />
            <path d="M5 9v12h14V9" />
            <path d="M9 21v-6h6v6" />
            break;
        case CloudflareMethods.TunnelId:
            <path d="M20 17.5H6a4.5 4.5 0 0 1-.25-8.99A6.5 6.5 0 0 1 18.2 7.3 5.1 5.1 0 0 1 20 17.5Z" />
            break;
        case TailscaleMethods.NetworkId:
            <circle cx="6" cy="6" r="2" />
            <circle cx="18" cy="6" r="2" />
            <circle cx="6" cy="18" r="2" />
            <circle cx="18" cy="18" r="2" />
            <path d="m8 6 8 0M6 8v8m12-8v8m-10 2 8 0" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string MethodId { get; set; } = "";
}
