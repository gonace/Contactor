@page "/group/{Id:int}"
@implements IDisposable
@using Contactor.Boards
@using Microsoft.EntityFrameworkCore
@using Contactor.Web.Features.BoardRules
@using Contactor.Web.Features.Boards
@using Contactor.Web.Features.Events
@using Contactor.Web.Features.Groups
@using Contactor.Web.Features.Identity
@using Contactor.Web.Features.Languages
@using Contactor.Web.Features.Relays
@using Contactor.Web.Features.Schedules
@using Contactor.Web.Persistence
@inject BoardRegistry Registry
@inject GroupsHandler Groups
@inject GroupSequencer Sequencer
@inject EventsHandler Events
@inject SchedulesHandler Schedules
@inject ScheduleOutlook Outlook
@inject RelayChanges Changes
@inject CurrentUser CurrentUser
@inject LocalClock Clock
@inject TimeProvider Time
@inject NavigationManager Navigation
@inject IDbContextFactory<ContactorDbContext> DbFactory
@inject ILogger<GroupDetail> Log
@inject RelayStatusText StatusText
@inject GroupStatusText GroupStatus
@inject AppLanguage Language
@inject OwnRulesHandler OwnRules
@inject OwnRulesText OwnRulesText
@inject RelayPowerOnHandler PowerOn
@inject BoardsText BoardsText

<PageTitle>@(Texts["Common.PageTitle", _group?.Name ?? Texts["Common.Screen.Group"].Value])</PageTitle>

@* What the power-cut warning and the note on saving show, kept as they are drawn: a change of the board's states after
   a power cut that alters neither redraws nothing (OnPowerOnChanged). *@
@{ _shownPowerOn = ShownPowerOn; }

<div class="screen">
    <header class="header">
        <a href="" class="back">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
            @Texts["Common.Screen.Relays"]
        </a>
        @if (_group is not null)
        {
            @* On a desktop Save sits here, pinned to the top; on a phone and a tablet it is at the bottom of the form. *@
            <button type="submit" form="group-form" class="save-top" disabled="@_busy">@Texts["Common.Save"]</button>
        }
    </header>

    @if (_loaded && _group is null)
    {
        <main class="content">
            <p class="missing">@Texts["Groups.Missing"]</p>
        </main>
    }
    else if (_group is not null)
    {
        <form id="group-form" class="form" @onsubmit="SaveAsync">
            <main class="content">
                @if (Unavailable is { Count: > 0 } unavailable)
                {
                    @* The board controls a relay of the group by itself: the group won't start until it is reset. *@
                    <div class="offline group-unavailable" role="status">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"></path><path d="M12 17h.01"></path><path d="M10.3 3.9L2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg>
                        <div>
                            <strong>@OwnRulesText.GroupUnavailable(unavailable.Select(m => m.RoleName))</strong>
                            <span>@Texts["OwnRules.Unavailable.GroupText" + Plurals.Form(unavailable.Count)]</span>
                            <button type="button" class="reset" disabled="@(_busy || !State.IsConnected)" @onclick="ResetAsync">@Texts["OwnRules.Reset"]</button>
                            @if (_resetError is not null)
                            {
                                <span class="reset-error" role="alert">@_resetError</span>
                            }
                        </div>
                    </div>
                }
                @if (NotSafe is { Count: > 0 } notSafe)
                {
                    @* The board turns some of the group's relays on by itself after a power cut, before Contactor runs and
                       without the group's start order (GroupPowerOn). The group can still start. *@
                    <div class="offline group-unavailable power-on" role="status">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"></path><path d="M12 17h.01"></path><path d="M10.3 3.9L2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg>
                        <div>
                            <strong>@Texts["Groups.PowerOn.Warning", BoardsText.And([.. notSafe.Select(m => m.RoleName).Distinct()])]</strong>
                            <span>@Texts["Groups.PowerOn.WarningText" + Plurals.Form(notSafe.Count)]</span>
                            @if (PowerOnAbility is { PerRelay: false })
                            {
                                <span>@Texts["Relays.PowerOn.WholeBoard"]</span>
                            }
                            @if (!State.IsConnected)
                            {
                                <span>@Texts["Relays.PowerOn.NoContactNow"]</span>
                            }
                            <button type="button" class="reset make-safe" disabled="@(_busy || !State.IsConnected)" @onclick="MakeSafeAsync">@Texts["Groups.PowerOn.MakeSafe"]</button>
                            @if (_powerOnError is not null)
                            {
                                <span class="reset-error" role="alert">@_powerOnError</span>
                            }
                        </div>
                    </div>
                }
                <div class="field">
                    <label for="name" class="label">@Texts["Groups.NameLabel"]</label>
                    <input id="name" type="text" maxlength="@RelayGroup.NameMaxLength" @bind="_name" @bind:event="oninput" autocomplete="off" />
                </div>

                <fieldset class="icon-field">
                    <legend>@Texts["Groups.Icon"]</legend>
                    <IconPicker @bind-Value="_icon" />
                </fieldset>

                @if (!State.HasAnswered)
                {
                    @* Before the board's first answer: unknown, all grey. *@
                    <section class="status unknown">
                        <p>@StatusText.Waiting</p>
                        <button type="button" class="toggle unknown" aria-label="@StatusText.Waiting" disabled>–</button>
                    </section>
                }
                else
                {
                <section class="status @(GroupOn ? "on" : "") @(_group.Runtime.Phase == GroupPhases.Stopping ? "stopping" : "")">
                    <p>@(Missing is { } missing ? GroupStatus.MissingRelay(missing) : GroupStatus.For(_group, State, Clock.UtcNow, Clock.ToLocal, NameOf, _outlook))</p>
                    <button type="button" class="toggle" data-vibrate aria-pressed="@(GroupOn ? "true" : "false")" disabled="@(!State.IsConnected || _busy || Missing is not null || (!GroupOn && Unavailable.Count > 0))" @onclick="ToggleGroupAsync">
                        @Texts[GroupOn ? "Groups.TurnOff" : "Groups.TurnOn"]
                    </button>
                    @if (_toggleError is not null)
                    {
                        <p class="error" role="alert">@_toggleError</p>
                    }
                </section>
                }

                <section class="members">
                    <div class="section-text">
                        <h2>@Texts["Groups.Steps"]</h2>
                        <p class="hint">@(Registry.Shown.Count > 1 && Registry.Find(_group.BoardId) is { } board ? Texts["Groups.Steps.HintOn", board.Name] : Texts["Groups.Steps.Hint"])</p>
                    </div>
                    <GroupStepsEditor Editor="_editor"
                                      CanChange="CanChangeMembers"
                                      CanAdd="CanAdd"
                                      Addable="[.. AddableRelays]"
                                      StepClass="StepClass"
                                      OnMove="Move"
                                      OnRemove="Remove"
                                      OnJoin="JoinStepAbove"
                                      OnAdd="AddRelay">
                        <StepNote Context="stepIndex">
                            <span class="note">@(State.HasAnswered ? StepNote(stepIndex) : StatusText.Waiting)</span>
                        </StepNote>
                        <RelayEnd Context="relay">
                            @{
                                var on = State.IsOn(relay.Channel);
                                var blockedBy = BlockedBy(relay.RelayId);
                            }
                            @if (State.HasAnswered)
                            {
                                <button type="button"
                                        class="member-toggle"
                                        data-vibrate
                                        aria-pressed="@(on ? "true" : "false")"
                                        aria-label="@Texts[on ? "Common.TurnOff" : "Common.TurnOn", relay.Name]"
                                        disabled="@(!State.IsConnected || _busy || OrderChanged || Missing is not null || (!on && blockedBy is not null))"
                                        @onclick="() => ToggleMemberAsync(relay.RelayId, on)">@Texts[on ? "Common.Switch.On" : "Common.Switch.Off"]</button>
                            }
                            else
                            {
                                <button type="button" class="member-toggle unknown" aria-label="@Texts["Common.NameAndState", relay.Name, StatusText.Waiting]" disabled>–</button>
                            }
                            @if (_memberError is { } error && error.RelayId == relay.RelayId)
                            {
                                <p class="error" role="alert">@error.Message</p>
                            }
                        </RelayEnd>
                    </GroupStepsEditor>
                    @if (!State.IsConnected)
                    {
                        <p class="hint">@Texts["Groups.NoContactMembers"]</p>
                    }
                    else if (!CanChangeMembers)
                    {
                        <p class="hint">@Texts["Groups.TurnOffToChange"]</p>
                    }
                    @if (AddedNotSafe is { Count: > 0 } added)
                    {
                        @* Save sets them to Off after a power cut on the board, as "Create group" does. *@
                        <p class="hint power-on-save">@Texts["Groups.PowerOn.OnSave", BoardsText.And([.. added.Select(r => r.Name)])]</p>
                    }
                </section>

                <section class="limits">
                    <h2>@Texts["Relays.Detail.Limit"]</h2>
                    <div class="choices">
                        @foreach (var limit in RelaySettingsHandler.Limits)
                        {
                            <button type="button" aria-pressed="@(_maxOnMinutes == limit ? "true" : "false")" @onclick="() => _maxOnMinutes = limit">@(limit is { } m ? Texts["Common.Hours", m / 60] : Texts["Common.Never"])</button>
                        }
                    </div>
                    <p class="hint">@Texts["Groups.LimitHint"]</p>
                </section>

                <section class="schedules">
                    <div class="section-head">
                        <h2>@Texts["Relays.Detail.Schedules"]</h2>
                        <a href="group/@Id/schedule/new">@Texts["Common.Add"]</a>
                    </div>
                    @if (_schedules.Count == 0)
                    {
                        <p class="hint">@Texts["Groups.NoSchedules"]</p>
                    }
                    @foreach (var schedule in _schedules)
                    {
                        <div class="schedule" @key="schedule.Id">
                            <a href="schedule/@schedule.Id" class="schedule-text">
                                <span class="schedule-days">@ScheduleText.ShortDays(schedule.Days)</span>
                                <span class="schedule-times">@ScheduleText.Times(schedule.OnTime, schedule.OffTime)</span>
                            </a>
                            <button type="button"
                                    class="schedule-toggle"
                                    aria-pressed="@(schedule.IsEnabled ? "true" : "false")"
                                    aria-label="@($"{ScheduleText.ShortDays(schedule.Days)} {ScheduleText.Times(schedule.OnTime, schedule.OffTime)}")"
                                    disabled="@_busy"
                                    @onclick="() => SetEnabledAsync(schedule)">@Texts[schedule.IsEnabled ? "Common.Schedule.Active" : "Common.Schedule.Paused"]</button>
                        </div>
                    }
                </section>

                <section class="events">
                    <div class="section-head">
                        <h2>@Texts["Common.Screen.Events"]</h2>
                        <a href="events">@Texts["Common.AllEvents"]</a>
                    </div>
                    @if (_events.Count == 0)
                    {
                        <p class="hint">@Texts["Groups.NoEvents"]</p>
                    }
                    else
                    {
                        <div class="list">
                            @foreach (var row in _events)
                            {
                                <div class="row @(row.View.IsAlert ? "alert" : null)" @key="row.Id">
                                    <span class="time">@row.TimestampLocal.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</span>
                                    <span class="badge @(row.View.IsPerson ? "person" : "automatic")" aria-hidden="true">@row.View.Badge</span>
                                    <div class="text">
                                        <EventWhat Row="row" />
                                        <span class="day">@Events.DayLabel(row.TimestampLocal)</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>

                <section class="safety">
                    <p>@Texts["Groups.Safety"]</p>
                    @if (Board is not null && PowerOnAbility is null)
                    {
                        <p class="power-on-unknown">@Texts["Groups.PowerOn.CantTell"]</p>
                    }
                    else if (AnyUnknown)
                    {
                        <p class="power-on-unknown">@Texts["Groups.PowerOn.Unknown"]</p>
                    }
                </section>

                @if (CanChangeMembers)
                {
                    <button type="button" class="delete" disabled="@_busy" @onclick="() => _confirmDelete = true">@Texts["Groups.Delete"]</button>
                }
            </main>

            <div class="save">
                @if (_changedElsewhere)
                {
                    <p class="warning" role="status">@Texts["Groups.ChangedElsewhere"]</p>
                }
                @if (_saveError is not null)
                {
                    <p class="error" role="alert">@_saveError</p>
                }
                <button type="submit" disabled="@_busy">@Texts["Common.Save"]</button>
            </div>
        </form>

        @if (_confirmDelete)
        {
            <div class="backdrop">
                <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title">
                    <h2 id="confirm-title">@Texts["Groups.Delete.Title"]</h2>
                    <p>@Texts["Groups.Delete.Text"]</p>
                    <div class="dialog-buttons">
                        <button type="button" class="cancel" @onclick="() => _confirmDelete = false">@Texts["Common.Cancel"]</button>
                        <button type="button" class="confirm" disabled="@_busy" @onclick="DeleteAsync">@Texts["Common.Delete"]</button>
                    </div>
                </div>
            </div>
        }
    }
</div>

<TabBar Current="TabBar.Tab.Relays" SideMenuOnly="true" />

@code {
    // The group's own board: its state and relays. Unknown (never answered, no relays) until the group is loaded.
    private int? BoardId => _group?.BoardId;

    private LiveBoard? Board => BoardId is { } id ? Registry.Find(id) : null;

    private BoardCapabilities Capabilities => Board?.Capabilities ?? LiveBoard.NoBoard;

    private const int EventCount = 4;

    private GroupView? _group;
    private GroupEditor _editor = new([]);
    private IReadOnlyList<Relay> _free = [];
    private Dictionary<string, string> _names = [];
    private List<EventRow> _events = [];
    private List<ScheduleModel> _schedules = [];
    private RelayOutlook? _outlook;
    private SignedInUser? _user;
    private bool _loaded;
    private bool _busy;
    private string SomethingWentWrong => Texts["Common.SomethingWrongTryAgain"];

    private ITimer? _tick;
    private bool _changedElsewhere;
    private string? _toggleError;
    private bool _confirmDelete;
    private string? _saveError;
    private (int RelayId, string Message)? _memberError;
    private string _name = "";
    private string _icon = GroupIcons.Fan;
    private int? _maxOnMinutes;

    [Parameter]
    public int Id { get; set; }

    private BoardState State => Board?.State ?? BoardState.Initial;

    // The group's relays the board controls by itself now: the group doesn't start while there are any.
    private IReadOnlyList<GroupMemberView> Unavailable => _group is null ? [] : [.. _group.Members.Where(m => State.Unavailable.Contains(m.Channel))];

    // "Reset" that went wrong.
    private string? _resetError;

    // What the board can do about its relays' state after a power cut; null when it can't tell.
    private PowerOnAbility? PowerOnAbility => Board?.Capabilities.PowerOn;

    // The group's relays (as saved) whose board turns them on by itself after a power cut (GroupPowerOn).
    private IReadOnlyList<GroupMemberView> NotSafe
    {
        get
        {
            if (_group is null)
            {
                return [];
            }

            var channels = GroupPowerOn.NotSafe(PowerOnAbility, State.PowerOn, _group.Members.Select(m => m.Channel));
            return [.. _group.Members.Where(m => channels.Contains(m.Channel))];
        }
    }

    // The relays added in the form, not saved yet, that Save sets to Off after a power cut on the board: another state
    // than Off, or unknown (GroupPowerOn.ToSetOnSave).
    private IReadOnlyList<EditRelay> AddedNotSafe
    {
        get
        {
            if (_group is null)
            {
                return [];
            }

            var added = _editor.Relays.Where(r => _group.Members.All(m => m.RelayId != r.RelayId)).ToList();
            var channels = GroupPowerOn.ToSetOnSave(PowerOnAbility, State.PowerOn, added.Select(r => r.Channel));
            return [.. added.Where(r => channels.Contains(r.Channel))];
        }
    }

    // Whether the board, which has the ability, hasn't reported the state of any of the group's relays (as saved).
    private bool AnyUnknown => _group is not null && GroupPowerOn.Unknown(PowerOnAbility, State.PowerOn, _group.Members.Select(m => m.Channel)).Count > 0;

    private (ChannelMask NotSafe, ChannelMask Added, bool Unknown) ShownPowerOn =>
        (ChannelMask.Of(NotSafe.Select(m => m.Channel)), ChannelMask.Of(AddedNotSafe.Select(r => r.Channel)), AnyUnknown);

    private (ChannelMask NotSafe, ChannelMask Added, bool Unknown) _shownPowerOn;

    // "Make it safe" or a save's write that went wrong.
    private string? _powerOnError;

    private bool _disposed;

    private bool GroupOn => _group is not null && _group.IsOn(State);

    private int? Missing => _group?.MissingRelay(Capabilities.RelayCount);

    // Which relays, their steps and their order only change while the whole group is off and still.
    private bool CanChangeMembers => _group is not null
        && _group.Runtime.Phase == GroupPhases.Idle
        && State.IsConnected
        && !State.Relays.Overlaps(ChannelMask.Of(_group.Members.Select(m => m.Channel).Concat(_editor.Relays.Select(r => r.Channel))));

    // One relay at a time follows the saved steps; after a change to them, save first.
    private bool OrderChanged => _group is not null && !_editor.HasSameRelays(_group.Steps);

    // Free relays, and the group's own that were taken out in the form and not saved yet.
    private IEnumerable<EditRelay> AddableRelays => _free
        .Select(r => new EditRelay(r.Id, r.Channel, r.Name))
        .Concat(_editor.Removed)
        .Where(r => !_editor.Contains(r.RelayId) && !State.IsOn(r.Channel))
        .OrderBy(r => r.Channel);

    private bool CanAdd => CanChangeMembers && _editor.RelayCount < Capabilities.RelayCount && AddableRelays.Any();

    protected override async Task OnParametersSetAsync()
    {
        _user = await CurrentUser.GetAsync();
        _toggleError = null;
        _memberError = null;
        _saveError = null;
        _powerOnError = null;
        _confirmDelete = false;
        _changedElsewhere = false;
        _group = await Groups.GetAsync(Id, CancellationToken.None);
        if (_group is not null)
        {
            _name = _group.Name;
            _icon = _group.Icon;
            _maxOnMinutes = _group.MaxOnMinutes;
            SeedMembers(_group);
            await LoadLiveAsync();
        }

        _loaded = true;
    }

    protected override void OnInitialized()
    {
        Registry.StateChanged += OnBoardChanged;
        Registry.OwnRulesChanged += OnBoardChanged;
        Registry.PowerOnChanged += OnPowerOnChanged;
        Changes.Changed += OnRelaysChanged;

        // A start or stop counts down in seconds; nothing else re-renders the page that often.
        _tick = Time.CreateTimer(_ =>
        {
            if (_group is { } group && group.Runtime.Phase != GroupPhases.Idle)
            {
                _ = RefreshAsync(reload: false);
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    public void Dispose()
    {
        _disposed = true;
        Registry.StateChanged -= OnBoardChanged;
        Registry.OwnRulesChanged -= OnBoardChanged;
        Registry.PowerOnChanged -= OnPowerOnChanged;
        Changes.Changed -= OnRelaysChanged;
        _tick?.Dispose();
    }

    // A new editor also closes an open relay list (GroupStepsEditor).
    private void SeedMembers(GroupView group)
    {
        _editor = new GroupEditor(group.Steps);
    }

    // What others can change while the page is open; the form fields keep what the user typed.
    private async Task LoadLiveAsync()
    {
        var before = _group;
        var edited = before is not null && !_editor.IsSameAs(before.Steps);
        _group = await Groups.GetAsync(Id, CancellationToken.None) ?? _group;

        // Someone else changed the steps: follow them, unless this form has changes of its own to them.
        if (before is not null && _group is not null && !new GroupEditor(before.Steps).IsSameAs(_group.Steps))
        {
            if (edited)
            {
                _changedElsewhere = true;
                _editor.FollowSaved(_group.Steps);
            }
            else
            {
                SeedMembers(_group);
            }
        }

        // Only the group's own board's: a group's relays are all on one board.
        _free = [.. (await Groups.FreeRelaysAsync(_group?.BoardId, CancellationToken.None))];
        await using var db = await DbFactory.CreateDbContextAsync();
        _names = await ActorNames.LoadAsync(db, CancellationToken.None);
        _events = [.. await Events.GetAsync(EventFilter.All, beforeId: null, EventCount, CancellationToken.None, groupId: Id)];
        _schedules = [.. await Schedules.ListForGroupAsync(Id, CancellationToken.None)];
        _outlook = (await Outlook.GetGroupsAsync(CancellationToken.None)).GetValueOrDefault(Id);
    }

    // The name of the step above that must be all on first for this relay, or null. Only for the steps as saved: after
    // a change to them, save first.
    private string? BlockedBy(int relayId)
    {
        if (OrderChanged || _group is null)
        {
            return null;
        }

        var position = _group.Members.Select(m => m.RelayId).ToList().IndexOf(relayId) + 1;
        return position > 0 ? GroupPlanner.NeedsOn(_group.Steps, State, position) : null;
    }

    // The step's state in words; after a change to the steps, only on or off.
    private string StepNote(int index)
    {
        if (!OrderChanged)
        {
            return GroupStatus.StepNote(_group!, State, index, Clock.UtcNow);
        }

        return _editor.Steps[index].Relays.All(r => State.IsOn(r.Channel)) ? Texts["Groups.Member.On"] : Texts["Groups.Member.Off"];
    }

    // A step lights up while all its relays are on; before the board's first answer every step is grey.
    private string StepClass(int index)
    {
        var step = _editor.Steps[index];
        var on = State.HasAnswered && step.Relays.All(r => State.IsOn(r.Channel));
        return $"{(on ? "on" : "")} {(State.HasAnswered ? "" : "unknown")}";
    }

    private void Move((int Step, int By) move)
    {
        _editor.Move(move.Step, move.By);
    }

    private void Remove(int relayId)
    {
        _editor.Remove(relayId);
    }

    private void JoinStepAbove(int relayId)
    {
        _editor.JoinStepAbove(relayId);
    }

    private void AddRelay((int Step, EditRelay Relay) add)
    {
        // Only a relay the list offers right now: one taken by another group since isn't added.
        if (!CanAdd || AddableRelays.All(r => r.RelayId != add.Relay.RelayId))
        {
            return;
        }

        if (add.Step == GroupEditor.NewStep)
        {
            _editor.AddStep(add.Relay);
        }
        else
        {
            _editor.AddToStep(add.Step, add.Relay);
        }
    }

    private string? NameOf(string? email)
    {
        if (email is null)
        {
            return null;
        }

        if (email == _user?.Email)
        {
            return Texts["Relays.By.You"];
        }

        return email switch
        {
            EventActors.Schedule => Texts["Relays.By.Schedule"],
            EventActors.AutoOff => Texts["Relays.By.AutoOff"],
            EventActors.External => Texts["Relays.By.Outside"],
            _ when _names.TryGetValue(email, out var name) => name,

            // An input that is no longer in the app (a removed board's) has no name, and isn't an e-mail.
            _ when EventActors.TryInput(email, out _) => Texts["Relays.By.RemovedInput"],
            _ => IdentityRules.DisplayNameFor(email),
        };
    }

    private async Task ToggleGroupAsync()
    {
        if (_user is null || _busy || _group is null)
        {
            return;
        }

        _busy = true;
        _toggleError = null;
        try
        {
            if (GroupOn)
            {
                await Sequencer.StopGroupAsync(Id, _user.Email, CancellationToken.None);
            }
            else
            {
                await Sequencer.StartGroupAsync(Id, _user.Email, CancellationToken.None);
            }
        }
        catch (BoardClosedException)
        {
            _toggleError = Texts["Boards.BeingRemoved"];
        }
        catch (BoardNotConnectedException)
        {
            _toggleError = Texts["Common.BoardNotResponding"];
        }
        catch (GroupUnavailableException)
        {
            // The warning at the top says which relay, with "Reset".
            _toggleError = null;
        }
        catch (Exception ex)
        {
            // An exception that leaves the handler would end the page's live connection.
            Log.LogError(ex, "Starting or stopping group {GroupId} failed", Id);
            _toggleError = SomethingWentWrong;
        }
        finally
        {
            _busy = false;
        }
    }

    // "Reset": sets the group's relays the board controls by itself back to normal, as the person pressed, and logs it.
    // Nothing is queued without a connection.
    private async Task ResetAsync()
    {
        if (_user is null || _busy || _group is null || Unavailable is not { Count: > 0 } unavailable)
        {
            return;
        }

        _busy = true;
        _resetError = null;
        try
        {
            _resetError = await OwnRules.TurnOffAsync(_group.BoardId, [.. unavailable.Select(m => new OwnRule(m.Channel, OwnRuleKind.InputLinkage))], _user.Email, CancellationToken.None);
        }
        catch (Exception ex)
        {
            // An exception that leaves the handler would end the page's live connection.
            Log.LogError(ex, "Resetting the relays of group {GroupId} failed", Id);
            _resetError = SomethingWentWrong;
        }
        finally
        {
            _busy = false;
        }
    }

    // "Make it safe": sets the group's relays the board turns on by itself after a power cut to Off on the board, as the
    // person pressed, and logs it. Nothing is sent or queued without a connection.
    private async Task MakeSafeAsync()
    {
        if (_user is null || _busy || _group is null || NotSafe.Count == 0)
        {
            return;
        }

        _busy = true;
        _powerOnError = null;
        try
        {
            _powerOnError = await PowerOn.MakeGroupSafeAsync(Id, _user.Email, relayIds: null, onSave: false, CancellationToken.None);
        }
        catch (Exception ex)
        {
            // An exception that leaves the handler would end the page's live connection.
            Log.LogError(ex, "Making the state after a power cut of group {GroupId} safe failed", Id);
            _powerOnError = SomethingWentWrong;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleMemberAsync(int relayId, bool isOn)
    {
        if (_user is null || _busy)
        {
            return;
        }

        _busy = true;
        _memberError = null;
        try
        {
            if (await Sequencer.SetMemberAsync(Id, relayId, !isOn, _user.Email, CancellationToken.None) is { } refusal)
            {
                _memberError = (relayId, refusal);
            }
        }
        catch (BoardClosedException)
        {
            _memberError = (relayId, Texts["Boards.BeingRemoved"]);
        }
        catch (BoardNotConnectedException)
        {
            _memberError = (relayId, Texts["Common.BoardNotResponding"]);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Switching relay {RelayId} of group {GroupId} failed", relayId, Id);
            _memberError = (relayId, SomethingWentWrong);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetEnabledAsync(ScheduleModel schedule)
    {
        if (_user is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await Schedules.SetEnabledAsync(schedule.Id, !schedule.IsEnabled, _user.Email, CancellationToken.None);
            await LoadLiveAsync();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Pausing or resuming schedule {ScheduleId} failed", schedule.Id);
            _saveError = SomethingWentWrong;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_user is null || _group is null || _busy)
        {
            return;
        }

        _busy = true;
        _powerOnError = null;
        var saved = false;
        List<int> added = [.. _editor.Relays.Select(r => r.RelayId).Where(id => _group.Members.All(m => m.RelayId != id))];
        try
        {
            var draft = new GroupDraft(_name, _icon, _maxOnMinutes, _editor.Drafts);
            _saveError = await Groups.SaveAsync(Id, draft, _user.Email, CancellationToken.None);
            saved = _saveError is null;
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Saving group {GroupId} failed", Id);
            _saveError = SomethingWentWrong;
        }

        try
        {
            // The relays the save added: Off after a power cut on the board, as the page said. The group is saved
            // whatever the board does.
            if (saved && added.Count > 0 && await MakeAddedSafeAsync(added) is { } error)
            {
                // The page stays open: the group as saved, with the warning and "Make it safe" at the top.
                _powerOnError = error;
                _saveError = Texts["Groups.PowerOn.NotSetSaved"];
                await ReloadAfterSaveAsync();
            }
        }
        finally
        {
            _busy = false;
        }

        if (_saveError is null)
        {
            Navigation.NavigateTo("");
        }
    }

    // The group as this page just saved it, so the warning names its new relays at once. The steps follow the saved ones
    // first: they are this page's own change, not someone else's, so "Someone else changed the group" isn't said, also
    // when the save's notification already reloaded the page meanwhile. A failure here only leaves the page as it was:
    // the next change reloads it.
    private async Task ReloadAfterSaveAsync()
    {
        try
        {
            if (await Groups.GetAsync(Id, CancellationToken.None) is { } saved)
            {
                _group = saved;
                SeedMembers(saved);
            }

            _changedElsewhere = false;
            await LoadLiveAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Log.LogWarning(ex, "The page could not reload {What}", "the group");
        }
    }

    // Null when the board took it or there was nothing to set, otherwise the message for the warning.
    private async Task<string?> MakeAddedSafeAsync(IReadOnlyCollection<int> added)
    {
        try
        {
            return await PowerOn.MakeGroupSafeAsync(Id, _user!.Email, added, onSave: true, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Setting the state after a power cut of group {GroupId}'s new relays failed", Id);
            return SomethingWentWrong;
        }
    }

    private async Task DeleteAsync()
    {
        if (_user is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            _saveError = await Groups.DeleteAsync(Id, _user.Email, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Deleting group {GroupId} failed", Id);
            _saveError = SomethingWentWrong;
        }
        finally
        {
            _busy = false;
            _confirmDelete = false;
        }

        if (_saveError is null)
        {
            Navigation.NavigateTo("");
        }
    }

    // Any board's new state: only the page's own board's is redrawn.
    private void OnBoardChanged(object? sender, BoardStateChange change)
    {
        if (change.BoardId != BoardId)
        {
            return;
        }

        _ = RefreshAsync(reload: false);
    }

    // Only the relays' states after a power cut changed, on any board: a redraw only when the warning or the note on
    // saving would show other relays.
    private void OnPowerOnChanged(object? sender, BoardStateChange change)
    {
        if (change.BoardId != BoardId)
        {
            return;
        }

        _ = RedrawForPowerOnAsync();
    }

    private async Task RedrawForPowerOnAsync()
    {
        using var language = Language.Use();
        try
        {
            await InvokeAsync(() =>
            {
                // On the page's own thread, as Dispose is: a closed page draws nothing.
                if (!_disposed && ShownPowerOn != _shownPowerOn)
                {
                    StateHasChanged();
                }
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the change was on its way.
        }
    }

    private void OnRelaysChanged(object? sender, EventArgs e)
    {
        _ = RefreshAsync(reload: true);
    }

    private async Task RefreshAsync(bool reload)
    {
        using var language = Language.Use();
        try
        {
            await InvokeAsync(async () =>
            {
                if (reload && _group is not null)
                {
                    await LoadLiveAsync();
                }

                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the update was on its way.
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Not shown to the person: the page keeps what it shows, and the next refresh tries again.
            Log.LogWarning(ex, "The page could not reload {What}", "the group");
        }
    }
}
