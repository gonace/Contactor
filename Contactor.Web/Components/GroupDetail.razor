@page "/group/{Id:int}"
@implements IDisposable
@using Contactor.Boards
@using Microsoft.EntityFrameworkCore
@using Contactor.Web.Features.Events
@using Contactor.Web.Features.Groups
@using Contactor.Web.Features.Identity
@using Contactor.Web.Features.Relays
@using Contactor.Web.Features.Schedules
@using Contactor.Web.Persistence
@inject IRelayBoard Board
@inject GroupsHandler Groups
@inject GroupSequencer Sequencer
@inject EventsHandler Events
@inject SchedulesHandler Schedules
@inject ScheduleOutlook Outlook
@inject RelayChanges Changes
@inject CurrentUser CurrentUser
@inject LocalClock Clock
@inject TimeProvider Time
@inject NavigationManager Navigation
@inject IDbContextFactory<ContactorDbContext> DbFactory
@inject ILogger<GroupDetail> Log

<PageTitle>@(_group?.Name ?? "Group") · Contactor</PageTitle>

<div class="screen">
    <header class="header">
        <a href="" class="back">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
            Relays
        </a>
        @if (_group is not null)
        {
            @* On a desktop Save sits here, pinned to the top; on a phone and a tablet it is at the bottom of the form. *@
            <button type="submit" form="group-form" class="save-top" disabled="@_busy">Save</button>
        }
    </header>

    @if (_loaded && _group is null)
    {
        <main class="content">
            <p class="missing">The group doesn't exist.</p>
        </main>
    }
    else if (_group is not null)
    {
        <form id="group-form" class="form" @onsubmit="SaveAsync">
            <main class="content">
                <div class="field">
                    <label for="name" class="label">GROUP · NAME</label>
                    <input id="name" type="text" maxlength="@RelayGroup.NameMaxLength" @bind="_name" @bind:event="oninput" autocomplete="off" />
                </div>

                <fieldset class="icon-field">
                    <legend>Icon</legend>
                    <IconPicker @bind-Value="_icon" />
                </fieldset>

                @if (!State.HasAnswered)
                {
                    @* Before the board's first answer: unknown, all grey. *@
                    <section class="status unknown">
                        <p>@RelayStatusText.Waiting</p>
                        <button type="button" class="toggle unknown" aria-label="@RelayStatusText.Waiting" disabled>–</button>
                    </section>
                }
                else
                {
                <section class="status @(GroupOn ? "on" : "") @(_group.Runtime.Phase == GroupPhases.Stopping ? "stopping" : "")">
                    <p>@(Missing is { } missing ? GroupView.MissingRelayText(missing) : GroupStatusText.For(_group, State, Clock.UtcNow, Clock.ToLocal, NameOf, _outlook))</p>
                    <button type="button" class="toggle" data-vibrate aria-pressed="@(GroupOn ? "true" : "false")" disabled="@(!State.IsConnected || _busy || Missing is not null)" @onclick="ToggleGroupAsync">
                        @(GroupOn ? "TURN OFF THE GROUP" : "TURN ON THE GROUP")
                    </button>
                    @if (_toggleError is not null)
                    {
                        <p class="error" role="alert">@_toggleError</p>
                    }
                </section>
                }

                <section class="members">
                    <div class="section-text">
                        <h2>Relays in start order</h2>
                        <p class="hint">Starts from the top, stops from the bottom. A relay can only be on while the relay above it is on.</p>
                    </div>
                    <ol class="steps">
                        @for (var i = 0; i < _members.Count; i++)
                        {
                            var index = i;
                            var member = _members[index];
                            var on = State.IsOn(member.RelayId);
                            var blockedBy = BlockedBy(index);
                            <li class="step @(on ? "on" : "") @(State.HasAnswered ? "" : "unknown")" @key="member.RelayId">
                                <div class="step-row">
                                    <span class="number" aria-hidden="true">@(index + 1)</span>
                                    <div class="step-text">
                                        <label class="label" for="@($"role-{member.RelayId}")">RELAY @member.RelayId</label>
                                        <input id="@($"role-{member.RelayId}")" class="role" type="text" maxlength="@RelayGroupMember.RoleNameMaxLength" @bind="member.RoleName" @bind:event="oninput" autocomplete="off" />
                                        <span class="note">@(State.HasAnswered ? NoteFor(index, on, blockedBy) : RelayStatusText.Waiting)</span>
                                    </div>
                                    <div class="order">
                                        <button type="button" aria-label="@($"Move {member.RoleName} up")" disabled="@(!CanChangeMembers || index == 0)" @onclick="() => Move(index, -1)">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6"></path></svg>
                                        </button>
                                        <button type="button" aria-label="@($"Move {member.RoleName} down")" disabled="@(!CanChangeMembers || index == _members.Count - 1)" @onclick="() => Move(index, 1)">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                                        </button>
                                    </div>
                                    @if (State.HasAnswered)
                                    {
                                        <button type="button"
                                                class="member-toggle"
                                                data-vibrate
                                                aria-pressed="@(on ? "true" : "false")"
                                                aria-label="@((on ? "Turn off " : "Turn on ") + member.RoleName)"
                                                disabled="@(!State.IsConnected || _busy || OrderChanged || Missing is not null || (!on && blockedBy is not null))"
                                                @onclick="() => ToggleMemberAsync(member.RelayId, on)">@(on ? "ON" : "OFF")</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="member-toggle unknown" aria-label="@($"{member.RoleName}: {RelayStatusText.Waiting}")" disabled>–</button>
                                    }
                                </div>
                                @if (CanChangeMembers && _members.Count > RelayGroup.MinMembers)
                                {
                                    <button type="button" class="remove" @onclick="() => Remove(index)">Remove from the group</button>
                                }
                                @if (_memberError is { } error && error.RelayId == member.RelayId)
                                {
                                    <p class="error" role="alert">@error.Message</p>
                                }
                            </li>
                            @if (index < _members.Count - 1)
                            {
                                var below = _members[index + 1];
                                <li class="gap" aria-label="@($"Between {member.RoleName} and {below.RoleName}")">
                                    <label>
                                        On start, wait
                                        <select @bind="below.StartDelaySec">
                                            @foreach (var seconds in Choices(GroupsHandler.StartDelayChoices, below.StartDelaySec))
                                            {
                                                <option value="@seconds">@EventText.Seconds(seconds)</option>
                                            }
                                        </select>
                                    </label>
                                    <label>
                                        On stop, run on
                                        <select @bind="member.RunOnSec">
                                            @foreach (var seconds in Choices(GroupsHandler.RunOnChoices, member.RunOnSec))
                                            {
                                                <option value="@seconds">@(seconds == 0 ? "None" : EventText.Seconds(seconds))</option>
                                            }
                                        </select>
                                    </label>
                                </li>
                            }
                        }
                    </ol>
                    @if (!State.IsConnected)
                    {
                        <p class="hint">No contact with the relay board. The relays and their order can be changed once the board responds.</p>
                    }
                    else if (!CanChangeMembers)
                    {
                        <p class="hint">Turn the group off to change its relays or their order.</p>
                    }
                    else if (_members.Count < Board.Capabilities.RelayCount && AddableRelays.Any())
                    {
                        <div class="add">
                            <label for="add-relay" class="visually-hidden">Relay to add</label>
                            <select id="add-relay" @bind="_addRelayId">
                                @foreach (var relay in AddableRelays)
                                {
                                    <option value="@relay.Id">Relay @relay.Id · @relay.Name</option>
                                }
                            </select>
                            <button type="button" @onclick="AddRelay">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
                                Add relay
                            </button>
                        </div>
                    }
                </section>

                <section class="limits">
                    <h2>Turn off automatically after</h2>
                    <div class="choices">
                        @foreach (var limit in RelaySettingsHandler.Limits)
                        {
                            <button type="button" aria-pressed="@(_maxOnMinutes == limit ? "true" : "false")" @onclick="() => _maxOnMinutes = limit">@(limit is { } m ? $"{m / 60} h" : "Never")</button>
                        }
                    </div>
                    <p class="hint">Applies when someone turns the group on by hand. It stops in its stop order, with its run-on times.</p>
                </section>

                <section class="schedules">
                    <div class="section-head">
                        <h2>Schedules</h2>
                        <a href="group/@Id/schedule/new">Add</a>
                    </div>
                    @if (_schedules.Count == 0)
                    {
                        <p class="hint">No schedules. Add one to turn the group on at set times.</p>
                    }
                    @foreach (var schedule in _schedules)
                    {
                        <div class="schedule" @key="schedule.Id">
                            <a href="schedule/@schedule.Id" class="schedule-text">
                                <span class="schedule-days">@ScheduleText.ShortDays(schedule.Days)</span>
                                <span class="schedule-times">@ScheduleText.Times(schedule.OnTime, schedule.OffTime)</span>
                            </a>
                            <button type="button"
                                    class="schedule-toggle"
                                    aria-pressed="@(schedule.IsEnabled ? "true" : "false")"
                                    aria-label="@($"{ScheduleText.ShortDays(schedule.Days)} {ScheduleText.Times(schedule.OnTime, schedule.OffTime)}")"
                                    disabled="@_busy"
                                    @onclick="() => SetEnabledAsync(schedule)">@(schedule.IsEnabled ? "Active" : "Paused")</button>
                        </div>
                    }
                </section>

                <section class="events">
                    <div class="section-head">
                        <h2>Events</h2>
                        <a href="events">All events</a>
                    </div>
                    @if (_events.Count == 0)
                    {
                        <p class="hint">Nothing has happened to this group yet.</p>
                    }
                    else
                    {
                        <div class="list">
                            @foreach (var row in _events)
                            {
                                <div class="row @(row.View.IsAlert ? "alert" : null)" @key="row.Id">
                                    <span class="time">@row.TimestampLocal.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</span>
                                    <span class="badge @(row.View.IsPerson ? "person" : "automatic")" aria-hidden="true">@row.View.Badge</span>
                                    <div class="text">
                                        <EventWhat Row="row" />
                                        <span class="day">@Events.DayLabel(row.TimestampLocal)</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>

                <section class="safety">
                    <p>The app's interlock only works while the app runs. Where safety depends on it, e.g. heat without the fan, it must also be wired in the installation.</p>
                </section>

                @if (CanChangeMembers)
                {
                    <button type="button" class="delete" disabled="@_busy" @onclick="() => _confirmDelete = true">Delete the group</button>
                }
            </main>

            <div class="save">
                @if (_changedElsewhere)
                {
                    <p class="warning" role="status">Someone else changed the group while you had this page open. Saving overwrites their change.</p>
                }
                @if (_saveError is not null)
                {
                    <p class="error" role="alert">@_saveError</p>
                }
                <button type="submit" disabled="@_busy">Save</button>
            </div>
        </form>

        @if (_confirmDelete)
        {
            <div class="backdrop">
                <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title">
                    <h2 id="confirm-title">Delete the group?</h2>
                    <p>Its relays become ordinary relays again, switched one by one. The group's schedules are deleted too.</p>
                    <div class="dialog-buttons">
                        <button type="button" class="cancel" @onclick="() => _confirmDelete = false">Cancel</button>
                        <button type="button" class="confirm" disabled="@_busy" @onclick="DeleteAsync">Delete</button>
                    </div>
                </div>
            </div>
        }
    }
</div>

<TabBar Current="TabBar.Tab.Relays" SideMenuOnly="true" />

@code {
    private const int EventCount = 4;

    private GroupView? _group;
    private List<EditMember> _members = [];
    private IReadOnlyList<Relay> _free = [];
    private Dictionary<string, string> _names = [];
    private List<EventRow> _events = [];
    private List<ScheduleModel> _schedules = [];
    private RelayOutlook? _outlook;
    private SignedInUser? _user;
    private bool _loaded;
    private bool _busy;
    private const string SomethingWentWrong = "Something went wrong. Try again.";

    private List<EditMember> _removed = [];
    private ITimer? _tick;
    private bool _changedElsewhere;
    private string? _toggleError;
    private bool _confirmDelete;
    private string? _saveError;
    private (int RelayId, string Message)? _memberError;
    private string _name = "";
    private string _icon = GroupIcons.Fan;
    private int? _maxOnMinutes;
    private int _addRelayId;

    [Parameter]
    public int Id { get; set; }

    private BoardState State => Board.State;

    private bool GroupOn => _group is not null && _group.IsOn(State);

    private int? Missing => _group?.MissingRelay(Board.Capabilities.RelayCount);

    // Which relays and their order only change while the whole group is off and still.
    private bool CanChangeMembers => _group is not null
        && _group.Runtime.Phase == GroupPhases.Idle
        && State.IsConnected
        && !State.Relays.Overlaps(ChannelMask.Of(_group.Members.Select(m => m.RelayId).Concat(_members.Select(m => m.RelayId))));

    // One relay at a time follows the saved order; after a change, save first.
    private bool OrderChanged => _group is not null && !_group.Members.Select(m => m.RelayId).SequenceEqual(_members.Select(m => m.RelayId));

    // Free relays, and the group's own that were taken out in the form and not saved yet.
    private IEnumerable<(int Id, string Name)> AddableRelays => _free
        .Select(r => (r.Id, r.Name))
        .Concat(_removed.Select(m => (m.RelayId, m.RoleName)))
        .Where(r => _members.All(m => m.RelayId != r.Item1) && !State.IsOn(r.Item1))
        .OrderBy(r => r.Item1);

    protected override async Task OnParametersSetAsync()
    {
        _user = await CurrentUser.GetAsync();
        _toggleError = null;
        _memberError = null;
        _saveError = null;
        _confirmDelete = false;
        _changedElsewhere = false;
        _group = await Groups.GetAsync(Id, CancellationToken.None);
        if (_group is not null)
        {
            _name = _group.Name;
            _icon = _group.Icon;
            _maxOnMinutes = _group.MaxOnMinutes;
            SeedMembers(_group);
            await LoadLiveAsync();
        }

        _loaded = true;
    }

    protected override void OnInitialized()
    {
        Board.StateChanged += OnBoardChanged;
        Changes.Changed += OnRelaysChanged;

        // A start or stop counts down in seconds; nothing else re-renders the page that often.
        _tick = Time.CreateTimer(_ =>
        {
            if (_group is { } group && group.Runtime.Phase != GroupPhases.Idle)
            {
                _ = RefreshAsync(reload: false);
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    public void Dispose()
    {
        Board.StateChanged -= OnBoardChanged;
        Changes.Changed -= OnRelaysChanged;
        _tick?.Dispose();
    }

    private static IEnumerable<(int RelayId, string RoleName, int StartDelaySec, int RunOnSec)> Saved(GroupView group)
    {
        return group.Members.Select(m => (m.RelayId, m.RoleName, m.StartDelaySec, m.RunOnSec));
    }

    private void SeedMembers(GroupView group)
    {
        _members = [.. group.Members.Select(m => new EditMember(m.RelayId, m.RoleName, m.StartDelaySec, m.RunOnSec))];
        _removed = [];
    }

    // What others can change while the page is open; the form fields keep what the user typed.
    private async Task LoadLiveAsync()
    {
        var before = _group;
        var edited = before is not null && !Saved(before).SequenceEqual(_members.Select(m => (m.RelayId, m.RoleName, m.StartDelaySec, m.RunOnSec)));
        _group = await Groups.GetAsync(Id, CancellationToken.None) ?? _group;

        // Someone else changed the members: follow them, unless this form has changes of its own to them.
        if (before is not null && _group is not null && !Saved(before).SequenceEqual(Saved(_group)))
        {
            if (edited)
            {
                _changedElsewhere = true;
            }
            else
            {
                SeedMembers(_group);
            }
        }

        _free = [.. (await Groups.FreeRelaysAsync(CancellationToken.None))];
        await using var db = await DbFactory.CreateDbContextAsync();
        _names = await ActorNames.LoadAsync(db, CancellationToken.None);
        _events = [.. await Events.GetAsync(EventFilter.All, beforeId: null, EventCount, CancellationToken.None, groupId: Id)];
        _schedules = [.. await Schedules.ListForGroupAsync(Id, CancellationToken.None)];
        _outlook = (await Outlook.GetGroupsAsync(CancellationToken.None)).GetValueOrDefault(Id);
        if (_addRelayId == 0 || AddableRelays.All(r => r.Id != _addRelayId))
        {
            _addRelayId = AddableRelays.FirstOrDefault().Id;
        }
    }

    // The relay above that must be on first, or null.
    private EditMember? BlockedBy(int index)
    {
        return index > 0 && !State.IsOn(_members[index - 1].RelayId) ? _members[index - 1] : null;
    }

    private string NoteFor(int index, bool on, EditMember? blockedBy)
    {
        return GroupStatusText.MemberNote(_group!, State, index, on, blockedBy?.RoleName, Clock.UtcNow);
    }

    private static IEnumerable<int> Choices(IReadOnlyList<int> offered, int current)
    {
        return offered.Contains(current) ? offered : offered.Append(current).Order();
    }

    private void Move(int index, int step)
    {
        var to = index + step;
        if (to < 0 || to >= _members.Count)
        {
            return;
        }

        (_members[index], _members[to]) = (_members[to], _members[index]);
    }

    private void Remove(int index)
    {
        var member = _members[index];
        _members.RemoveAt(index);
        if (_group!.Members.Any(m => m.RelayId == member.RelayId))
        {
            _removed.Add(member);
        }

        if (_addRelayId == 0)
        {
            _addRelayId = AddableRelays.FirstOrDefault().Id;
        }
    }

    private void AddRelay()
    {
        if (!AddableRelays.Any(r => r.Id == _addRelayId))
        {
            return;
        }

        // A relay taken out of this group comes back as it was.
        var removed = _removed.FirstOrDefault(m => m.RelayId == _addRelayId);
        if (removed is not null)
        {
            _removed.Remove(removed);
            _members.Add(removed);
        }
        else
        {
            var relay = _free.First(r => r.Id == _addRelayId);
            _members.Add(new EditMember(relay.Id, relay.Name, RelayGroupMember.DefaultStartDelaySec, RelayGroupMember.DefaultRunOnSec));
        }

        _addRelayId = AddableRelays.FirstOrDefault().Id;
    }

    private string? NameOf(string? email)
    {
        if (email is null)
        {
            return null;
        }

        if (email == _user?.Email)
        {
            return "you";
        }

        return email switch
        {
            EventActors.Schedule => "schedule",
            EventActors.AutoOff => "auto-off",
            EventActors.External => "outside the app",
            _ => _names.TryGetValue(email, out var name) ? name : IdentityRules.DisplayNameFor(email),
        };
    }

    private async Task ToggleGroupAsync()
    {
        if (_user is null || _busy || _group is null)
        {
            return;
        }

        _busy = true;
        _toggleError = null;
        try
        {
            if (GroupOn)
            {
                await Sequencer.StopGroupAsync(Id, _user.Email, CancellationToken.None);
            }
            else
            {
                await Sequencer.StartGroupAsync(Id, _user.Email, CancellationToken.None);
            }
        }
        catch (BoardNotConnectedException)
        {
            _toggleError = "The board isn't responding. Try again.";
        }
        catch (Exception ex)
        {
            // An exception that leaves the handler would end the page's live connection.
            Log.LogError(ex, "Starting or stopping group {GroupId} failed", Id);
            _toggleError = SomethingWentWrong;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleMemberAsync(int relayId, bool isOn)
    {
        if (_user is null || _busy)
        {
            return;
        }

        _busy = true;
        _memberError = null;
        try
        {
            if (await Sequencer.SetMemberAsync(Id, relayId, !isOn, _user.Email, CancellationToken.None) is { } refusal)
            {
                _memberError = (relayId, refusal);
            }
        }
        catch (BoardNotConnectedException)
        {
            _memberError = (relayId, "The board isn't responding. Try again.");
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Switching relay {RelayId} of group {GroupId} failed", relayId, Id);
            _memberError = (relayId, SomethingWentWrong);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetEnabledAsync(ScheduleModel schedule)
    {
        if (_user is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await Schedules.SetEnabledAsync(schedule.Id, !schedule.IsEnabled, _user.Email, CancellationToken.None);
            await LoadLiveAsync();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Pausing or resuming schedule {ScheduleId} failed", schedule.Id);
            _saveError = SomethingWentWrong;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_user is null || _group is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var draft = new GroupDraft(
                _name,
                _icon,
                _maxOnMinutes,
                [.. _members.Select(m => new GroupMemberDraft(m.RelayId, m.RoleName, m.StartDelaySec, m.RunOnSec))]);
            _saveError = await Groups.SaveAsync(Id, draft, _user.Email, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Saving group {GroupId} failed", Id);
            _saveError = SomethingWentWrong;
        }
        finally
        {
            _busy = false;
        }

        if (_saveError is null)
        {
            Navigation.NavigateTo("");
        }
    }

    private async Task DeleteAsync()
    {
        if (_user is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            _saveError = await Groups.DeleteAsync(Id, _user.Email, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Deleting group {GroupId} failed", Id);
            _saveError = SomethingWentWrong;
        }
        finally
        {
            _busy = false;
            _confirmDelete = false;
        }

        if (_saveError is null)
        {
            Navigation.NavigateTo("");
        }
    }

    private void OnBoardChanged(object? sender, BoardState state)
    {
        _ = RefreshAsync(reload: false);
    }

    private void OnRelaysChanged(object? sender, EventArgs e)
    {
        _ = RefreshAsync(reload: true);
    }

    private async Task RefreshAsync(bool reload)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (reload && _group is not null)
                {
                    await LoadLiveAsync();
                }

                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the update was on its way.
        }
    }

    // A member as the form edits it.
    private sealed class EditMember
    {
        public EditMember(int relayId, string roleName, int startDelaySec, int runOnSec)
        {
            RelayId = relayId;
            RoleName = roleName;
            StartDelaySec = startDelaySec;
            RunOnSec = runOnSec;
        }

        public int RelayId { get; }

        public string RoleName { get; set; }

        public int StartDelaySec { get; set; }

        public int RunOnSec { get; set; }
    }
}
