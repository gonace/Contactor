@page "/group/{Id:int}"
@implements IDisposable
@using Contactor.Boards
@using Microsoft.EntityFrameworkCore
@using Contactor.Web.Features.Boards
@using Contactor.Web.Features.Events
@using Contactor.Web.Features.Groups
@using Contactor.Web.Features.Identity
@using Contactor.Web.Features.Languages
@using Contactor.Web.Features.Relays
@using Contactor.Web.Features.Schedules
@using Contactor.Web.Persistence
@inject BoardRegistry Registry
@inject GroupsHandler Groups
@inject GroupSequencer Sequencer
@inject EventsHandler Events
@inject SchedulesHandler Schedules
@inject ScheduleOutlook Outlook
@inject RelayChanges Changes
@inject CurrentUser CurrentUser
@inject LocalClock Clock
@inject TimeProvider Time
@inject NavigationManager Navigation
@inject IDbContextFactory<ContactorDbContext> DbFactory
@inject ILogger<GroupDetail> Log
@inject RelayStatusText StatusText
@inject GroupStatusText GroupStatus
@inject IStringLocalizer<GroupsTexts> Texts
@inject IStringLocalizer<RelaysTexts> RelayTexts
@inject IStringLocalizer<BoardsTexts> BoardTexts
@inject AppLanguage Language

<PageTitle>@(Common["Common.PageTitle", _group?.Name ?? Common["Common.Screen.Group"].Value])</PageTitle>

<div class="screen">
    <header class="header">
        <a href="" class="back">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
            @Common["Common.Screen.Relays"]
        </a>
        @if (_group is not null)
        {
            @* On a desktop Save sits here, pinned to the top; on a phone and a tablet it is at the bottom of the form. *@
            <button type="submit" form="group-form" class="save-top" disabled="@_busy">@Common["Common.Save"]</button>
        }
    </header>

    @if (_loaded && _group is null)
    {
        <main class="content">
            <p class="missing">@Texts["Groups.Missing"]</p>
        </main>
    }
    else if (_group is not null)
    {
        <form id="group-form" class="form" @onsubmit="SaveAsync">
            <main class="content">
                <div class="field">
                    <label for="name" class="label">@Texts["Groups.NameLabel"]</label>
                    <input id="name" type="text" maxlength="@RelayGroup.NameMaxLength" @bind="_name" @bind:event="oninput" autocomplete="off" />
                </div>

                <fieldset class="icon-field">
                    <legend>@Texts["Groups.Icon"]</legend>
                    <IconPicker @bind-Value="_icon" />
                </fieldset>

                @if (!State.HasAnswered)
                {
                    @* Before the board's first answer: unknown, all grey. *@
                    <section class="status unknown">
                        <p>@StatusText.Waiting</p>
                        <button type="button" class="toggle unknown" aria-label="@StatusText.Waiting" disabled>–</button>
                    </section>
                }
                else
                {
                <section class="status @(GroupOn ? "on" : "") @(_group.Runtime.Phase == GroupPhases.Stopping ? "stopping" : "")">
                    <p>@(Missing is { } missing ? GroupStatus.MissingRelay(missing) : GroupStatus.For(_group, State, Clock.UtcNow, Clock.ToLocal, NameOf, _outlook))</p>
                    <button type="button" class="toggle" data-vibrate aria-pressed="@(GroupOn ? "true" : "false")" disabled="@(!State.IsConnected || _busy || Missing is not null)" @onclick="ToggleGroupAsync">
                        @Texts[GroupOn ? "Groups.TurnOff" : "Groups.TurnOn"]
                    </button>
                    @if (_toggleError is not null)
                    {
                        <p class="error" role="alert">@_toggleError</p>
                    }
                </section>
                }

                <section class="members">
                    <div class="section-text">
                        <h2>@Texts["Groups.Steps"]</h2>
                        <p class="hint">@(Registry.All.Count > 1 && Registry.Find(_group.BoardId) is { } board ? Texts["Groups.Steps.HintOn", board.Name] : Texts["Groups.Steps.Hint"])</p>
                    </div>
                    <ol class="steps">
                        @for (var s = 0; s < _editor.Steps.Count; s++)
                        {
                            var stepIndex = s;
                            var step = _editor.Steps[stepIndex];
                            var stepOn = State.HasAnswered && step.Relays.All(r => State.IsOn(r.Channel));
                            <li class="step @(stepOn ? "on" : "") @(State.HasAnswered ? "" : "unknown")" @key="step">
                                <div class="step-row">
                                    <span class="number" aria-hidden="true">@(stepIndex + 1)</span>
                                    <div class="step-text">
                                        <label class="label" for="@($"step-{stepIndex}")">@Texts["Groups.Step.Label", stepIndex + 1]</label>
                                        <input id="@($"step-{stepIndex}")" class="role" type="text" maxlength="@RelayGroupStep.NameMaxLength" @bind="step.Name" @bind:event="oninput" autocomplete="off" />
                                        <span class="note">@(State.HasAnswered ? StepNote(stepIndex) : StatusText.Waiting)</span>
                                    </div>
                                    <div class="order">
                                        <button type="button" aria-label="@Texts["Groups.MoveUp", step.Label]" disabled="@(!CanChangeMembers || stepIndex == 0)" @onclick="() => Move(stepIndex, -1)">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6"></path></svg>
                                        </button>
                                        <button type="button" aria-label="@Texts["Groups.MoveDown", step.Label]" disabled="@(!CanChangeMembers || stepIndex == _editor.Steps.Count - 1)" @onclick="() => Move(stepIndex, 1)">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                                        </button>
                                    </div>
                                </div>
                                <ul class="relays">
                                    @foreach (var relay in step.Relays)
                                    {
                                        var on = State.IsOn(relay.Channel);
                                        var blockedBy = BlockedBy(relay.RelayId);
                                        <li class="relay" @key="relay.RelayId">
                                            <div class="relay-text">
                                                <span class="label">@RelayTexts["Relays.RelayLabel", relay.Channel]</span>
                                                <span class="relay-name">@relay.Name</span>
                                                @if (CanChangeMembers && _editor.RelayCount > RelayGroup.MinMembers)
                                                {
                                                    <button type="button" class="remove" aria-label="@Texts["Groups.RemoveRelay", relay.Name]" @onclick="() => Remove(relay.RelayId)">@Texts["Groups.Remove"]</button>
                                                }
                                            </div>
                                            @if (State.HasAnswered)
                                            {
                                                <button type="button"
                                                        class="member-toggle"
                                                        data-vibrate
                                                        aria-pressed="@(on ? "true" : "false")"
                                                        aria-label="@Common[on ? "Common.TurnOff" : "Common.TurnOn", relay.Name]"
                                                        disabled="@(!State.IsConnected || _busy || OrderChanged || Missing is not null || (!on && blockedBy is not null))"
                                                        @onclick="() => ToggleMemberAsync(relay.RelayId, on)">@Common[on ? "Common.Switch.On" : "Common.Switch.Off"]</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="member-toggle unknown" aria-label="@Common["Common.NameAndState", relay.Name, StatusText.Waiting]" disabled>–</button>
                                            }
                                            @if (_memberError is { } error && error.RelayId == relay.RelayId)
                                            {
                                                <p class="error" role="alert">@error.Message</p>
                                            }
                                        </li>
                                    }
                                </ul>
                                @if (CanAdd)
                                {
                                    @if (_addingTo == stepIndex)
                                    {
                                        @AddPicker(stepIndex)
                                    }
                                    else
                                    {
                                        <button type="button" class="add-button" @onclick="() => StartAdding(stepIndex)">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
                                            @Texts["Groups.AddRelayToStep"]
                                        </button>
                                    }
                                }
                            </li>
                            @if (stepIndex < _editor.Steps.Count - 1)
                            {
                                var below = _editor.Steps[stepIndex + 1];
                                <li class="gap" aria-label="@Texts["Groups.Between", step.Label, below.Label]">
                                    <label>
                                        @Texts["Groups.StartWait"]
                                        <select @bind="below.StartDelaySec">
                                            @foreach (var seconds in Choices(GroupsHandler.StartDelayChoices, below.StartDelaySec))
                                            {
                                                <option value="@seconds">@EventText.Seconds(seconds)</option>
                                            }
                                        </select>
                                    </label>
                                    <label>
                                        @Texts["Groups.RunOn"]
                                        <select @bind="step.RunOnSec">
                                            @foreach (var seconds in Choices(GroupsHandler.RunOnChoices, step.RunOnSec))
                                            {
                                                <option value="@seconds">@(seconds == 0 ? Texts["Groups.RunOn.None"] : EventText.Seconds(seconds))</option>
                                            }
                                        </select>
                                    </label>
                                </li>
                            }
                        }
                    </ol>
                    @if (!State.IsConnected)
                    {
                        <p class="hint">@Texts["Groups.NoContactMembers"]</p>
                    }
                    else if (!CanChangeMembers)
                    {
                        <p class="hint">@Texts["Groups.TurnOffToChange"]</p>
                    }
                    else if (CanAdd)
                    {
                        @if (_addingTo == NewStep)
                        {
                            @AddPicker(NewStep)
                        }
                        else
                        {
                            <button type="button" class="add-button add-step" @onclick="() => StartAdding(NewStep)">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
                                @Texts["Groups.AddStep"]
                            </button>
                        }
                    }
                </section>

                <section class="limits">
                    <h2>@RelayTexts["Relays.Detail.Limit"]</h2>
                    <div class="choices">
                        @foreach (var limit in RelaySettingsHandler.Limits)
                        {
                            <button type="button" aria-pressed="@(_maxOnMinutes == limit ? "true" : "false")" @onclick="() => _maxOnMinutes = limit">@(limit is { } m ? Common["Common.Hours", m / 60] : Common["Common.Never"])</button>
                        }
                    </div>
                    <p class="hint">@Texts["Groups.LimitHint"]</p>
                </section>

                <section class="schedules">
                    <div class="section-head">
                        <h2>@RelayTexts["Relays.Detail.Schedules"]</h2>
                        <a href="group/@Id/schedule/new">@Common["Common.Add"]</a>
                    </div>
                    @if (_schedules.Count == 0)
                    {
                        <p class="hint">@Texts["Groups.NoSchedules"]</p>
                    }
                    @foreach (var schedule in _schedules)
                    {
                        <div class="schedule" @key="schedule.Id">
                            <a href="schedule/@schedule.Id" class="schedule-text">
                                <span class="schedule-days">@ScheduleText.ShortDays(schedule.Days)</span>
                                <span class="schedule-times">@ScheduleText.Times(schedule.OnTime, schedule.OffTime)</span>
                            </a>
                            <button type="button"
                                    class="schedule-toggle"
                                    aria-pressed="@(schedule.IsEnabled ? "true" : "false")"
                                    aria-label="@($"{ScheduleText.ShortDays(schedule.Days)} {ScheduleText.Times(schedule.OnTime, schedule.OffTime)}")"
                                    disabled="@_busy"
                                    @onclick="() => SetEnabledAsync(schedule)">@Common[schedule.IsEnabled ? "Common.Schedule.Active" : "Common.Schedule.Paused"]</button>
                        </div>
                    }
                </section>

                <section class="events">
                    <div class="section-head">
                        <h2>@Common["Common.Screen.Events"]</h2>
                        <a href="events">@Common["Common.AllEvents"]</a>
                    </div>
                    @if (_events.Count == 0)
                    {
                        <p class="hint">@Texts["Groups.NoEvents"]</p>
                    }
                    else
                    {
                        <div class="list">
                            @foreach (var row in _events)
                            {
                                <div class="row @(row.View.IsAlert ? "alert" : null)" @key="row.Id">
                                    <span class="time">@row.TimestampLocal.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</span>
                                    <span class="badge @(row.View.IsPerson ? "person" : "automatic")" aria-hidden="true">@row.View.Badge</span>
                                    <div class="text">
                                        <EventWhat Row="row" />
                                        <span class="day">@Events.DayLabel(row.TimestampLocal)</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>

                <section class="safety">
                    <p>@Texts["Groups.Safety"]</p>
                </section>

                @if (CanChangeMembers)
                {
                    <button type="button" class="delete" disabled="@_busy" @onclick="() => _confirmDelete = true">@Texts["Groups.Delete"]</button>
                }
            </main>

            <div class="save">
                @if (_changedElsewhere)
                {
                    <p class="warning" role="status">@Texts["Groups.ChangedElsewhere"]</p>
                }
                @if (_saveError is not null)
                {
                    <p class="error" role="alert">@_saveError</p>
                }
                <button type="submit" disabled="@_busy">@Common["Common.Save"]</button>
            </div>
        </form>

        @if (_confirmDelete)
        {
            <div class="backdrop">
                <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title">
                    <h2 id="confirm-title">@Texts["Groups.Delete.Title"]</h2>
                    <p>@Texts["Groups.Delete.Text"]</p>
                    <div class="dialog-buttons">
                        <button type="button" class="cancel" @onclick="() => _confirmDelete = false">@Common["Common.Cancel"]</button>
                        <button type="button" class="confirm" disabled="@_busy" @onclick="DeleteAsync">@Common["Common.Delete"]</button>
                    </div>
                </div>
            </div>
        }
    }
</div>

<TabBar Current="TabBar.Tab.Relays" SideMenuOnly="true" />

@code {
    // The group's own board: its state and relays. Unknown (never answered, no relays) until the group is loaded.
    private int? BoardId => _group?.BoardId;

    private LiveBoard? Board => BoardId is { } id ? Registry.Find(id) : null;

    private BoardCapabilities Capabilities => Board?.Capabilities ?? LiveBoard.NoBoard;

    private const int EventCount = 4;

    private GroupView? _group;
    // Where "Add" puts a relay: a step's index, or a new step.
    private const int NewStep = -1;

    private GroupEditor _editor = new([]);
    private int? _addingTo;
    private IReadOnlyList<Relay> _free = [];
    private Dictionary<string, string> _names = [];
    private List<EventRow> _events = [];
    private List<ScheduleModel> _schedules = [];
    private RelayOutlook? _outlook;
    private SignedInUser? _user;
    private bool _loaded;
    private bool _busy;
    private string SomethingWentWrong => Common["Common.SomethingWrongTryAgain"];

    private ITimer? _tick;
    private bool _changedElsewhere;
    private string? _toggleError;
    private bool _confirmDelete;
    private string? _saveError;
    private (int RelayId, string Message)? _memberError;
    private string _name = "";
    private string _icon = GroupIcons.Fan;
    private int? _maxOnMinutes;
    private int _addRelayId;

    [Parameter]
    public int Id { get; set; }

    private BoardState State => Board?.State ?? BoardState.Initial;

    private bool GroupOn => _group is not null && _group.IsOn(State);

    private int? Missing => _group?.MissingRelay(Capabilities.RelayCount);

    // Which relays, their steps and their order only change while the whole group is off and still.
    private bool CanChangeMembers => _group is not null
        && _group.Runtime.Phase == GroupPhases.Idle
        && State.IsConnected
        && !State.Relays.Overlaps(ChannelMask.Of(_group.Members.Select(m => m.Channel).Concat(_editor.Relays.Select(r => r.Channel))));

    // One relay at a time follows the saved steps; after a change to them, save first.
    private bool OrderChanged => _group is not null && !_editor.HasSameRelays(_group.Steps);

    // Free relays, and the group's own that were taken out in the form and not saved yet.
    private IEnumerable<EditRelay> AddableRelays => _free
        .Select(r => new EditRelay(r.Id, r.Channel, r.Name))
        .Concat(_editor.Removed)
        .Where(r => !_editor.Contains(r.RelayId) && !State.IsOn(r.Channel))
        .OrderBy(r => r.Channel);

    private bool CanAdd => CanChangeMembers && _editor.RelayCount < Capabilities.RelayCount && AddableRelays.Any();

    protected override async Task OnParametersSetAsync()
    {
        _user = await CurrentUser.GetAsync();
        _toggleError = null;
        _memberError = null;
        _saveError = null;
        _confirmDelete = false;
        _changedElsewhere = false;
        _group = await Groups.GetAsync(Id, CancellationToken.None);
        if (_group is not null)
        {
            _name = _group.Name;
            _icon = _group.Icon;
            _maxOnMinutes = _group.MaxOnMinutes;
            SeedMembers(_group);
            await LoadLiveAsync();
        }

        _loaded = true;
    }

    protected override void OnInitialized()
    {
        Registry.StateChanged += OnBoardChanged;
        Changes.Changed += OnRelaysChanged;

        // A start or stop counts down in seconds; nothing else re-renders the page that often.
        _tick = Time.CreateTimer(_ =>
        {
            if (_group is { } group && group.Runtime.Phase != GroupPhases.Idle)
            {
                _ = RefreshAsync(reload: false);
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    public void Dispose()
    {
        Registry.StateChanged -= OnBoardChanged;
        Changes.Changed -= OnRelaysChanged;
        _tick?.Dispose();
    }

    private void SeedMembers(GroupView group)
    {
        _editor = new GroupEditor(group.Steps);
        _addingTo = null;
    }

    // What others can change while the page is open; the form fields keep what the user typed.
    private async Task LoadLiveAsync()
    {
        var before = _group;
        var edited = before is not null && !_editor.IsSameAs(before.Steps);
        _group = await Groups.GetAsync(Id, CancellationToken.None) ?? _group;

        // Someone else changed the steps: follow them, unless this form has changes of its own to them.
        if (before is not null && _group is not null && !new GroupEditor(before.Steps).IsSameAs(_group.Steps))
        {
            if (edited)
            {
                _changedElsewhere = true;
            }
            else
            {
                SeedMembers(_group);
            }
        }

        // Only the group's own board's: a group's relays are all on one board.
        _free = [.. (await Groups.FreeRelaysAsync(_group?.BoardId, CancellationToken.None))];
        await using var db = await DbFactory.CreateDbContextAsync();
        _names = await ActorNames.LoadAsync(db, CancellationToken.None);
        _events = [.. await Events.GetAsync(EventFilter.All, beforeId: null, EventCount, CancellationToken.None, groupId: Id)];
        _schedules = [.. await Schedules.ListForGroupAsync(Id, CancellationToken.None)];
        _outlook = (await Outlook.GetGroupsAsync(CancellationToken.None)).GetValueOrDefault(Id);
        if (_addRelayId == 0 || AddableRelays.All(r => r.RelayId != _addRelayId))
        {
            _addRelayId = AddableRelays.FirstOrDefault()?.RelayId ?? 0;
        }
    }

    // The name of the step above that must be all on first for this relay, or null. Only for the steps as saved: after
    // a change to them, save first.
    private string? BlockedBy(int relayId)
    {
        if (OrderChanged || _group is null)
        {
            return null;
        }

        var position = _group.Members.Select(m => m.RelayId).ToList().IndexOf(relayId) + 1;
        return position > 0 ? GroupPlanner.NeedsOn(_group.Steps, State, position) : null;
    }

    // The step's state in words; after a change to the steps, only on or off.
    private string StepNote(int index)
    {
        if (!OrderChanged)
        {
            return GroupStatus.StepNote(_group!, State, index, Clock.UtcNow);
        }

        return _editor.Steps[index].Relays.All(r => State.IsOn(r.Channel)) ? Texts["Groups.Member.On"] : Texts["Groups.Member.Off"];
    }

    private static IEnumerable<int> Choices(IReadOnlyList<int> offered, int current)
    {
        return offered.Contains(current) ? offered : offered.Append(current).Order();
    }

    private void Move(int stepIndex, int by)
    {
        _editor.Move(stepIndex, by);
        _addingTo = null;
    }

    private void Remove(int relayId)
    {
        _editor.Remove(relayId);
        _addingTo = null;
    }

    private void StartAdding(int target)
    {
        _addingTo = target;
        _addRelayId = AddableRelays.FirstOrDefault()?.RelayId ?? 0;
    }

    private void AddRelay()
    {
        if (_addingTo is not { } target || AddableRelays.FirstOrDefault(r => r.RelayId == _addRelayId) is not { } relay)
        {
            return;
        }

        if (target == NewStep)
        {
            _editor.AddStep(relay);
        }
        else
        {
            _editor.AddToStep(target, relay);
        }

        _addingTo = null;
        _addRelayId = AddableRelays.FirstOrDefault()?.RelayId ?? 0;
    }

    // The relay list "+ Add a relay to this step" and "+ Add a step" open.
    private RenderFragment AddPicker(int target) => __builder =>
    {
        <div class="add">
            <label for="@($"add-relay-{target}")" class="visually-hidden">@Texts["Groups.RelayToAdd"]</label>
            <select id="@($"add-relay-{target}")" @bind="_addRelayId">
                @foreach (var relay in AddableRelays)
                {
                    <option value="@relay.RelayId">@Texts["Groups.RelayOption", relay.Channel, relay.Name]</option>
                }
            </select>
            <div class="add-buttons">
                <button type="button" class="cancel" @onclick="() => _addingTo = null">@Common["Common.Cancel"]</button>
                <button type="button" class="confirm" @onclick="AddRelay">@Common["Common.Add"]</button>
            </div>
        </div>
    };

    private string? NameOf(string? email)
    {
        if (email is null)
        {
            return null;
        }

        if (email == _user?.Email)
        {
            return RelayTexts["Relays.By.You"];
        }

        return email switch
        {
            EventActors.Schedule => RelayTexts["Relays.By.Schedule"],
            EventActors.AutoOff => RelayTexts["Relays.By.AutoOff"],
            EventActors.External => RelayTexts["Relays.By.Outside"],
            _ => _names.TryGetValue(email, out var name) ? name : IdentityRules.DisplayNameFor(email),
        };
    }

    private async Task ToggleGroupAsync()
    {
        if (_user is null || _busy || _group is null)
        {
            return;
        }

        _busy = true;
        _toggleError = null;
        try
        {
            if (GroupOn)
            {
                await Sequencer.StopGroupAsync(Id, _user.Email, CancellationToken.None);
            }
            else
            {
                await Sequencer.StartGroupAsync(Id, _user.Email, CancellationToken.None);
            }
        }
        catch (BoardClosedException)
        {
            _toggleError = BoardTexts["Boards.BeingRemoved"];
        }
        catch (BoardNotConnectedException)
        {
            _toggleError = Common["Common.BoardNotResponding"];
        }
        catch (Exception ex)
        {
            // An exception that leaves the handler would end the page's live connection.
            Log.LogError(ex, "Starting or stopping group {GroupId} failed", Id);
            _toggleError = SomethingWentWrong;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleMemberAsync(int relayId, bool isOn)
    {
        if (_user is null || _busy)
        {
            return;
        }

        _busy = true;
        _memberError = null;
        try
        {
            if (await Sequencer.SetMemberAsync(Id, relayId, !isOn, _user.Email, CancellationToken.None) is { } refusal)
            {
                _memberError = (relayId, refusal);
            }
        }
        catch (BoardClosedException)
        {
            _memberError = (relayId, BoardTexts["Boards.BeingRemoved"]);
        }
        catch (BoardNotConnectedException)
        {
            _memberError = (relayId, Common["Common.BoardNotResponding"]);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Switching relay {RelayId} of group {GroupId} failed", relayId, Id);
            _memberError = (relayId, SomethingWentWrong);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetEnabledAsync(ScheduleModel schedule)
    {
        if (_user is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await Schedules.SetEnabledAsync(schedule.Id, !schedule.IsEnabled, _user.Email, CancellationToken.None);
            await LoadLiveAsync();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Pausing or resuming schedule {ScheduleId} failed", schedule.Id);
            _saveError = SomethingWentWrong;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_user is null || _group is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var draft = new GroupDraft(_name, _icon, _maxOnMinutes, _editor.Drafts);
            _saveError = await Groups.SaveAsync(Id, draft, _user.Email, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Saving group {GroupId} failed", Id);
            _saveError = SomethingWentWrong;
        }
        finally
        {
            _busy = false;
        }

        if (_saveError is null)
        {
            Navigation.NavigateTo("");
        }
    }

    private async Task DeleteAsync()
    {
        if (_user is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            _saveError = await Groups.DeleteAsync(Id, _user.Email, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Deleting group {GroupId} failed", Id);
            _saveError = SomethingWentWrong;
        }
        finally
        {
            _busy = false;
            _confirmDelete = false;
        }

        if (_saveError is null)
        {
            Navigation.NavigateTo("");
        }
    }

    // Any board's new state: only the page's own board's is redrawn.
    private void OnBoardChanged(object? sender, BoardStateChange change)
    {
        if (change.BoardId != BoardId)
        {
            return;
        }

        _ = RefreshAsync(reload: false);
    }

    private void OnRelaysChanged(object? sender, EventArgs e)
    {
        _ = RefreshAsync(reload: true);
    }

    private async Task RefreshAsync(bool reload)
    {
        using var language = Language.Use();
        try
        {
            await InvokeAsync(async () =>
            {
                if (reload && _group is not null)
                {
                    await LoadLiveAsync();
                }

                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the update was on its way.
        }
    }
}
