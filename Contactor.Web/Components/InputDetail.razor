@page "/input/{Id:int}"
@implements IDisposable
@using Contactor.Boards
@using Contactor.Web.Features.Boards
@using Contactor.Web.Features.Events
@using Contactor.Web.Features.Inputs
@using Contactor.Web.Features.Languages
@using Contactor.Web.Features.Relays
@using Contactor.Web.Persistence
@inject BoardRegistry Registry
@inject InputsHandler Inputs
@inject InputActionsHandler Actions
@inject EventsHandler Events
@inject RelayChanges Changes
@inject LocalClock Clock
@inject NavigationManager Navigation
@inject RelayStatusText StatusText
@inject InputsText InputsText
@inject AppLanguage Language
@inject ILogger<InputDetail> Log

<PageTitle>@(Texts["Common.PageTitle", _input?.Name ?? Texts["Common.Screen.Input"].Value])</PageTitle>

<div class="screen">
    <header class="header">
        <a href="" class="back">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
            @Texts["Common.Screen.Relays"]
        </a>
        @if (_input is not null)
        {
            @* On a desktop Save sits here, pinned to the top; on a phone and a tablet it is at the bottom of the form. *@
            <button type="submit" form="input-form" class="save-top" disabled="@_busy">@Texts["Common.Save"]</button>
        }
    </header>

    @if (_loaded && _input is null)
    {
        <main class="content">
            <p class="missing">@Texts["Inputs.Missing"]</p>
        </main>
    }
    else if (_input is not null)
    {
        <form id="input-form" class="form" @onsubmit="SaveAsync">
            <main class="content">
                <div class="field">
                    <label for="name" class="label">@Texts["Inputs.NameLabel", _input.Channel]</label>
                    <input id="name" type="text" maxlength="@Input.NameMaxLength" @bind="_name" @bind:event="oninput" autocomplete="off" />
                    <label for="active" class="check">
                        <input id="active" type="checkbox" @bind="_isActive" />
                        <span><Sentence Text="@Texts["Inputs.Active"]"><Arg0><strong>@Texts["Inputs.ActiveWord"]</strong></Arg0></Sentence></span>
                    </label>
                </div>

                @* What the board reads now; the app can't switch an input. *@
                <section class="status @(!State.HasAnswered ? "unknown" : IsClosed ? "closed" : null)">
                    <div class="now-row">
                        <div>
                            <p class="label">@Texts["Inputs.Now"]</p>
                            <p class="now">
                                @(State.HasAnswered ? Status.Text : StatusText.Waiting)
                                @if (State.HasAnswered && Status.SinceUnknown)
                                {
                                    <WhyUnknown Label="@Texts["Inputs.WhyUnknownLabel"]" For="Id" />
                                }
                            </p>
                        </div>
                        <InputStateBadge Closed="IsClosed" Unknown="!State.HasAnswered" />
                    </div>
                    @if (State.HasAnswered && !State.IsConnected)
                    {
                        <p class="hint">@Texts["Inputs.Stale"]</p>
                    }
                </section>

                @* The relays and groups this input switches when it closes or opens. *@
                <section class="controls">
                    <h2>@Texts["Inputs.Controls"]</h2>
                    @foreach (var row in _actions)
                    {
                        <div class="control" @key="row.Target.Key">
                            <div class="control-head">
                                <strong>@InputsText.Label(row.Target)</strong>
                                <button type="button" class="remove" @onclick="() => Remove(row)">@Texts["Inputs.Remove"]</button>
                            </div>
                            @ChoiceRow(row, closes: true)
                            @ChoiceRow(row, closes: false)
                        </div>
                    }
                    @if (_adding)
                    {
                        <div class="pick" role="group" aria-label="@Texts["Inputs.AddLabel"]">
                            @if (Available.Count == 0)
                            {
                                <p class="hint">@Texts["Inputs.NothingToAdd"]</p>
                            }
                            @foreach (var target in Available)
                            {
                                <button type="button" @key="target.Key" @onclick="() => Add(target)">@InputsText.Label(target)</button>
                            }
                        </div>
                    }
                    else
                    {
                        <button type="button" class="add" @onclick="() => _adding = true">@Texts["Inputs.Add"]</button>
                    }
                    <p class="hint">@Texts["Inputs.Controls.Hint"]</p>
                </section>

                <section class="events">
                    <div class="section-head">
                        <h2>@Texts["Common.Screen.Events"]</h2>
                        <a href="events">@Texts["Common.AllEvents"]</a>
                    </div>
                    @if (_events.Count == 0)
                    {
                        <p class="hint">@Texts["Inputs.NoEvents"]</p>
                    }
                    else
                    {
                        <div class="list">
                            @foreach (var row in _events)
                            {
                                <div class="row" @key="row.Id">
                                    <span class="time">@row.TimestampLocal.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</span>
                                    <span class="badge automatic" aria-hidden="true">@row.View.Badge</span>
                                    <div class="text">
                                        <EventWhat Row="row" />
                                        <span class="day">@Events.DayLabel(row.TimestampLocal)</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>
            </main>

            <div class="save">
                @if (_saveError is not null)
                {
                    <p class="error" role="alert">@_saveError</p>
                }
                <button type="submit" disabled="@_busy">@Texts["Common.Save"]</button>
            </div>
        </form>
    }
</div>

<TabBar Current="TabBar.Tab.Relays" SideMenuOnly="true" />

@code {
    // The input's own board: its state. Unknown (never answered) until the input is loaded.
    private int? BoardId => _input?.BoardId;

    private BoardState State => BoardId is { } id && Registry.Find(id) is { } board ? board.State : BoardState.Initial;

    private const int EventCount = 4;

    private InputView? _input;
    private List<EventRow> _events = [];
    private bool _loaded;
    private bool _busy;
    private string? _saveError;
    private string _name = "";
    private bool _isActive;

    [Parameter]
    public int Id { get; set; }

    private List<InputActionRow> _actions = [];
    private IReadOnlyList<InputActionTarget> _targets = [];
    private bool _adding;

    private bool IsClosed => _input is not null && State.Inputs.Contains(_input.Channel);

    // What can still be added: what the input doesn't control yet.
    private List<InputActionTarget> Available => [.. _targets.Where(t => !_actions.Any(a => a.Target.IsSame(t)))];

    // "CLOSES" or "OPENS", and Turn on / Turn off / Nothing.
    private RenderFragment ChoiceRow(InputActionRow row, bool closes) => __builder =>
    {
        var current = closes ? row.WhenClosed : row.WhenOpened;
        <div class="choice" role="group" aria-label="@Texts[closes ? "Inputs.WhenCloses" : "Inputs.WhenOpens", InputsText.Label(row.Target)]">
            <span class="label">@Texts[closes ? "Inputs.Closes" : "Inputs.Opens"]</span>
            <div class="seg">
                <button type="button" aria-pressed="@(current == true ? "true" : "false")" @onclick="() => Set(row, closes, true)">@Texts["Inputs.TurnOn"]</button>
                <button type="button" aria-pressed="@(current == false ? "true" : "false")" @onclick="() => Set(row, closes, false)">@Texts["Inputs.TurnOff"]</button>
                <button type="button" aria-pressed="@(current is null ? "true" : "false")" @onclick="() => Set(row, closes, null)">@Texts["Inputs.Nothing"]</button>
            </div>
        </div>
    };

    private void Set(InputActionRow row, bool closes, bool? action)
    {
        var index = _actions.IndexOf(row);
        if (index >= 0)
        {
            _actions[index] = closes ? row with { WhenClosed = action } : row with { WhenOpened = action };
        }
    }

    // A new row turns it on when the input closes and off when it opens; either can be changed before saving.
    private void Add(InputActionTarget target)
    {
        _actions.Add(new InputActionRow(target, WhenClosed: true, WhenOpened: false));
        _adding = false;
    }

    private void Remove(InputActionRow row)
    {
        _actions.Remove(row);
    }

    private InputStatus Status => InputsText.Status(_input!, IsClosed, State.IsConnected, Clock.Now, Clock.ToLocal);

    protected override async Task OnParametersSetAsync()
    {
        _input = await Inputs.GetAsync(Id, CancellationToken.None);
        if (_input is not null)
        {
            (_name, _isActive) = (_input.Name, _input.IsActive);
            _events = [.. await Events.GetAsync(EventFilter.All, beforeId: null, EventCount, CancellationToken.None, inputId: Id)];
            _actions = [.. await Actions.ListAsync(Id, CancellationToken.None)];
            _targets = await Actions.TargetsAsync(Id, CancellationToken.None);
        }

        _loaded = true;
    }

    protected override void OnInitialized()
    {
        Registry.StateChanged += OnBoardChanged;
        Changes.Changed += OnChanged;
    }

    public void Dispose()
    {
        Registry.StateChanged -= OnBoardChanged;
        Changes.Changed -= OnChanged;
    }

    private async Task SaveAsync()
    {
        if (_input is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            // The groups and relays are checked first, so a refusal there saves nothing at all.
            _saveError = await Actions.CheckAsync(Id, _actions, CancellationToken.None)
                ?? await Inputs.SaveAsync(new InputSettings(Id, _name, _isActive), CancellationToken.None)
                ?? await Actions.SaveAsync(Id, _actions, CancellationToken.None);
        }
        finally
        {
            _busy = false;
        }

        if (_saveError is null)
        {
            Navigation.NavigateTo("");
        }
    }

    // The input's own board's state: a redraw is enough.
    private void OnBoardChanged(object? sender, BoardStateChange change)
    {
        if (change.BoardId != BoardId)
        {
            return;
        }

        _ = RefreshAsync(reload: false);
    }

    // A new event, or a change saved elsewhere: reload the events and the last change, but keep what is being typed.
    private void OnChanged(object? sender, EventArgs e)
    {
        _ = RefreshAsync(reload: true);
    }

    private async Task RefreshAsync(bool reload)
    {
        using var language = Language.Use();
        try
        {
            await InvokeAsync(async () =>
            {
                if (reload && _input is null)
                {
                    // Missing so far, e.g. opened before a Shelly said how many inputs it has (InputCountWatch): load it
                    // as when the page opened.
                    await OnParametersSetAsync();
                }
                else if (reload && _input is not null && await Inputs.GetAsync(Id, CancellationToken.None) is { } fresh)
                {
                    _input = fresh;
                    _events = [.. await Events.GetAsync(EventFilter.All, beforeId: null, EventCount, CancellationToken.None, inputId: Id)];
                    _targets = await Actions.TargetsAsync(Id, CancellationToken.None);
                }

                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the update was on its way.
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Not shown to the person: the page keeps what it shows, and the next refresh tries again.
            Log.LogWarning(ex, "The page could not reload {What}", "the input");
        }
    }
}
