@implements IDisposable
@using System.Globalization
@using Contactor.Boards
@using Contactor.Web.Features.Boards
@using Contactor.Web.Features.Identity
@using Contactor.Web.Features.Languages
@using Contactor.Web.Features.Setup
@inject BoardAddressHandler Handler
@inject BoardRegistry Registry
@inject CurrentUser CurrentUser
@inject BoardLoginText LoginText
@inject BoardProblemText ProblemText
@inject TimeProvider Time
@inject AppLanguage Language

@* One board's card: on Settings with one board ("Relay board"), and on a board's own page ("Board", with its name). *@
<form class="card" @onsubmit="SaveAsync">
    <h2>@(Title ?? Texts["Common.Screen.RelayBoard"])</h2>
    <p class="hint">@Texts["Boards.ModelLine", Model?.Name ?? Texts["Common.NoModel"], Texts.Plural("Boards.Relays", RelayCount)]</p>

    @if (WithName)
    {
        <div class="field">
            <label for="board-name">@Texts["Boards.Name"]</label>
            <input id="board-name" type="text" class="name" autocomplete="off" maxlength="@Contactor.Web.Persistence.Board.NameMaxLength"
                   @bind="_name" @bind:event="oninput" />
        </div>
    }

    <div class="fields">
        <div class="field">
            <label for="host">@Texts["Boards.Address"]</label>
            <input id="host" type="text" inputmode="decimal" autocomplete="off" autocapitalize="off" spellcheck="false"
                   maxlength="253" placeholder="192.168.1.50" @bind="_host" @bind:event="oninput" />
        </div>
        <div class="field">
            <label for="port">@Texts["Boards.Port"]</label>
            <input id="port" type="text" inputmode="numeric" autocomplete="off" maxlength="5" placeholder="@Model?.DefaultPort" @bind="_port" @bind:event="oninput" />
        </div>
    </div>
    <p class="hint">@Texts["Boards.AddressHint"]</p>

    @if (Model is { HasLogin: true } model)
    {
        @* A board that always has a login (an SNMP community) gets no "no login" box. *@
        @if (!model.LoginRequired)
        {
            <label for="no-login" class="check">
                <input id="no-login" type="checkbox" @bind="_noLogin" />
                <span>@Texts[model.PasswordOnly ? "Boards.NoPassword" : "Boards.NoLogin"]</span>
            </label>
        }
        @if (model.LoginRequired || !_noLogin)
        {
            <div class="fields login">
                @if (!model.PasswordOnly)
                {
                    <div class="field">
                        <label for="username">@Texts["Boards.UserName"]</label>
                        <input id="username" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" @ref="_usernameField"
                               maxlength="@model.LoginMaxLength" @bind="_username" @bind:event="oninput" />
                    </div>
                }
                <div class="field">
                    <label for="password">@Texts["Boards.Password"]</label>
                    <input id="password" type="password" autocomplete="new-password" @ref="_passwordField"
                           maxlength="@model.LoginMaxLength" placeholder="@Texts[_hasPassword ? "Boards.Password.Unchanged" : "Boards.Password.None"]"
                           @bind="_newPassword" @bind:event="oninput" />
                </div>
            </div>
            <p class="hint">@LoginText.Hint(model)</p>
        }
    }

    @if (State.IsConnected)
    {
        <p class="status online" role="status"><span class="dot" aria-hidden="true"></span>@Texts["Boards.Online", Endpoint]</p>
    }
    else if (!Endpoint.HasHost)
    {
        <p class="status offline" role="status">@Texts["Boards.NoAddress"]</p>
    }
    else if (State.Problem is { } problem)
    {
        @* Why the board refuses the connection. The model can't be changed here: another one is added again. *@
        <div role="status">
            <p class="status offline">@ProblemText.Long(problem)</p>
            @if (ProblemText.AddAgain(problem) is { } again)
            {
                <p class="status-more">@again</p>
            }
        </div>
    }
    else
    {
        <p class="status offline" role="status">@Texts["Boards.NoContact", Endpoint]</p>
    }

    @if (_message is not null)
    {
        <p class="@(_saved ? "saved" : "error")" role="alert">@_message</p>
    }

    <button type="submit" class="save" disabled="@_busy">@Texts["Common.Save"]</button>
</form>

@code {
    /// <summary>
    /// How long after the person's Save a login problem still opens the login fields and takes the cursor: as long as
    /// the setup guide waits for a board. Later, the person may be typing.
    /// </summary>
    public static readonly TimeSpan LoginFocusWindow = TimeSpan.FromSeconds(10);

    private static readonly BoardEndpoint NoEndpoint = new("", 0);

    private SignedInUser? _user;

    // Set when the page closes, on the page's own thread: a page closed while it loads doesn't subscribe, and an event
    // already on its way doesn't draw a closed page.
    private bool _disposed;

    private string _name = "";
    private string _host = "";
    private string _port = "";
    private bool _noLogin;
    private string _username = "";
    private string _newPassword = "";
    private bool _hasPassword;
    private string? _message;
    private bool _saved;
    private bool _busy;
    private int? _loadedFor;
    private ElementReference _usernameField;
    private ElementReference _passwordField;

    // Saved by the person: a login problem the board reports next opens the login fields and takes the cursor, once.
    private AfterSave _afterSave;
    private DateTimeOffset _savedAt;
    private bool _focusLogin;

    private enum AfterSave
    {
        // Nothing to wait for.
        None,

        // The address or login moved while the old connection was still open: its end comes first.
        Drop,

        // Waiting for the board's answer or its problem.
        Answer,
    }

    /// <summary>The board's row.</summary>
    [Parameter]
    [EditorRequired]
    public int BoardId { get; set; }

    /// <summary>The card's heading; without one, "Relay board".</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Whether the board's name can be changed here too (a board's own page).</summary>
    [Parameter]
    public bool WithName { get; set; }

    /// <summary>Told the name saved, so the page can show it.</summary>
    [Parameter]
    public EventCallback<string> NameSaved { get; set; }

    private LiveBoard? Live => Registry.Find(BoardId);

    private BoardModel? Model => Live?.Model;

    private int RelayCount => Live?.Capabilities.RelayCount ?? 0;

    private BoardState State => Live?.State ?? BoardState.Initial;

    private BoardEndpoint Endpoint => Live?.Endpoint ?? NoEndpoint;

    protected override async Task OnInitializedAsync()
    {
        _user = await CurrentUser.GetAsync();

        // Dispose ran during the load: subscribing now would leave the handlers for the life of the app. Dispose and this
        // both run on the page's own thread, so nothing can come between the check and the subscription.
        if (_disposed)
        {
            return;
        }

        Registry.StateChanged += OnBoardChanged;
    }

    // Loaded for each board it is given: Settings can give it another one when the boards change.
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == BoardId)
        {
            return;
        }

        _loadedFor = BoardId;
        _message = null;
        _name = await Handler.GetNameAsync(BoardId, CancellationToken.None) ?? "";
        var endpoint = await Handler.GetAsync(BoardId, CancellationToken.None);
        _host = endpoint.Host;
        _port = endpoint.Port > 0 ? endpoint.Port.ToString(CultureInfo.InvariantCulture) : "";
        await LoadLoginAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        Registry.StateChanged -= OnBoardChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusLogin)
        {
            _focusLogin = false;
            await (Model is { PasswordOnly: false } ? _usernameField : _passwordField).FocusAsync();
        }
    }

    // After the person's own Save only, and once: the first answer or problem after it ends the wait, and so does
    // LoginFocusWindow. A problem that comes on its own later (e.g. the board's password was changed) moves nothing
    // while the person may be typing.
    private void ReactToProblem()
    {
        var state = State;
        if (_afterSave != AfterSave.None && Time.GetUtcNow() - _savedAt > LoginFocusWindow)
        {
            _afterSave = AfterSave.None;
        }

        if (_afterSave == AfterSave.Drop)
        {
            if (state.IsConnected)
            {
                return;
            }

            _afterSave = AfterSave.Answer;
        }

        if (_afterSave != AfterSave.Answer || (!state.IsConnected && state.Problem is null))
        {
            return;
        }

        _afterSave = AfterSave.None;
        if (state.Problem is { IsAboutLogin: true } && Model is { HasLogin: true })
        {
            _noLogin = false;
            _focusLogin = true;
        }
    }

    private async Task LoadLoginAsync()
    {
        var login = await Handler.GetLoginAsync(BoardId, CancellationToken.None);
        _username = login.Username;
        _hasPassword = login.HasPassword;
        _noLogin = Model is not { LoginRequired: true } && login.Username.Length == 0 && !login.HasPassword;
        _newPassword = "";
    }

    private async Task SaveAsync()
    {
        if (_user is null || _busy)
        {
            return;
        }

        if (!int.TryParse(_port.Trim(), NumberStyles.None, CultureInfo.InvariantCulture, out var port))
        {
            (_message, _saved) = (Handler.EndpointError(BoardEndpointError.BadPort, null), false);
            return;
        }

        _busy = true;
        var (endpoint, login) = (Live?.Endpoint, Live?.Login);
        try
        {
            // The name first: a name that can't be saved stops the rest, and one saved shows at once.
            var error = WithName ? await Handler.RenameAsync(BoardId, _name, _user.Email, CancellationToken.None) : null;
            if (WithName && error is null)
            {
                _name = _name.Trim();
                await NameSaved.InvokeAsync(_name);
            }

            error ??= await Handler.SaveAsync(BoardId, _host, port, _user.Email, CancellationToken.None);
            error ??= Model is { HasLogin: true }
                ? await Handler.SaveLoginAsync(BoardId, _username, _newPassword, _noLogin && Model is not { LoginRequired: true }, _user.Email, CancellationToken.None)
                : null;
            // A board "Add a board" didn't finish, set up here: the person keeps it, so the next start doesn't remove it.
            if (error is null && Live is { IsUnfinished: true })
            {
                await Registry.FinishAddingAsync(BoardId, CancellationToken.None);
            }

            (_message, _saved) = error is null ? (Texts["Boards.Saved"].Value, true) : (error, false);
            if (error is null)
            {
                await LoadLoginAsync();
                var moved = Live is { } live && endpoint is not null && login is not null && BoardContact.HasMoved(live, endpoint, login);
                _afterSave = moved && State.IsConnected ? AfterSave.Drop : AfterSave.Answer;
                _savedAt = Time.GetUtcNow();
                ReactToProblem();

                // The same address and login saved again, e.g. after the password was put right on the board itself:
                // one attempt now, since a refused login isn't tried again by itself (Issue #522). After the reaction
                // above, so the problem the person saw still opens the login fields.
                if (!moved && Live is { } waiting && BoardContact.ShouldTryAgain(waiting.State))
                {
                    waiting.TryAgain();
                }
            }
        }
        finally
        {
            _busy = false;
        }
    }

    // From a board's read loop: only this board's state redraws the card.
    private void OnBoardChanged(object? sender, BoardStateChange change)
    {
        if (change.BoardId == BoardId)
        {
            _ = RefreshAsync();
        }
    }

    private async Task RefreshAsync()
    {
        using var language = Language.Use();
        try
        {
            await InvokeAsync(() =>
            {
                // On the page's own thread, as Dispose is: a closed page draws nothing.
                if (_disposed)
                {
                    return;
                }

                ReactToProblem();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the update was on its way.
        }
    }
}
