@implements IDisposable
@using Contactor.Web.Features.Languages
@using Contactor.Web.Features.Updates
@inject UpdateService Updates
@inject IStringLocalizer<UpdatesTexts> Texts
@inject AppLanguage Language

@* Over every open page while an update restarts the app (UpdateService.IsRestarting): the page stays as it is while
   the app is away, and reloads by itself once it is back (reconnect.js). *@
@if (Updates.IsRestarting)
{
    var to = Updates.Snapshot().Status?.To;
    <div class="update-splash" role="alertdialog" aria-modal="true" aria-labelledby="splash-title" aria-describedby="splash-text">
        <div class="splash-body">
            <h1 id="splash-title">@Texts["Updates.Splash.Title"]</h1>
            <p id="splash-text">@(to is null ? Texts["Updates.Splash.ToNew"] : Texts["Updates.Splash.To", to])</p>
            <div class="bar" aria-hidden="true"><span></span></div>
            <p>@Texts["Updates.Ask.Relays"]</p>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        Updates.Changed += OnChanged;
    }

    public void Dispose()
    {
        Updates.Changed -= OnChanged;
    }

    private void OnChanged(object? sender, EventArgs e)
    {
        _ = RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        using var language = Language.Use();
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The page closed meanwhile.
        }
    }
}
