@page "/settings"
@implements IDisposable
@using System.Globalization
@using Contactor.Boards
@using Contactor.Web.Features.Backup
@using Contactor.Web.Features.Boards
@using Contactor.Web.Features.Identity
@using Contactor.Web.Features.Relays
@inject BoardAddressHandler Board
@inject UsersHandler Users
@inject BackupService Backup
@inject IRelayBoard Relays
@inject IBoardConnection Connection
@inject BoardModel Model
@inject CurrentUser CurrentUser
@inject LocalClock Clock
@inject BoardTrafficSetting Debugging

<PageTitle>Settings · Contactor</PageTitle>

<div class="screen">
    <header class="header">
        <h1>Settings</h1>
    </header>

    <main class="content">
        <form class="card" @onsubmit="SaveBoardAsync">
            <h2>Relay board</h2>
            <p class="hint">@Model.Name · @Relays.Capabilities.RelayCount @(Relays.Capabilities.RelayCount == 1 ? "relay" : "relays")</p>
            <div class="fields">
                <div class="field">
                    <label for="host">Address</label>
                    <input id="host" type="text" inputmode="decimal" autocomplete="off" autocapitalize="off" spellcheck="false"
                           maxlength="253" placeholder="192.168.1.50" @bind="_host" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label for="port">Port</label>
                    <input id="port" type="text" inputmode="numeric" autocomplete="off" maxlength="5" @bind="_port" @bind:event="oninput" />
                </div>
            </div>
            <p class="hint">The relay board's IP address on the local network. Your router lists it among its connected devices.</p>

            @if (Model.HasLogin)
            {
            <label for="no-login" class="check">
                <input id="no-login" type="checkbox" @bind="_noLogin" />
                <span>The board has no login</span>
            </label>
            @if (!_noLogin)
            {
                <div class="fields login">
                    <div class="field">
                        <label for="username">User name</label>
                        <input id="username" type="text" autocomplete="off" autocapitalize="off" spellcheck="false"
                               maxlength="@Model.LoginMaxLength" @bind="_username" @bind:event="oninput" />
                    </div>
                    <div class="field">
                        <label for="password">Password</label>
                        <input id="password" type="password" autocomplete="new-password"
                               maxlength="@Model.LoginMaxLength" placeholder="@(_hasPassword ? "unchanged" : "none")"
                               @bind="_newPassword" @bind:event="oninput" />
                    </div>
                </div>
                <p class="hint">The same as on the board's own web page. At most @Model.LoginMaxLength characters.</p>
            }
            }

            @if (Relays.State.IsConnected)
            {
                <p class="status online" role="status"><span class="dot" aria-hidden="true"></span>Board online at @Connection.Endpoint</p>
            }
            else
            {
                <p class="status offline" role="status">No contact with the relay board at @Connection.Endpoint</p>
            }

            @if (_boardMessage is not null)
            {
                <p class="@(_boardSaved ? "saved" : "error")" role="alert">@_boardMessage</p>
            }

            <button type="submit" class="save" disabled="@_busy">Save</button>
        </form>

        <section class="card">
            <h2>People</h2>
            <p class="hint">The names shown in the app and under Events.</p>
            @foreach (var person in _people)
            {
                <form class="person" @key="person.Email" @onsubmit="() => RenameAsync(person)">
                    <div class="field">
                        <label for="@($"name-{person.Index}")">@person.Email</label>
                        <div class="row">
                            <input id="@($"name-{person.Index}")" type="text" maxlength="@Contactor.Web.Persistence.User.DisplayNameMaxLength"
                                   autocomplete="off" @bind="person.Name" @bind:event="oninput" />
                            <button type="submit" class="small" disabled="@_busy">Save</button>
                        </div>
                    </div>
                    @if (person.Message is not null)
                    {
                        <p class="@(person.Saved ? "saved" : "error")" role="alert">@person.Message</p>
                    }
                </form>
            }
        </section>

        <section class="card">
            <h2>Backups</h2>
            <p class="hint">The app copies everything every night at 02:30 and keeps the latest 14. Download one now and then and keep it somewhere else.</p>
            @if (_latest is { } latest)
            {
                <p class="latest">Latest: @RelayStatusText.When(Clock.ToLocal(latest.LastWriteTimeUtc), Clock.Now) · @Size(latest.Length)</p>
            }
            else
            {
                <p class="latest">No copy yet.</p>
            }

            @if (_backupMessage is not null)
            {
                <p class="@(_backupSaved ? "saved" : "error")" role="alert">@_backupMessage</p>
            }

            <div class="buttons">
                <button type="button" class="secondary" disabled="@_busy" @onclick="BackupNowAsync">Make a copy now</button>
                @if (_latest is not null)
                {
                    <a class="download" href="@BackupEndpoints.LatestPath.TrimStart('/')" download data-enhance-nav="false">Download</a>
                }
            </div>
        </section>

        <section class="card">
            <h2>Debugging</h2>
            <label for="debugging" class="check">
                <input id="debugging" type="checkbox" checked="@_debugging" disabled="@(_user is null)" @onchange="SetDebuggingAsync" />
                <span>Show the traffic to the relay board</span>
            </label>
            <p class="hint">Only for you. Every message to and from the board shows for a moment at the bottom of the page, and the whole list under the Debug tab.</p>
        </section>
    </main>

    <p class="version">@VersionText</p>

    <TabBar Current="TabBar.Tab.Settings" />
</div>

@code {
    private static readonly string VersionText = AppBuild.Current is { IsRelease: true } build
        ? $"Version {build.Version}{(build.ShortCommit is { } commit ? $" · {commit}" : "")}"
        : $"Development version{(AppBuild.Current.ShortCommit is { } dev ? $" · {dev}" : "")}";

    private SignedInUser? _user;
    private string _host = "";
    private string _port = "";
    private bool _noLogin;
    private string _username = "";
    private string _newPassword = "";
    private bool _hasPassword;
    private string? _boardMessage;
    private bool _boardSaved;
    private List<Person> _people = [];
    private FileInfo? _latest;
    private string? _backupMessage;
    private bool _backupSaved;
    private bool _busy;
    private bool _debugging;

    protected override async Task OnInitializedAsync()
    {
        _user = await CurrentUser.GetAsync();
        var endpoint = await Board.GetAsync(CancellationToken.None);
        _host = endpoint.Host;
        _port = endpoint.Port.ToString(CultureInfo.InvariantCulture);
        await LoadLoginAsync();
        await LoadPeopleAsync();
        _latest = await Backup.LatestAsync(CancellationToken.None);
        _debugging = _user is not null && await Debugging.IsOnAsync(_user.Email, CancellationToken.None);
        Relays.StateChanged += OnBoardChanged;
    }

    public void Dispose()
    {
        Relays.StateChanged -= OnBoardChanged;
    }

    private async Task LoadLoginAsync()
    {
        var login = await Board.GetLoginAsync(CancellationToken.None);
        _username = login.Username;
        _hasPassword = login.HasPassword;
        _noLogin = login.Username.Length == 0 && !login.HasPassword;
        _newPassword = "";
    }

    private async Task LoadPeopleAsync()
    {
        var users = await Users.ListAsync(CancellationToken.None);
        _people = [.. users.Select((u, i) => new Person(i, u.Email, u.DisplayName))];
    }

    private async Task SaveBoardAsync()
    {
        if (_user is null || _busy)
        {
            return;
        }

        if (!int.TryParse(_port.Trim(), NumberStyles.None, CultureInfo.InvariantCulture, out var port))
        {
            (_boardMessage, _boardSaved) = ("The port is a number from 1 to 65535.", false);
            return;
        }

        _busy = true;
        try
        {
            var error = await Board.SaveAsync(_host, port, _user.Email, CancellationToken.None)
                ?? (Model.HasLogin ? await Board.SaveLoginAsync(_username, _newPassword, _noLogin, _user.Email, CancellationToken.None) : null);
            (_boardMessage, _boardSaved) = error is null ? ("Saved. The app reconnects to the board.", true) : (error, false);
            if (error is null)
            {
                await LoadLoginAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RenameAsync(Person person)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var error = await Users.RenameAsync(person.Email, person.Name, CancellationToken.None);
            (person.Message, person.Saved) = error is null ? ("Saved.", true) : (error, false);
            if (error is null)
            {
                person.Name = person.Name.Trim();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BackupNowAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await Backup.RunAsync(CancellationToken.None);
            _latest = await Backup.LatestAsync(CancellationToken.None);
            (_backupMessage, _backupSaved) = ("Copy made.", true);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or Microsoft.Data.Sqlite.SqliteException)
        {
            (_backupMessage, _backupSaved) = ("The copy couldn't be made. Try again in a while.", false);
        }
        finally
        {
            _busy = false;
        }
    }

    // Saved at once: a checkbox needs no Save.
    private async Task SetDebuggingAsync(ChangeEventArgs e)
    {
        if (_user is null)
        {
            return;
        }

        _debugging = e.Value is true;
        await Debugging.SetAsync(_user.Email, _debugging, CancellationToken.None);
    }

    private static string Size(long bytes)
    {
        return bytes < 1024 * 1024
            ? $"{Math.Max(1, bytes / 1024).ToString(CultureInfo.InvariantCulture)} kB"
            : $"{(bytes / (1024.0 * 1024.0)).ToString("0.0", CultureInfo.InvariantCulture)} MB";
    }

    // From the board's read loop.
    private void OnBoardChanged(object? sender, BoardState state)
    {
        _ = RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the update was on its way.
        }
    }

    private sealed class Person
    {
        public Person(int index, string email, string name)
        {
            Index = index;
            Email = email;
            Name = name;
        }

        public int Index { get; }

        public string Email { get; }

        public string Name { get; set; }

        public string? Message { get; set; }

        public bool Saved { get; set; }
    }
}
