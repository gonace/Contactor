@page "/settings"
@implements IDisposable
@using System.Globalization
@using Contactor.Boards
@using Contactor.Web.Features.Backup
@using Contactor.Web.Features.Boards
@using Contactor.Web.Features.Identity
@using Contactor.Web.Features.Languages
@using Contactor.Web.Features.Relays
@inject RelayChanges Changes
@inject UsersHandler Users
@inject BackupService Backup
@inject BoardRegistry Registry
@inject CurrentUser CurrentUser
@inject LocalClock Clock
@inject BoardTrafficSetting Debugging
@inject AppLanguage Language
@inject IStringLocalizer<SettingsTexts> Texts
@inject RelayStatusText RelayStatus
@inject BoardProblemText ProblemText

<PageTitle>@(Common["Common.PageTitle", Common["Common.Screen.Settings"]])</PageTitle>

<div class="screen">
    <header class="header">
        <h1>@Common["Common.Screen.Settings"]</h1>
    </header>

    <main class="content">
        @* On a desktop two columns, each its own stack: the workshop's own things on the left (the boards, People,
           Backups), the app itself on the right (Updates, Language, Debugging). On a phone and a tablet the columns
           aren't boxes of their own: the cards are one column, in this order. *@
        <div class="column">
            @if (Boards is [var only])
            {
                @* One board: its card as it always was. *@
                <div class="board-stack">
                    <BoardForm BoardId="only.BoardId" Title="@Common["Common.Screen.RelayBoard"]" @key="only.BoardId" />
                    @AddBoard
                </div>
            }
            else
            {
                <section class="card">
                    <h2>@Texts["Settings.Boards"]</h2>
                    @if (Boards.Count == 0)
                    {
                        <p class="hint">@Common["Common.NoBoard"]</p>
                    }
                    else
                    {
                        <p class="hint">@Texts["Settings.Boards.Hint"]</p>
                        <div class="board-rows">
                            @foreach (var board in Boards)
                            {
                                var state = board.State;
                                <a href="@($"board/{board.BoardId}")" class="@(state.IsConnected ? "board-row" : "board-row lost")" @key="board.BoardId">
                                    <span class="info">
                                        <span class="board-name">@board.Name</span>
                                        <span class="board-model">@BoardLine(board)</span>
                                        <span class="board-status"><span class="dot" aria-hidden="true"></span>@StatusText(board)</span>
                                    </span>
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
                                </a>
                            }
                        </div>
                    }
                    @AddBoard
                </section>
            }

            <section class="card">
                <h2>@Texts["Settings.People"]</h2>
                <p class="hint">@Texts["Settings.People.Hint"]</p>
                @foreach (var person in _people)
                {
                    <form class="person" @key="person.Email" @onsubmit="() => RenameAsync(person)">
                        <div class="field">
                            <label for="@($"name-{person.Index}")">@person.Email</label>
                            <div class="row">
                                <input id="@($"name-{person.Index}")" type="text" maxlength="@Contactor.Web.Persistence.User.DisplayNameMaxLength"
                                       autocomplete="off" @bind="person.Name" @bind:event="oninput" />
                                <button type="submit" class="small" disabled="@_busy">@Common["Common.Save"]</button>
                            </div>
                        </div>
                        @if (person.Message is not null)
                        {
                            <p class="@(person.Saved ? "saved" : "error")" role="alert">@person.Message</p>
                        }
                    </form>
                }
            </section>

            <section class="card">
                <h2>@Texts["Settings.Backups"]</h2>
                <p class="hint">@Texts["Settings.Backups.Hint"]</p>
                @if (_latest is { } latest)
                {
                    <p class="latest">@Texts["Settings.Backups.Latest", RelayStatus.When(Clock.ToLocal(latest.LastWriteTimeUtc), Clock.Now), Size(Texts, latest.Length)]</p>
                }
                else
                {
                    <p class="latest">@Texts["Settings.Backups.None"]</p>
                }

                @if (_backupMessage is not null)
                {
                    <p class="@(_backupSaved ? "saved" : "error")" role="alert">@_backupMessage</p>
                }

                <div class="buttons">
                    <button type="button" class="secondary" disabled="@_busy" @onclick="BackupNowAsync">@Texts["Settings.Backups.Make"]</button>
                    @if (_latest is not null)
                    {
                        <a class="download" href="@BackupEndpoints.LatestPath.TrimStart('/')" download data-enhance-nav="false">@Common["Common.Download"]</a>
                    }
                </div>
            </section>
        </div>

        <div class="column">
            <UpdateBox />

            @if (Language.HasChoice)
            {
                <section class="card">
                    <LanguagePicker />
                </section>
            }

            <section class="card">
                <h2>@Texts["Settings.Debugging"]</h2>
                <label for="debugging" class="check">
                    <input id="debugging" type="checkbox" checked="@_debugging" disabled="@(_user is null)" @onchange="SetDebuggingAsync" />
                    <span>@Texts["Settings.Debugging.Check"]</span>
                </label>
                <p class="hint">@Texts["Settings.Debugging.Hint"]</p>
            </section>
        </div>
    </main>

    <p class="version">@VersionText</p>

    <TabBar Current="TabBar.Tab.Settings" />
</div>

@code {
    private IReadOnlyList<LiveBoard> Boards => Registry.All;

    // "+ Add a board": the setup guide's board steps (BoardNew).
    private RenderFragment AddBoard => __builder =>
    {
        <a href="board/new" class="add-board">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg>
            @Common["Common.AddBoard"]
        </a>
    };

    private string VersionText => AppBuild.Current.Text(Common);

    private SignedInUser? _user;
    private List<Person> _people = [];
    private FileInfo? _latest;
    private string? _backupMessage;
    private bool _backupSaved;
    private bool _busy;
    private bool _debugging;

    protected override async Task OnInitializedAsync()
    {
        _user = await CurrentUser.GetAsync();
        await LoadPeopleAsync();
        _latest = await Backup.LatestAsync(CancellationToken.None);
        _debugging = _user is not null && await Debugging.IsOnAsync(_user.Email, CancellationToken.None);
        Registry.StateChanged += OnBoardChanged;
        Registry.BoardsChanged += OnBoardsChanged;
        Changes.Changed += OnBoardsChanged;
    }

    public void Dispose()
    {
        Registry.StateChanged -= OnBoardChanged;
        Registry.BoardsChanged -= OnBoardsChanged;
        Changes.Changed -= OnBoardsChanged;
    }

    // "Velleman VM201 · 8 relays · 192.168.1.50"
    private string BoardLine(LiveBoard board)
    {
        var model = board.Model?.Name ?? Common["Common.NoModel"];
        var relays = Texts.Plural("Settings.Relays", board.Capabilities.RelayCount);
        return board.Endpoint.HasHost
            ? Texts["Settings.BoardLine.Host", model, relays, board.Endpoint.Host]
            : Texts["Settings.BoardLine", model, relays];
    }

    private string StatusText(LiveBoard board)
    {
        var state = board.State;
        return state.IsConnected ? Texts["Settings.Online"]
            : !board.Endpoint.HasHost ? Texts["Settings.NoAddress"]
            : state.Problem is { } problem ? ProblemText.Short(problem)
            : !state.HasAnswered ? Texts["Settings.NoContactYet"]
            : state.LastContactUtc is { } last ? Texts["Settings.NoContactSince", RelayStatus.When(Clock.ToLocal(last.UtcDateTime), Clock.Now)]
            : Texts["Settings.NoContact"];
    }

    private async Task LoadPeopleAsync()
    {
        var users = await Users.ListAsync(CancellationToken.None);
        _people = [.. users.Select((u, i) => new Person(i, u.Email, u.DisplayName))];
    }

    private async Task RenameAsync(Person person)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var error = await Users.RenameAsync(person.Email, person.Name, CancellationToken.None);
            (person.Message, person.Saved) = error is null ? (Common["Common.Saved"].Value, true) : (error, false);
            if (error is null)
            {
                person.Name = person.Name.Trim();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BackupNowAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await Backup.RunAsync(CancellationToken.None);
            _latest = await Backup.LatestAsync(CancellationToken.None);
            (_backupMessage, _backupSaved) = (Texts["Settings.Backups.Made"].Value, true);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or Microsoft.Data.Sqlite.SqliteException)
        {
            (_backupMessage, _backupSaved) = (Texts["Settings.Backups.Failed"].Value, false);
        }
        finally
        {
            _busy = false;
        }
    }

    // Saved at once: a checkbox needs no Save.
    private async Task SetDebuggingAsync(ChangeEventArgs e)
    {
        if (_user is null)
        {
            return;
        }

        _debugging = e.Value is true;
        await Debugging.SetAsync(_user.Email, _debugging, CancellationToken.None);
    }

    /// <summary>A backup's size: "68 kB" under a megabyte, otherwise "1.3 MB", in the language's number format.</summary>
    public static string Size(IStringLocalizer<SettingsTexts> texts, long bytes)
    {
        ArgumentNullException.ThrowIfNull(texts);
        return bytes < 1024 * 1024
            ? texts["Settings.Kilobytes", Math.Max(1, bytes / 1024)]
            : texts["Settings.Megabytes", bytes / (1024.0 * 1024.0)];
    }

    // From a board's read loop: the list's online and no-contact lines.
    private void OnBoardChanged(object? sender, BoardStateChange change)
    {
        if (Boards.Count > 1)
        {
            _ = RefreshAsync();
        }
    }

    // A board added or removed, or renamed.
    private void OnBoardsChanged(object? sender, EventArgs e)
    {
        _ = RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        using var language = Language.Use();
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the update was on its way.
        }
    }

    private sealed class Person
    {
        public Person(int index, string email, string name)
        {
            Index = index;
            Email = email;
            Name = name;
        }

        public int Index { get; }

        public string Email { get; }

        public string Name { get; set; }

        public string? Message { get; set; }

        public bool Saved { get; set; }
    }
}
