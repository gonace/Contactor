@using Contactor.Web.Features.Inputs
@inject InputsText Inputs

@* An input's state as a badge: "Open", or "Closed" in green. Hidden from screen readers: the text beside it always
   says the state already. *@
@if (Unknown)
{
    <span class="state unknown" aria-hidden="true">–</span>
}
else
{
    <span class="state @(Closed ? "closed" : null)" aria-hidden="true"><span class="dot"></span>@Inputs.State(Closed)</span>
}

@code {
    /// <summary>
    /// A grey "–" instead of a state nobody knows: before the board's first answer, and for an input whose setting was
    /// changed on the device until the board connects again (<see cref="Contactor.Boards.BoardState.IsInputKnown"/>).
    /// </summary>
    [Parameter]
    public bool Unknown { get; set; }

    /// <summary>Whether the board reads the input as closed (on).</summary>
    [Parameter]
    public bool Closed { get; set; }
}
