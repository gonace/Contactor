@page "/board/{Id:int}"
@implements IDisposable
@using Contactor.Boards
@using Contactor.Web.Features.Boards
@using Contactor.Web.Features.Languages
@using Contactor.Web.Features.Identity
@inject BoardRegistry Registry
@inject BoardAddressHandler Handler
@inject BoardRemoval Removal
@inject CurrentUser CurrentUser
@inject NavigationManager Navigation
@inject ILogger<BoardPage> Log
@inject AppLanguage Language
@inject Contactor.Web.Features.Relays.BoardsText BoardsText

<PageTitle>@(Texts["Common.PageTitle", _name ?? Texts["Common.Screen.RelayBoard"].Value])</PageTitle>

<div class="screen">
    <header class="header">
        <a href="settings" class="back">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
            @Texts["Common.Screen.Settings"]
        </a>
        @if (_name is not null)
        {
            <h1>@_name</h1>
        }
    </header>

    <main class="content">
        @if (_loaded && (_name is null || Live is null))
        {
            <p class="missing">@(_error ?? Texts["Boards.Page.Missing"])</p>
        }
        else if (_name is not null)
        {
            <BoardForm BoardId="Id" Title="@Texts["Boards.Board"]" WithName="true" NameSaved="OnNameSaved" />
            <OwnRulesCard BoardId="Id" />

            <section class="card remove-card">
                <h2>@Texts["Boards.Remove.Title"]</h2>
                <p class="hint">@Texts["Boards.Remove.Hint"]</p>
                @if (_error is not null)
                {
                    <p class="error" role="alert">@_error</p>
                }
                <button type="button" class="remove" disabled="@_busy" @onclick="AskAsync">@Texts["Boards.Remove.Button", _name]</button>
            </section>
        }
    </main>

    @if (_preview is { } preview)
    {
        var hasContact = HasContact;
        <div class="backdrop">
            <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="remove-title">
                <h2 id="remove-title">@Texts["Boards.Remove.Ask", preview.Name]</h2>
                <p>@Texts["Boards.Remove.Deletes"]</p>
                <ul>
                    <li>@Texts.Plural("Boards.Relays", preview.Relays)</li>
                    @if (preview.Groups > 0)
                    {
                        <li>@Texts.Plural("Boards.Remove.Groups", preview.Groups)</li>
                    }
                    @if (preview.Schedules > 0)
                    {
                        <li>@Texts.Plural("Boards.Remove.Schedules", preview.Schedules)</li>
                    }
                    @if (preview.InputActions > 0)
                    {
                        <li>@Texts.Plural("Boards.Remove.InputActions", preview.InputActions)</li>
                    }
                    <li>@Texts["Boards.Remove.Events", preview.Name]</li>
                </ul>
                @if (hasContact)
                {
                    <p>@Texts["Boards.Remove.OffFirst"]</p>
                    @* A relay the board controls by itself ignores the OFF: said plainly, only when there is one. *@
                    @if (Live?.State.Unavailable is { IsEmpty: false } unavailable)
                    {
                        var numbers = unavailable.Channels.Select(c => c.ToString(System.Globalization.CultureInfo.CurrentCulture)).ToList();
                        <p class="unavailable">@Texts["Boards.Remove.Unavailable" + Plurals.Form(numbers.Count), BoardsText.And(numbers)]</p>
                    }
                    @foreach (var kept in _keptOn)
                    {
                        <p class="unavailable">@Texts["Boards.Remove.KeptOn", kept.Channel, kept.Name, kept.ByChannel, kept.ByName]</p>
                    }
                }
                else
                {
                    <p class="warning" role="status">@Texts["Boards.Remove.NoContact", preview.Name]</p>
                }
                <div class="dialog-buttons">
                    <button type="button" class="cancel" disabled="@_busy" @onclick="Cancel">@Texts["Common.Cancel"]</button>
                    <button type="button" class="confirm" disabled="@_busy" @onclick="() => RemoveAsync(hasContact)">@Texts[_busy ? "Boards.Remove.Removing" : "Boards.Remove.Confirm"]</button>
                </div>
            </div>
        </div>
    }

    <TabBar Current="TabBar.Tab.Settings" />
</div>

@code {
    private string? _name;
    private bool _loaded;
    private BoardRemovalPreview? _preview;

    // What the removal can't turn off: a group's relay the interlock keeps on above one the board controls by itself.
    private IReadOnlyList<KeptOnRelay> _keptOn = [];
    private string? _error;
    private bool _busy;

    [Parameter]
    public int Id { get; set; }

    private LiveBoard? Live => Registry.Find(Id);

    private bool HasContact => Live?.State.IsConnected == true;

    protected override async Task OnParametersSetAsync()
    {
        _name = await Handler.GetNameAsync(Id, CancellationToken.None);
        _loaded = true;
    }

    protected override void OnInitialized()
    {
        Registry.StateChanged += OnBoardChanged;
        Registry.BoardsChanged += OnBoardsChanged;
    }

    public void Dispose()
    {
        Registry.StateChanged -= OnBoardChanged;
        Registry.BoardsChanged -= OnBoardsChanged;
    }

    private void OnNameSaved(string name)
    {
        _name = name;
    }

    // "Remove …" only asks: the dialog lists what goes with the board.
    private async Task AskAsync()
    {
        _error = null;
        _preview = await Removal.PreviewAsync(Id, CancellationToken.None);
        _keptOn = _preview is null ? [] : await Removal.KeptOnAsync(Id, CancellationToken.None);
        if (_preview is null)
        {
            _name = null;
        }
    }

    private void Cancel()
    {
        _preview = null;
    }

    // hasContact: what the dialog said when the person pressed Remove.
    private async Task RemoveAsync(bool hasContact)
    {
        if (_busy || await CurrentUser.GetAsync() is not { } user)
        {
            return;
        }

        _busy = true;
        try
        {
            _error = await Removal.RemoveAsync(Id, turnOffFirst: hasContact, user.Email, CancellationToken.None);
        }
#pragma warning disable CA1031 // Whatever went wrong, the page stays and says so: nothing was removed.
        catch (Exception ex)
#pragma warning restore CA1031
        {
            Log.LogError(ex, "Relay board {BoardId} couldn't be removed", Id);
            _error = Texts["Boards.Remove.Failed", _name ?? ""];
        }
        finally
        {
            _busy = false;
        }

        _preview = null;
        if (_error is null)
        {
            Navigation.NavigateTo("settings");
        }
    }

    // From a board's read loop: this board's contact, which the dialog tells.
    private void OnBoardChanged(object? sender, BoardStateChange change)
    {
        if (change.BoardId == Id && _preview is not null)
        {
            _ = RefreshAsync();
        }
    }

    // A board removed, e.g. this one from another phone.
    private void OnBoardsChanged(object? sender, EventArgs e)
    {
        _ = RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        using var language = Language.Use();
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the update was on its way.
        }
    }
}
