@page "/relay/{Id:int}"
@implements IDisposable
@using Contactor.Boards
@using Microsoft.EntityFrameworkCore
@using Contactor.Web.Features.BoardRules
@using Contactor.Web.Features.Boards
@using Contactor.Web.Features.Events
@using Contactor.Web.Features.Identity
@using Contactor.Web.Features.Languages
@using Contactor.Web.Features.Relays
@using Contactor.Web.Features.Schedules
@using Contactor.Web.Persistence
@inject BoardRegistry Registry
@inject RelayControl Control
@inject RelaySettingsHandler Settings
@inject SchedulesHandler Schedules
@inject EventsHandler Events
@inject RelayChanges Changes
@inject CurrentUser CurrentUser
@inject LocalClock Clock
@inject ScheduleOutlook Outlook
@inject NavigationManager Navigation
@inject IDbContextFactory<ContactorDbContext> DbFactory
@inject RelayStatusText StatusText
@inject AppLanguage Language
@inject ILogger<RelayDetail> Log
@inject OwnRulesHandler OwnRules
@inject OwnRulesText OwnRulesText
@inject RelayPowerOnHandler PowerOn

<PageTitle>@(Texts["Common.PageTitle", _relay?.Name ?? Texts["Common.Screen.Relay"].Value])</PageTitle>

@* The state after a power cut the field shows, kept as it is drawn: a change that alters it is the only one that
   redraws the page (OnPowerOnChanged). *@
@{ _shownPowerOn = ShownPowerOn; }

<div class="screen">
    <header class="header">
        <a href="" class="back">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
            @Texts["Common.Screen.Relays"]
        </a>
        @if (_relay is not null)
        {
            @* On a desktop Save sits here, pinned to the top; on a phone and a tablet it is at the bottom of the form. *@
            <button type="submit" form="relay-form" class="save-top" disabled="@_busy">@Texts["Common.Save"]</button>
        }
    </header>

    @if (_loaded && _relay is null)
    {
        <main class="content">
            <p class="missing">@Texts["Relays.Missing"]</p>
        </main>
    }
    else if (_relay is not null)
    {
        <form id="relay-form" class="form" @onsubmit="SaveAsync">
            <main class="content">
                <div class="field">
                    <label for="name" class="label">@Texts["Relays.Detail.NameLabel", _channel]</label>
                    <input id="name" type="text" maxlength="@Relay.NameMaxLength" @bind="_name" @bind:event="oninput" autocomplete="off" />
                    @if (_group is null)
                    {
                        <label for="active" class="check">
                            <input id="active" type="checkbox" @bind="_isActive" />
                            <span><Sentence Text="@Texts["Relays.Detail.Active"]"><Arg0><strong>@Texts["Relays.Detail.ActiveWord"]</strong></Arg0></Sentence></span>
                        </label>
                    }
                </div>

                @if (_group is { } group)
                {
                    <section class="in-group">
                        <p><Sentence Text="@Texts["Relays.Detail.InGroup"]"><Arg0><strong>@group.Name</strong></Arg0></Sentence></p>
                        <a href="group/@group.Id">@Texts["Relays.Detail.OpenGroup"]</a>
                    </section>
                }
                else if (State.Unavailable.Contains(_channel))
                {
                    @* The board controls it by itself: no switch here, only "Reset". *@
                    <section class="in-group unavailable">
                        <p>@OwnRulesText.Unavailable(_channel)</p>
                        <button type="button" class="reset" disabled="@(_busy || !State.IsConnected)" @onclick="ResetAsync">@Texts["OwnRules.Reset"]</button>
                        @if (_resetError is not null)
                        {
                            <p class="error" role="alert">@_resetError</p>
                        }
                    </section>
                }
                else
                {
                @if (!State.HasAnswered)
                {
                    @* Before the board's first answer: unknown, all grey. *@
                    <section class="status unknown">
                        <p>@StatusText.Waiting</p>
                        <button type="button" class="toggle unknown" aria-label="@StatusText.Waiting" disabled>–</button>
                    </section>
                }
                else
                {
                <section class="status @(IsOn ? "on" : "")">
                    <p>@StatusSentence</p>
                    <button type="button" class="toggle" data-vibrate aria-pressed="@(IsOn ? "true" : "false")" disabled="@(!State.IsConnected || _busy)" @onclick="ToggleAsync">@Texts[IsOn ? "Relays.Detail.TurnOff" : "Relays.Detail.TurnOn"]</button>
                    @if (_toggleFailed)
                    {
                        @if (_inGroup)
                        {
                            <p class="error" role="alert">@Texts["Relays.InGroup"]</p>
                        }
                        else if (_beingRemoved)
                        {
                            <p class="error" role="alert">@Texts["Boards.BeingRemoved"]</p>
                        }
                        else
                        {
                            @* A press the board didn't confirm: nothing is guessed or queued; the person decides. *@
                            <UnconfirmedBox CanTryAgain="@(State.IsConnected && !_busy)" OnTryAgain="() => SwitchAsync(_wanted)" OnLeave="() => _toggleFailed = false" />
                        }
                    }
                </section>
                }

                <section class="limits">
                    <h2>@Texts["Relays.Detail.Limit"]</h2>
                    <div class="choices">
                        @foreach (var limit in RelaySettingsHandler.Limits)
                        {
                            <button type="button" aria-pressed="@(_maxOnMinutes == limit ? "true" : "false")" @onclick="() => _maxOnMinutes = limit">@LimitLabel(limit)</button>
                        }
                    </div>
                    <p class="hint">@Texts["Relays.Detail.LimitHint"]</p>
                    @if (IsOn && RelaySettingsHandler.WouldTurnOffAtOnce(_runtime, _maxOnMinutes, Clock.UtcNow) && _maxOnMinutes != _relay.MaxOnMinutes)
                    {
                        <p class="warning">@Texts["Relays.Detail.LimitNow"]</p>
                    }
                </section>

                <section class="schedules">
                    <div class="section-head">
                        <h2>@Texts["Relays.Detail.Schedules"]</h2>
                        <a href="relay/@Id/schedule/new">@Texts["Common.Add"]</a>
                    </div>
                    @if (_schedules.Count == 0)
                    {
                        <p class="hint">@Texts["Relays.Detail.NoSchedules"]</p>
                    }
                    @foreach (var schedule in _schedules)
                    {
                        <div class="schedule" @key="schedule.Id">
                            <a href="schedule/@schedule.Id" class="schedule-text">
                                <span class="schedule-days">@ScheduleText.ShortDays(schedule.Days)</span>
                                <span class="schedule-times">@ScheduleText.Times(schedule.OnTime, schedule.OffTime)</span>
                            </a>
                            <button type="button"
                                    class="schedule-toggle"
                                    aria-pressed="@(schedule.IsEnabled ? "true" : "false")"
                                    aria-label="@($"{ScheduleText.ShortDays(schedule.Days)} {ScheduleText.Times(schedule.OnTime, schedule.OffTime)}")"
                                    disabled="@_busy"
                                    @onclick="() => SetEnabledAsync(schedule)">@Texts[schedule.IsEnabled ? "Common.Schedule.Active" : "Common.Schedule.Paused"]</button>
                        </div>
                    }
                </section>
                }

                @if (PowerOnAbility is { } powerOn)
                {
                    @* What the board does with the relay by itself when the power comes back (Issue #516): written to
                       the board only by Save, and only when the choice changed. *@
                    <section class="power-on">
                        <h2>@Texts["Relays.PowerOn.Heading"]</h2>
                        <p class="hint">@Texts["Relays.PowerOn.Hint"]</p>
                        @if (ReadPowerOn is null)
                        {
                            <p class="hint">@Texts["Relays.PowerOn.Unknown"]</p>
                        }
                        <div class="power-choices">
                            @foreach (var state in powerOn.States)
                            {
                                <button type="button" value="@state" aria-pressed="@(ChosenPowerOn == state ? "true" : "false")" disabled="@(!State.IsConnected || _busy)" @onclick="() => ChoosePowerOn(state)">
                                    <span class="power-name">@PowerOnName(state)</span>
                                    <span class="power-explain">@PowerOnExplanation(state)</span>
                                </button>
                            }
                        </div>
                        @if (!powerOn.PerRelay)
                        {
                            <p class="hint">@Texts["Relays.PowerOn.WholeBoard"]</p>
                        }
                        @if (!State.IsConnected)
                        {
                            <p class="hint">@Texts["Relays.PowerOn.NoContactNow"]</p>
                        }
                        @if (_powerOnError is not null)
                        {
                            <p class="error" role="alert">@_powerOnError</p>
                        }
                    </section>
                }

                <section class="events">
                    <div class="section-head">
                        <h2>@Texts["Common.Screen.Events"]</h2>
                        <a href="events">@Texts["Common.AllEvents"]</a>
                    </div>
                    @if (_events.Count == 0)
                    {
                        <p class="hint">@Texts["Relays.Detail.NoEvents"]</p>
                    }
                    else
                    {
                        <div class="list">
                            @foreach (var row in _events)
                            {
                                <div class="row @(row.View.IsAlert ? "alert" : null)" @key="row.Id">
                                    <span class="time">@row.TimestampLocal.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</span>
                                    <span class="badge @(row.View.IsPerson ? "person" : "automatic")" aria-hidden="true">@row.View.Badge</span>
                                    <div class="text">
                                        <EventWhat Row="row" />
                                        <span class="day">@Events.DayLabel(row.TimestampLocal)</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>
            </main>

            <div class="save">
                @if (_saveError is not null)
                {
                    <p class="error" role="alert">@_saveError</p>
                }
                else if (_powerOnError is not null)
                {
                    @* The power-cut field may be off screen from Save: the message itself is under its buttons. *@
                    <p class="error">@Texts["Relays.PowerOn.SeeAbove"]</p>
                }
                <button type="submit" disabled="@_busy">@Texts["Common.Save"]</button>
            </div>
        </form>
    }
</div>

<TabBar Current="TabBar.Tab.Relays" SideMenuOnly="true" />

@code {
    // The relay's own board: its state and relays. Unknown (never answered, no relays) until the relay is loaded.
    private int? BoardId { get; set; }

    private LiveBoard? Board => BoardId is { } id ? Registry.Find(id) : null;

    private BoardState State => Board?.State ?? BoardState.Initial;

    // "Reset" that went wrong.
    private string? _resetError;

    // "Reset": sets the relay the board controls by itself back to normal, as the person pressed, and logs it. Nothing
    // is queued without a connection.
    private async Task ResetAsync()
    {
        if (_user is null || _busy || Board is not { } board)
        {
            return;
        }

        _busy = true;
        _resetError = null;
        try
        {
            _resetError = await OwnRules.TurnOffAsync(board.BoardId, [new OwnRule(_channel, OwnRuleKind.InputLinkage)], _user.Email, CancellationToken.None);
        }
        catch (Exception ex)
        {
            // An exception that leaves the handler would end the page's live connection.
            Log.LogError(ex, "Resetting relay {RelayId} failed", Id);
            _resetError = Texts["Common.SomethingWrongTryAgain"];
        }
        finally
        {
            _busy = false;
        }
    }

    private BoardCapabilities Capabilities => Board?.Capabilities ?? LiveBoard.NoBoard;

    private bool _disposed;

    // The field "After a power cut": only for a board that has the ability, and not for a relay in a group, whose
    // state is set on the group's page.
    private PowerOnAbility? PowerOnAbility => _relay is not null && _group is null ? Capabilities.PowerOn : null;

    // The relay's state after a power cut as the board last reported it; null while it is unknown.
    private PowerOnState? ReadPowerOn => State.PowerOn?.For(_channel);

    // What the field shows from the board, null when there is no field; and what it showed when last drawn.
    private PowerOnState? ShownPowerOn => PowerOnAbility is null ? null : ReadPowerOn;
    private PowerOnState? _shownPowerOn;

    // The person's choice, until Save writes it; null while they haven't chosen.
    private PowerOnState? _powerOnChoice;

    private PowerOnState? ChosenPowerOn => _powerOnChoice ?? ReadPowerOn;

    // What Save writes to the board: the person's choice, only when it differs from what the board has.
    private PowerOnState? PowerOnToWrite => PowerOnAbility is not null && _powerOnChoice is { } choice && choice != ReadPowerOn ? choice : null;

    // A state after a power cut the board didn't take on Save.
    private string? _powerOnError;

    private string PowerOnName(PowerOnState state)
    {
        return state switch
        {
            PowerOnState.Off => Texts["Relays.PowerOn.State.Off"],
            PowerOnState.AsBefore => Texts["Relays.PowerOn.State.AsBefore"],
            PowerOnState.On => Texts["Relays.PowerOn.State.On"],
            _ => Texts["Relays.PowerOn.State.FollowsInput"],
        };
    }

    // What the board does by itself when the power comes back, without Contactor.
    private string PowerOnExplanation(PowerOnState state)
    {
        return state switch
        {
            PowerOnState.Off => Texts["Relays.PowerOn.Explain.Off"],
            PowerOnState.AsBefore => Texts["Relays.PowerOn.Explain.AsBefore"],
            PowerOnState.On => Texts["Relays.PowerOn.Explain.On"],
            _ => Texts["Relays.PowerOn.Explain.FollowsInput"],
        };
    }

    private void ChoosePowerOn(PowerOnState state)
    {
        if (_busy || !State.IsConnected)
        {
            return;
        }

        _powerOnChoice = state;
        _powerOnError = null;
    }

    // Writes the person's choice to the board at once, never queued, and logs it. Null when the board took it.
    private async Task<string?> SetPowerOnAsync(PowerOnState state)
    {
        try
        {
            var error = await PowerOn.SetAsync(Id, state, _user!.Email, CancellationToken.None);
            if (error is null)
            {
                // The board has it now, and its next state shows it.
                _powerOnChoice = null;
            }

            return error;
        }
        catch (Exception ex)
        {
            // An exception that leaves the handler would end the page's live connection.
            Log.LogError(ex, "Setting the state after a power cut of relay {RelayId} failed", Id);
            return Texts["Common.SomethingWrongTryAgain"];
        }
    }

    private const int EventCount = 4;

    private RelaySettings? _relay;
    private RelayRuntime? _runtime;
    private (int Id, string Name)? _group;
    private Dictionary<string, string> _names = [];
    private List<EventRow> _events = [];
    private List<ScheduleModel> _schedules = [];
    private RelayOutlook? _outlook;
    private SignedInUser? _user;
    private bool _loaded;
    private bool _busy;
    private bool _toggleFailed;

    // What the last press asked for, so "Try again" repeats it.
    private bool _wanted;
    private bool _inGroup;

    // The press was refused because the relay's board is being removed (BoardClosedException).
    private bool _beingRemoved;
    private string? _saveError;
    private string _name = "";
    private bool _isActive;
    private int? _maxOnMinutes;

    [Parameter]
    public int Id { get; set; }

    // Its channel on the board: the board's state goes by it, and it is the number shown. 0 until the relay is loaded.
    private int _channel;

    private bool IsOn => _channel >= 1 && _channel <= Capabilities.RelayCount && State.IsOn(_channel);

    private string StatusSentence
    {
        get
        {
            var onSince = _runtime?.OnSinceUtc is { } since ? Clock.ToLocal(since) : (DateTime?)null;
            var offAtUtc = _runtime?.TurnedOnBy == EventActors.Schedule ? _outlook?.RunningUntilUtc : _runtime?.AutoOffAtUtc;
            var autoOff = offAtUtc is { } offAt ? Clock.ToLocal(offAt) : (DateTime?)null;
            var (by, name) = WhoTurnedOn(_runtime?.TurnedOnBy);
            return StatusText.Sentence(IsOn, onSince, by, name, autoOff, Clock.Now);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _user = await CurrentUser.GetAsync();
        _relay = await Settings.GetAsync(Id, CancellationToken.None);
        _channel = _relay?.Channel ?? 0;
        BoardId = _relay?.BoardId;
        if (_relay is not null)
        {
            _name = _relay.Name;
            _isActive = _relay.IsActive;
            _maxOnMinutes = _relay.MaxOnMinutes;
            _powerOnChoice = null;
            _powerOnError = null;
            await LoadLiveAsync();
        }

        _loaded = true;
    }

    protected override void OnInitialized()
    {
        Registry.StateChanged += OnBoardChanged;
        Registry.OwnRulesChanged += OnBoardChanged;
        Registry.PowerOnChanged += OnPowerOnChanged;
        Changes.Changed += OnRelaysChanged;
    }

    public void Dispose()
    {
        _disposed = true;
        Registry.StateChanged -= OnBoardChanged;
        Registry.OwnRulesChanged -= OnBoardChanged;
        Registry.PowerOnChanged -= OnPowerOnChanged;
        Changes.Changed -= OnRelaysChanged;
    }

    // What others can change while the page is open; the form fields keep what the user typed.
    private async Task LoadLiveAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _runtime = await db.RelayRuntimes.AsNoTracking().SingleOrDefaultAsync(r => r.RelayId == Id);
        var group = await db.RelayGroupMembers.AsNoTracking()
            .Where(m => m.RelayId == Id)
            .Select(m => new { m.GroupId, m.Group!.Name })
            .SingleOrDefaultAsync();
        _group = group is null ? null : (group.GroupId, group.Name);
        _names = await ActorNames.LoadAsync(db, CancellationToken.None);
        _events = [.. await Events.GetAsync(EventFilter.All, beforeId: null, EventCount, CancellationToken.None, relayId: Id)];
        _schedules = [.. await Schedules.ListAsync(Id, CancellationToken.None)];
        _outlook = (await Outlook.GetAsync(CancellationToken.None)).GetValueOrDefault(Id);
    }

    // Who turned the relay on, for the status sentence: the viewer, a schedule, outside the app, or someone or an
    // input by name.
    private (TurnedOnBy By, string? Name) WhoTurnedOn(string? email)
    {
        return email switch
        {
            null => (TurnedOnBy.Nobody, null),
            _ when email == _user?.Email => (TurnedOnBy.You, null),
            EventActors.Schedule => (TurnedOnBy.Schedule, null),
            EventActors.External => (TurnedOnBy.Outside, null),
            _ when _names.TryGetValue(email, out var name) => (TurnedOnBy.Named, name),

            // An input that is no longer in the app (a removed board's) has no name, and isn't an e-mail.
            _ when EventActors.TryInput(email, out _) => (TurnedOnBy.Named, Texts["Relays.By.RemovedInput"]),
            _ => (TurnedOnBy.Named, IdentityRules.DisplayNameFor(email)),
        };
    }

    private string LimitLabel(int? minutes)
    {
        return minutes is { } m ? Texts["Common.Hours", m / 60] : Texts["Common.Never"];
    }

    private Task ToggleAsync()
    {
        return SwitchAsync(!IsOn);
    }

    private async Task SwitchAsync(bool on)
    {
        if (_user is null || _busy)
        {
            return;
        }

        _busy = true;
        _toggleFailed = false;
        _wanted = on;
        try
        {
            if (on)
            {
                await Control.TurnOnAsync(Id, _user.Email, CancellationToken.None);
            }
            else
            {
                await Control.TurnOffAsync(Id, _user.Email, CancellationToken.None);
            }
        }
        catch (BoardClosedException)
        {
            _toggleFailed = true;
            _inGroup = false;
            _beingRemoved = true;
        }
        catch (BoardNotConnectedException)
        {
            _toggleFailed = true;
            _inGroup = false;
            _beingRemoved = false;
        }
        catch (RelayInGroupException)
        {
            _toggleFailed = true;
            _inGroup = true;
            _beingRemoved = false;
        }
        catch (RelayUnavailableException)
        {
            // The board took it over meanwhile: the page shows it as unavailable, with "Reset".
            _toggleFailed = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetEnabledAsync(ScheduleModel schedule)
    {
        if (_user is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await Schedules.SetEnabledAsync(schedule.Id, !schedule.IsEnabled, _user.Email, CancellationToken.None);
            await LoadLiveAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_user is null || _relay is null || _busy)
        {
            return;
        }

        _busy = true;
        _powerOnError = null;
        try
        {
            _saveError = await Settings.SaveAsync(new RelaySettings(Id, _name, _isActive, _maxOnMinutes), _user.Email, CancellationToken.None);
            if (_saveError is null && PowerOnToWrite is { } state)
            {
                _powerOnError = await SetPowerOnAsync(state);
            }
        }
        finally
        {
            _busy = false;
        }

        // A state the board didn't take keeps the page open with its message; the rest was saved.
        if (_saveError is null && _powerOnError is null)
        {
            Navigation.NavigateTo("");
        }
    }

    // Any board's new state: only the page's own board's is redrawn.
    private void OnBoardChanged(object? sender, BoardStateChange change)
    {
        if (change.BoardId != BoardId)
        {
            return;
        }

        _ = RefreshAsync(reload: false);
    }

    // Only the relays' states after a power cut changed, on any board: a redraw only when the field would show another.
    private void OnPowerOnChanged(object? sender, BoardStateChange change)
    {
        if (change.BoardId != BoardId)
        {
            return;
        }

        _ = RedrawForPowerOnAsync();
    }

    private async Task RedrawForPowerOnAsync()
    {
        using var language = Language.Use();
        try
        {
            await InvokeAsync(() =>
            {
                // On the page's own thread, as Dispose is: a closed page draws nothing.
                if (!_disposed && ShownPowerOn != _shownPowerOn)
                {
                    StateHasChanged();
                }
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the change was on its way.
        }
    }

    private void OnRelaysChanged(object? sender, EventArgs e)
    {
        _ = RefreshAsync(reload: true);
    }

    private async Task RefreshAsync(bool reload)
    {
        using var language = Language.Use();
        try
        {
            await InvokeAsync(async () =>
            {
                if (reload && _relay is not null)
                {
                    await LoadLiveAsync();
                }

                // The board shows the relay as the person wanted it: nothing left to decide.
                if (_toggleFailed && !_inGroup && new UnconfirmedPress(Id, _channel, _wanted).IsSettledBy(State))
                {
                    _toggleFailed = false;
                }

                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the update was on its way.
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Not shown to the person: the page keeps what it shows, and the next refresh tries again.
            Log.LogWarning(ex, "The page could not reload {What}", "the relay");
        }
    }
}
