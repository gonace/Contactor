@page "/relay/{Id:int}"
@implements IDisposable
@using Contactor.Boards
@using Microsoft.EntityFrameworkCore
@using Contactor.Web.Features.Boards
@using Contactor.Web.Features.Events
@using Contactor.Web.Features.Identity
@using Contactor.Web.Features.Relays
@using Contactor.Web.Features.Schedules
@using Contactor.Web.Persistence
@inject BoardRegistry Registry
@inject RelayControl Control
@inject RelaySettingsHandler Settings
@inject SchedulesHandler Schedules
@inject EventsHandler Events
@inject RelayChanges Changes
@inject CurrentUser CurrentUser
@inject LocalClock Clock
@inject ScheduleOutlook Outlook
@inject NavigationManager Navigation
@inject IDbContextFactory<ContactorDbContext> DbFactory

<PageTitle>@(_relay?.Name ?? "Relay") · Contactor</PageTitle>

<div class="screen">
    <header class="header">
        <a href="" class="back">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
            Relays
        </a>
        @if (_relay is not null)
        {
            @* On a desktop Save sits here, pinned to the top; on a phone and a tablet it is at the bottom of the form. *@
            <button type="submit" form="relay-form" class="save-top" disabled="@_busy">Save</button>
        }
    </header>

    @if (_loaded && _relay is null)
    {
        <main class="content">
            <p class="missing">The relay doesn't exist.</p>
        </main>
    }
    else if (_relay is not null)
    {
        <form id="relay-form" class="form" @onsubmit="SaveAsync">
            <main class="content">
                <div class="field">
                    <label for="name" class="label">RELAY @_channel · NAME</label>
                    <input id="name" type="text" maxlength="@Relay.NameMaxLength" @bind="_name" @bind:event="oninput" autocomplete="off" />
                    @if (_group is null)
                    {
                        <label for="active" class="check">
                            <input id="active" type="checkbox" @bind="_isActive" />
                            <span><strong>Active</strong>: shown in the list. Untick it for relays that aren't used.</span>
                        </label>
                    }
                </div>

                @if (_group is { } group)
                {
                    <section class="in-group">
                        <p>This relay is in the group <strong>@group.Name</strong> and is switched from there, in the group's order.</p>
                        <a href="group/@group.Id">Open the group</a>
                    </section>
                }
                else
                {
                @if (!State.HasAnswered)
                {
                    @* Before the board's first answer: unknown, all grey. *@
                    <section class="status unknown">
                        <p>@RelayStatusText.Waiting</p>
                        <button type="button" class="toggle unknown" aria-label="@RelayStatusText.Waiting" disabled>–</button>
                    </section>
                }
                else
                {
                <section class="status @(IsOn ? "on" : "")">
                    <p>@StatusSentence</p>
                    <button type="button" class="toggle" data-vibrate aria-pressed="@(IsOn ? "true" : "false")" disabled="@(!State.IsConnected || _busy)" @onclick="ToggleAsync">@(IsOn ? "TURN OFF" : "TURN ON")</button>
                    @if (_toggleFailed)
                    {
                        @if (_inGroup)
                        {
                            <p class="error" role="alert">@RelayInGroupException.Text</p>
                        }
                        else if (_beingRemoved)
                        {
                            <p class="error" role="alert">@LiveBoard.BeingRemoved</p>
                        }
                        else
                        {
                            @* A press the board didn't confirm: nothing is guessed or queued; the person decides. *@
                            <UnconfirmedBox CanTryAgain="@(State.IsConnected && !_busy)" OnTryAgain="() => SwitchAsync(_wanted)" OnLeave="() => _toggleFailed = false" />
                        }
                    }
                </section>
                }

                <section class="limits">
                    <h2>Turn off automatically after</h2>
                    <div class="choices">
                        @foreach (var limit in RelaySettingsHandler.Limits)
                        {
                            <button type="button" aria-pressed="@(_maxOnMinutes == limit ? "true" : "false")" @onclick="() => _maxOnMinutes = limit">@LimitLabel(limit)</button>
                        }
                    </div>
                    <p class="hint">Applies when someone turns the relay on by hand.</p>
                    @if (IsOn && RelaySettingsHandler.WouldTurnOffAtOnce(_runtime, _maxOnMinutes, Clock.UtcNow) && _maxOnMinutes != _relay.MaxOnMinutes)
                    {
                        <p class="warning">The relay has been on longer than that and turns off when you save.</p>
                    }
                </section>

                <section class="schedules">
                    <div class="section-head">
                        <h2>Schedules</h2>
                        <a href="relay/@Id/schedule/new">Add</a>
                    </div>
                    @if (_schedules.Count == 0)
                    {
                        <p class="hint">No schedules. Add one to turn the relay on at set times.</p>
                    }
                    @foreach (var schedule in _schedules)
                    {
                        <div class="schedule" @key="schedule.Id">
                            <a href="schedule/@schedule.Id" class="schedule-text">
                                <span class="schedule-days">@ScheduleText.ShortDays(schedule.Days)</span>
                                <span class="schedule-times">@ScheduleText.Times(schedule.OnTime, schedule.OffTime)</span>
                            </a>
                            <button type="button"
                                    class="schedule-toggle"
                                    aria-pressed="@(schedule.IsEnabled ? "true" : "false")"
                                    aria-label="@($"{ScheduleText.ShortDays(schedule.Days)} {ScheduleText.Times(schedule.OnTime, schedule.OffTime)}")"
                                    disabled="@_busy"
                                    @onclick="() => SetEnabledAsync(schedule)">@(schedule.IsEnabled ? "Active" : "Paused")</button>
                        </div>
                    }
                </section>
                }

                <section class="events">
                    <div class="section-head">
                        <h2>Events</h2>
                        <a href="events">All events</a>
                    </div>
                    @if (_events.Count == 0)
                    {
                        <p class="hint">Nothing has happened to this relay yet.</p>
                    }
                    else
                    {
                        <div class="list">
                            @foreach (var row in _events)
                            {
                                <div class="row @(row.View.IsAlert ? "alert" : null)" @key="row.Id">
                                    <span class="time">@row.TimestampLocal.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</span>
                                    <span class="badge @(row.View.IsPerson ? "person" : "automatic")" aria-hidden="true">@row.View.Badge</span>
                                    <div class="text">
                                        <EventWhat Row="row" />
                                        <span class="day">@Events.DayLabel(row.TimestampLocal)</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>
            </main>

            <div class="save">
                @if (_saveError is not null)
                {
                    <p class="error" role="alert">@_saveError</p>
                }
                <button type="submit" disabled="@_busy">Save</button>
            </div>
        </form>
    }
</div>

<TabBar Current="TabBar.Tab.Relays" SideMenuOnly="true" />

@code {
    // The relay's own board: its state and relays. Unknown (never answered, no relays) until the relay is loaded.
    private int? BoardId { get; set; }

    private LiveBoard? Board => BoardId is { } id ? Registry.Find(id) : null;

    private BoardState State => Board?.State ?? BoardState.Initial;

    private BoardCapabilities Capabilities => Board?.Capabilities ?? LiveBoard.NoBoard;

    private const int EventCount = 4;

    private RelaySettings? _relay;
    private RelayRuntime? _runtime;
    private (int Id, string Name)? _group;
    private Dictionary<string, string> _names = [];
    private List<EventRow> _events = [];
    private List<ScheduleModel> _schedules = [];
    private RelayOutlook? _outlook;
    private SignedInUser? _user;
    private bool _loaded;
    private bool _busy;
    private bool _toggleFailed;

    // What the last press asked for, so "Try again" repeats it.
    private bool _wanted;
    private bool _inGroup;

    // The press was refused because the relay's board is being removed (LiveBoard.BeingRemoved).
    private bool _beingRemoved;
    private string? _saveError;
    private string _name = "";
    private bool _isActive;
    private int? _maxOnMinutes;

    [Parameter]
    public int Id { get; set; }

    // Its channel on the board: the board's state goes by it, and it is the number shown. 0 until the relay is loaded.
    private int _channel;

    private bool IsOn => _channel >= 1 && _channel <= Capabilities.RelayCount && State.IsOn(_channel);

    private string StatusSentence
    {
        get
        {
            var onSince = _runtime?.OnSinceUtc is { } since ? Clock.ToLocal(since) : (DateTime?)null;
            var offAtUtc = _runtime?.TurnedOnBy == EventActors.Schedule ? _outlook?.RunningUntilUtc : _runtime?.AutoOffAtUtc;
            var autoOff = offAtUtc is { } offAt ? Clock.ToLocal(offAt) : (DateTime?)null;
            return RelayStatusText.Sentence(IsOn, onSince, NameOf(_runtime?.TurnedOnBy), autoOff, Clock.Now);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _user = await CurrentUser.GetAsync();
        _relay = await Settings.GetAsync(Id, CancellationToken.None);
        _channel = _relay?.Channel ?? 0;
        BoardId = _relay?.BoardId;
        if (_relay is not null)
        {
            _name = _relay.Name;
            _isActive = _relay.IsActive;
            _maxOnMinutes = _relay.MaxOnMinutes;
            await LoadLiveAsync();
        }

        _loaded = true;
    }

    protected override void OnInitialized()
    {
        Registry.StateChanged += OnBoardChanged;
        Changes.Changed += OnRelaysChanged;
    }

    public void Dispose()
    {
        Registry.StateChanged -= OnBoardChanged;
        Changes.Changed -= OnRelaysChanged;
    }

    // What others can change while the page is open; the form fields keep what the user typed.
    private async Task LoadLiveAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _runtime = await db.RelayRuntimes.AsNoTracking().SingleOrDefaultAsync(r => r.RelayId == Id);
        var group = await db.RelayGroupMembers.AsNoTracking()
            .Where(m => m.RelayId == Id)
            .Select(m => new { m.GroupId, m.Group!.Name })
            .SingleOrDefaultAsync();
        _group = group is null ? null : (group.GroupId, group.Name);
        _names = await ActorNames.LoadAsync(db, CancellationToken.None);
        _events = [.. await Events.GetAsync(EventFilter.All, beforeId: null, EventCount, CancellationToken.None, relayId: Id)];
        _schedules = [.. await Schedules.ListAsync(Id, CancellationToken.None)];
        _outlook = (await Outlook.GetAsync(CancellationToken.None)).GetValueOrDefault(Id);
    }

    private string? NameOf(string? email)
    {
        if (email is null)
        {
            return null;
        }

        if (email == _user?.Email)
        {
            return "you";
        }

        if (email == EventActors.Schedule)
        {
            return "schedule";
        }

        if (email == EventActors.External)
        {
            return "outside the app";
        }

        return _names.TryGetValue(email, out var name) ? name : IdentityRules.DisplayNameFor(email);
    }

    private static string LimitLabel(int? minutes)
    {
        return minutes is { } m ? $"{m / 60} h" : "Never";
    }

    private Task ToggleAsync()
    {
        return SwitchAsync(!IsOn);
    }

    private async Task SwitchAsync(bool on)
    {
        if (_user is null || _busy)
        {
            return;
        }

        _busy = true;
        _toggleFailed = false;
        _wanted = on;
        try
        {
            if (on)
            {
                await Control.TurnOnAsync(Id, _user.Email, CancellationToken.None);
            }
            else
            {
                await Control.TurnOffAsync(Id, _user.Email, CancellationToken.None);
            }
        }
        catch (BoardClosedException)
        {
            _toggleFailed = true;
            _inGroup = false;
            _beingRemoved = true;
        }
        catch (BoardNotConnectedException)
        {
            _toggleFailed = true;
            _inGroup = false;
            _beingRemoved = false;
        }
        catch (RelayInGroupException)
        {
            _toggleFailed = true;
            _inGroup = true;
            _beingRemoved = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetEnabledAsync(ScheduleModel schedule)
    {
        if (_user is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await Schedules.SetEnabledAsync(schedule.Id, !schedule.IsEnabled, _user.Email, CancellationToken.None);
            await LoadLiveAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_user is null || _relay is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            _saveError = await Settings.SaveAsync(new RelaySettings(Id, _name, _isActive, _maxOnMinutes), _user.Email, CancellationToken.None);
        }
        finally
        {
            _busy = false;
        }

        if (_saveError is null)
        {
            Navigation.NavigateTo("");
        }
    }

    // Any board's new state: only the page's own board's is redrawn.
    private void OnBoardChanged(object? sender, BoardStateChange change)
    {
        if (change.BoardId != BoardId)
        {
            return;
        }

        _ = RefreshAsync(reload: false);
    }

    private void OnRelaysChanged(object? sender, EventArgs e)
    {
        _ = RefreshAsync(reload: true);
    }

    private async Task RefreshAsync(bool reload)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (reload && _relay is not null)
                {
                    await LoadLiveAsync();
                }

                // The board shows the relay as the person wanted it: nothing left to decide.
                if (_toggleFailed && !_inGroup && new UnconfirmedPress(Id, _channel, _wanted).IsSettledBy(State))
                {
                    _toggleFailed = false;
                }

                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the update was on its way.
        }
    }
}
