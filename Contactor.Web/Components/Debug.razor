@page "/debug"
@implements IDisposable
@using System.Globalization
@using Contactor.Boards
@using Contactor.Web.Features.Boards
@using Contactor.Web.Features.Relays
@using Contactor.Web.Persistence
@using Microsoft.EntityFrameworkCore
@inject BoardRegistry Registry
@inject LocalClock Clock
@inject RelayChanges Changes
@inject IDbContextFactory<ContactorDbContext> DbFactory

<PageTitle>Debug · Contactor</PageTitle>

<div class="screen">
    <header class="header">
        <h1>Debug</h1>
        @if (Several)
        {
            <p class="hint">
                Everything sent to and from the relay boards since the app started, newest first. At most @BoardTrace.Capacity
                lines; nothing is stored.
            </p>
            @* Which boards' traffic shows: this browser's, in its own cookie (RelaysEndpoints). *@
            <div class="boards-bar">
                <BoardPicker Screen="BoardFilterScreen.Debug" Boards="Boards" Filter="BoardsFilter" Counts="_counts" Plain="true" Showing="@ShowingText" />
            </div>
        }
        else
        {
            <p class="hint">
                Everything sent to and from the relay board since the app started, newest first. At most @BoardTrace.Capacity
                lines; nothing is stored. Board: <span class="mono">@Boards.FirstOrDefault()?.Endpoint</span>
            </p>
        }
        @if (_routineLeftOut > 0)
        {
            <p class="hint">@_routineLeftOut.ToString("N0", CultureInfo.InvariantCulture) routine @(_routineLeftOut == 1 ? "step" : "steps") left out, such as status checks that changed nothing.</p>
        }
        <button type="button" class="clear" disabled="@(_items.Count == 0)" @onclick="Clear">Clear</button>
    </header>

    <main class="list">
        @if (_items.Count == 0)
        {
            <p class="empty">No traffic yet.</p>
        }

        @foreach (var (board, item) in _items)
        {
            <div class="row @(item.IsError ? "error" : null)" @key="(board.BoardId, item.Id)">
                <span class="time">@Clock.ToLocal(item.AtUtc.UtcDateTime).ToString("HH:mm:ss", CultureInfo.InvariantCulture)</span>
                <span class="arrow" aria-label="@Direction(item)">@Arrow(item)</span>
                <div class="text">
                    <span>
                        @if (Several)
                        {
                            <span class="where">@board.Name</span>
                        }
                        @item.Text
                    </span>
                    @if (item.Hex is not null)
                    {
                        <span class="hex">@item.Hex</span>
                    }
                </div>
            </div>
        }
    </main>

    <TabBar Current="TabBar.Tab.Debug" SideList="@(Several ? BoardList : null)" />
</div>

@code {
    private BoardTraceWatch? _watch;
    private IReadOnlyList<(LiveBoard Board, BoardTraceItem Item)> _items = [];
    private long _routineLeftOut;
    private BoardCounts _counts = BoardCounts.None;

    /// <summary>The boards this browser picked to show (<see cref="BoardFilters.Debug"/>), as the page was opened.</summary>
    [CascadingParameter]
    public BoardFilters? PickedBoards { get; set; }

    private IReadOnlyList<LiveBoard> Boards => Registry.All;

    // Two or more boards: the board filter, and each row names its board. One board looks as it always did.
    private bool Several => Boards.Count > 1;

    private BoardFilter BoardsFilter => (PickedBoards?.Debug ?? BoardFilter.All).For([.. Boards.Select(b => b.BoardId)]);

    private IEnumerable<LiveBoard> ShownBoards => Boards.Where(b => BoardsFilter.Shows(b.BoardId));

    // "Showing Workshop and Paint shop" while filtered.
    private string? ShowingText => BoardsFilter.IsAll ? null : BoardsText.Showing([.. ShownBoards.Select(b => b.Name)]);

    protected override async Task OnInitializedAsync()
    {
        Read();
        _watch = new BoardTraceWatch(Registry, added: null, changed: OnChanged);
        Registry.StateChanged += OnBoardChanged;
        Changes.Changed += OnRelaysChanged;
        Registry.BoardsChanged += OnRelaysChanged;
        await LoadCountsAsync();
    }

    public void Dispose()
    {
        _watch?.Dispose();
        Registry.StateChanged -= OnBoardChanged;
        Changes.Changed -= OnRelaysChanged;
        Registry.BoardsChanged -= OnRelaysChanged;
    }

    // The desktop's side menu: every board, to pick which to show.
    private RenderFragment BoardList => __builder =>
    {
        <BoardPicker Side="true" Screen="BoardFilterScreen.Debug" Boards="Boards" Filter="BoardsFilter" Counts="_counts" />
    };

    // The newest steps of every shown board, merged by time, at most a trace's capacity in all, so the work and the page
    // stay the same size however many boards there are. Each trace is newest first: one pass takes the newest head each
    // time; at the same time, the board listed first.
    private void Read()
    {
        var shown = ShownBoards.ToList();
        var lists = shown.Select(board => (Board: board, Items: board.Trace.Items)).ToList();
        var next = new int[lists.Count];
        var items = new List<(LiveBoard Board, BoardTraceItem Item)>(BoardTrace.Capacity);
        while (items.Count < BoardTrace.Capacity)
        {
            var newest = -1;
            for (var i = 0; i < lists.Count; i++)
            {
                if (next[i] < lists[i].Items.Count
                    && (newest < 0 || lists[i].Items[next[i]].AtUtc > lists[newest].Items[next[newest]].AtUtc))
                {
                    newest = i;
                }
            }

            if (newest < 0)
            {
                break;
            }

            items.Add((lists[newest].Board, lists[newest].Items[next[newest]++]));
        }

        _items = items;
        _routineLeftOut = shown.Sum(b => b.Trace.RoutineLeftOut);
    }

    // Only the boards shown: the others' traffic stays.
    private void Clear()
    {
        foreach (var board in ShownBoards)
        {
            board.Trace.Clear();
        }
    }

    // "3 of 8 on" for the board filter; only with several boards, which is when it shows.
    private async Task LoadCountsAsync()
    {
        if (!Several)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        _counts = await BoardCounts.LoadAsync(db, Registry, CancellationToken.None);
    }

    private static string Arrow(BoardTraceItem item)
    {
        return item.Direction switch
        {
            BoardTraceDirection.Sent => "→",
            BoardTraceDirection.Received => "←",
            _ => "·",
        };
    }

    private static string Direction(BoardTraceItem item)
    {
        return item.Direction switch
        {
            BoardTraceDirection.Sent => "to the board",
            BoardTraceDirection.Received => "from the board",
            _ => "connection",
        };
    }

    // From a board's connection loop, a timer, Clear, or a board added.
    private void OnChanged()
    {
        _ = RefreshAsync(counts: false);
    }

    // A board's new state: only the board filter's lamps and counts show it.
    private void OnBoardChanged(object? sender, BoardStateChange change)
    {
        if (Several)
        {
            _ = RefreshAsync(counts: false);
        }
    }

    // A relay, a group or the boards changed: the board filter's counts.
    private void OnRelaysChanged(object? sender, EventArgs e)
    {
        _ = RefreshAsync(counts: true);
    }

    private async Task RefreshAsync(bool counts)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                Read();
                if (counts)
                {
                    await LoadCountsAsync();
                }

                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the update was on its way.
        }
    }
}
