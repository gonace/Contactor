@page "/debug"
@implements IDisposable
@using System.Globalization
@using Contactor.Boards
@using Contactor.Web.Features.Boards
@inject BoardTrace Trace
@inject IBoardConnection Connection
@inject LocalClock Clock

<PageTitle>Debug · Contactor</PageTitle>

<div class="screen">
    <header class="header">
        <h1>Debug</h1>
        <p class="hint">
            Everything sent to and from the relay board since the app started, newest first. At most @BoardTrace.Capacity
            lines; nothing is stored. Board: <span class="mono">@Connection.Endpoint</span>
        </p>
        @if (_routineLeftOut > 0)
        {
            <p class="hint">@_routineLeftOut.ToString("N0", CultureInfo.InvariantCulture) routine @(_routineLeftOut == 1 ? "step" : "steps") left out: status requests and answers that changed nothing.</p>
        }
        <button type="button" class="clear" disabled="@(_items.Count == 0)" @onclick="Clear">Clear</button>
    </header>

    <main class="list">
        @if (_items.Count == 0)
        {
            <p class="empty">No traffic yet.</p>
        }

        @foreach (var item in _items)
        {
            <div class="row @(item.IsError ? "error" : null)" @key="item.Id">
                <span class="time">@Clock.ToLocal(item.AtUtc.UtcDateTime).ToString("HH:mm:ss", CultureInfo.InvariantCulture)</span>
                <span class="arrow" aria-label="@Direction(item)">@Arrow(item)</span>
                <div class="text">
                    <span>@item.Text</span>
                    @if (item.Hex is not null)
                    {
                        <span class="hex">@item.Hex</span>
                    }
                </div>
            </div>
        }
    </main>

    <TabBar Current="TabBar.Tab.Debug" />
</div>

@code {
    private IReadOnlyList<BoardTraceItem> _items = [];
    private long _routineLeftOut;

    protected override void OnInitialized()
    {
        _items = Trace.Items;
        _routineLeftOut = Trace.RoutineLeftOut;
        Trace.Added += OnChanged;
        Trace.Cleared += OnChanged;
    }

    public void Dispose()
    {
        Trace.Added -= OnChanged;
        Trace.Cleared -= OnChanged;
    }

    private void Clear()
    {
        Trace.Clear();
    }

    private static string Arrow(BoardTraceItem item)
    {
        return item.Direction switch
        {
            BoardTraceDirection.Sent => "→",
            BoardTraceDirection.Received => "←",
            _ => "·",
        };
    }

    private static string Direction(BoardTraceItem item)
    {
        return item.Direction switch
        {
            BoardTraceDirection.Sent => "to the board",
            BoardTraceDirection.Received => "from the board",
            _ => "connection",
        };
    }

    // From the board connection's loop, or from Clear.
    private void OnChanged(object? sender, object e)
    {
        _ = RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        try
        {
            await InvokeAsync(() =>
            {
                _items = Trace.Items;
                _routineLeftOut = Trace.RoutineLeftOut;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The page closed while the update was on its way.
        }
    }
}
