@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Contactor.Web.Components
@using Microsoft.Extensions.Localization
@using Contactor.Web.Resources
@* The UI's texts, in every component. *@
@inject IStringLocalizer<Texts> Texts
@using Contactor.Web.Features.Events
@using Contactor.Web.Features.Schedules
@* The event and schedule words several screens show, e.g. a length ("5 min") or a schedule's days ("Mon–Fri"). The
   property has the class's name, so its static helpers (EventText.IsPersonActor) are reached the same way. *@
@inject EventText EventText
@inject ScheduleText ScheduleText
