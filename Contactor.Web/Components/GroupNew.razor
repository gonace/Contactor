@page "/grupp/ny"
@using Contactor.Web.Features.Events
@using Contactor.Web.Features.Groups
@using Contactor.Web.Features.Identity
@using Contactor.Web.Persistence
@inject GroupsHandler Groups
@inject CurrentUser CurrentUser
@inject NavigationManager Navigation
@inject ILogger<GroupNew> Log

<PageTitle>Ny grupp · Contactor</PageTitle>

<div class="screen">
    <header class="header">
        @if (_wizard.Step == 1)
        {
            <a href="" class="back">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
                Avbryt
            </a>
        }
        else
        {
            var shown = _wizard.Step;
            <button type="button" class="back" disabled="@_busy" @onclick="() => Back(shown)">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
                Tillbaka
            </button>
        }
        <span class="step-count">STEG @_wizard.Step AV @GroupWizard.StepCount</span>
    </header>

    <div class="progress" aria-hidden="true">
        @for (var i = 1; i <= GroupWizard.StepCount; i++)
        {
            <span class="@(i <= _wizard.Step ? "done" : null)"></span>
        }
    </div>

    <main class="content">
        <div class="intro">
            <h1 tabindex="-1" @ref="_heading">@Titles[_wizard.Step - 1].Title</h1>
            <p>@Titles[_wizard.Step - 1].Lead</p>
        </div>

        @if (_wizard.Step == 1)
        {
            <div class="field">
                <label for="name">Namn</label>
                <input id="name" type="text" maxlength="@RelayGroup.NameMaxLength" placeholder="T.ex. Värmefläkt – Svarven" @bind="_wizard.Name" @bind:event="oninput" autocomplete="off" />
            </div>
            <fieldset class="field">
                <legend>Ikon</legend>
                <IconPicker @bind-Value="_wizard.Icon" />
            </fieldset>
        }
        else if (_wizard.Step == 2)
        {
            <div class="options">
                <p class="count" role="status">@SelectedText</p>
                @foreach (var relay in _candidates)
                {
                    var order = _wizard.OrderOf(relay.RelayId);
                    <button type="button"
                            role="checkbox"
                            class="option"
                            aria-checked="@(order > 0 ? "true" : "false")"
                            disabled="@(!relay.IsFree)"
                            @onclick="() => Pick(relay)">
                        <span class="box" aria-hidden="true">
                            @if (order > 0)
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"></path></svg>
                            }
                        </span>
                        <span class="option-text">
                            <span class="label">RELÄ @relay.RelayId</span>
                            <span class="name">@relay.Name</span>
                            <span class="note">@relay.Note</span>
                        </span>
                        @if (order > 0)
                        {
                            <span class="order-number">#@order</span>
                        }
                    </button>
                }
            </div>
        }
        else if (_wizard.Step == 3)
        {
            var members = _wizard.Members;
            <ol class="steps">
                @for (var i = 0; i < members.Count; i++)
                {
                    var index = i;
                    var member = members[index];
                    var label = LabelOf(member);
                    <li @key="member.RelayId">
                        <div class="step">
                            <span class="number" aria-hidden="true">@(index + 1)</span>
                            <div class="step-text">
                                <label class="label" for="@($"role-{member.RelayId}")">RELÄ @member.RelayId · NAMN I GRUPPEN</label>
                                <input id="@($"role-{member.RelayId}")" type="text" maxlength="@RelayGroupMember.RoleNameMaxLength" @bind="member.RoleName" @bind:event="oninput" autocomplete="off" />
                            </div>
                            <div class="order">
                                <button type="button" aria-label="@($"Flytta upp {label}")" disabled="@(index == 0)" @onclick="() => _wizard.Move(index, -1)">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6"></path></svg>
                                </button>
                                <button type="button" aria-label="@($"Flytta ner {label}")" disabled="@(index == members.Count - 1)" @onclick="() => _wizard.Move(index, 1)">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                                </button>
                            </div>
                        </div>
                        @if (index < members.Count - 1)
                        {
                            var below = members[index + 1];
                            <div class="gap" role="group" aria-label="@($"Mellan {label} och {LabelOf(below)}")">
                                <label>
                                    Vid start, vänta
                                    <select @bind="below.StartDelaySec">
                                        @foreach (var seconds in GroupsHandler.StartDelayChoices)
                                        {
                                            <option value="@seconds">@EventText.Seconds(seconds)</option>
                                        }
                                    </select>
                                </label>
                                <label>
                                    Vid stopp, eftergång
                                    <select @bind="member.RunOnSec">
                                        @foreach (var seconds in GroupsHandler.RunOnChoices)
                                        {
                                            <option value="@seconds">@(seconds == 0 ? "Ingen" : EventText.Seconds(seconds))</option>
                                        }
                                    </select>
                                </label>
                            </div>
                        }
                    </li>
                }
            </ol>
            <p class="info">Spärr: ett relä kan bara vara på när reläet ovanför är på. Slås det på ändå, t.ex. via kortet, stänger appen av det direkt.</p>
        }
        else
        {
            var draft = _wizard.Draft;
            <span class="label">SÅ HÄR SER DEN UT I LISTAN</span>
            <div class="preview">
                <span class="icon" aria-hidden="true"><GroupIcon Icon="@draft.Icon" /></span>
                <span class="preview-text">
                    <span class="label">GRUPP · RELÄ @string.Join(" → ", draft.Members.Select(m => m.RelayId))</span>
                    <span class="name">@draft.Name.Trim()</span>
                    <span class="note">Av</span>
                </span>
                <span class="off" aria-hidden="true">AV</span>
            </div>
            <dl class="plan">
                <div>
                    <dt class="label">NÄR GRUPPEN SLÅS PÅ</dt>
                    <dd>@GroupPlanText.Start(draft.Members)</dd>
                </div>
                <div>
                    <dt class="label">NÄR GRUPPEN STÄNGS AV</dt>
                    <dd>@GroupPlanText.Stop(draft.Members)</dd>
                </div>
                <div>
                    <dt class="label">SPÄRR</dt>
                    <dd>@GroupPlanText.Interlock(draft.Members)</dd>
                </div>
                <div>
                    <dt class="label">STÄNGS AV AUTOMATISKT</dt>
                    <dd>Efter @EventText.Duration(RelayGroup.DefaultMaxOnMinutes). Det kan ändras på gruppens sida.</dd>
                </div>
            </dl>
        }
    </main>

    <div class="next">
        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }
        @if (_wizard.Step < GroupWizard.StepCount)
        {
            var shown = _wizard.Step;
            <button type="button" disabled="@(!_wizard.CanGoOn)" @onclick="() => GoOn(shown)">Nästa</button>
        }
        else
        {
            <button type="button" class="create" disabled="@_busy" @onclick="CreateAsync">Skapa grupp</button>
        }
    </div>
</div>

@code {
    private static readonly (string Title, string Lead)[] Titles =
    [
        ("Namn och ikon", "Ikonen visas på gruppens kort i reläistan."),
        ("Vilka reläer ingår?", "Välj två eller fler. Ordningen du väljer i blir startordningen, den kan ändras i nästa steg."),
        ("Ordning och regler", "Gruppen startar uppifrån och stängs av nerifrån. Ställ in väntetiden mellan stegen."),
        ("Granska och skapa", "Kontrollera att det blir som du tänkt."),
    ];

    private readonly GroupWizard _wizard = new();
    private IReadOnlyList<GroupCandidate> _candidates = [];
    private ElementReference _heading;
    private SignedInUser? _user;
    private string? _error;
    private bool _busy;
    private bool _moved;

    private string SelectedText => _wizard.Members.Count switch
    {
        0 => "Inga valda än",
        < RelayGroup.MinMembers => $"{_wizard.Members.Count} vald · välj minst {RelayGroup.MinMembers}",
        _ => $"{_wizard.Members.Count} valda",
    };

    protected override async Task OnInitializedAsync()
    {
        _user = await CurrentUser.GetAsync();
        _candidates = await Groups.CandidatesAsync(CancellationToken.None);
    }

    // A new step's heading takes the focus, so a screen reader reads where it is.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_moved)
        {
            _moved = false;
            await _heading.FocusAsync();
        }
    }

    private static string LabelOf(WizardMember member)
    {
        return string.IsNullOrWhiteSpace(member.RoleName) ? $"relä {member.RelayId}" : member.RoleName;
    }

    private void Pick(GroupCandidate relay)
    {
        if (relay.IsFree || _wizard.OrderOf(relay.RelayId) > 0)
        {
            _wizard.Toggle(relay.RelayId, relay.Name);
        }
    }

    private void GoOn(int fromStep)
    {
        if (_wizard.GoOn(fromStep))
        {
            _error = null;
            _moved = true;
        }
    }

    private void Back(int fromStep)
    {
        if (!_busy && _wizard.Back(fromStep))
        {
            _error = null;
            _moved = true;
        }
    }

    private async Task CreateAsync()
    {
        if (_user is null || _busy || _wizard.Step != GroupWizard.StepCount)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var (id, error) = await Groups.CreateAsync(_wizard.Draft, _user.Email, CancellationToken.None);
            _error = error;
            if (id is not null)
            {
                Navigation.NavigateTo("");
            }
        }
        catch (Exception ex)
        {
            // An exception that leaves the handler would end the page's live connection.
            Log.LogError(ex, "Creating a group failed");
            _error = "Något gick fel. Försök igen.";
        }
        finally
        {
            _busy = false;
        }
    }
}
