@page "/group/new"
@using System.Globalization
@using Contactor.Web.Features.Boards
@using Contactor.Web.Features.Events
@using Contactor.Web.Features.Groups
@using Contactor.Web.Features.Identity
@using Contactor.Web.Persistence
@inject GroupsHandler Groups
@inject BoardRegistry Registry
@inject CurrentUser CurrentUser
@inject NavigationManager Navigation
@inject ILogger<GroupNew> Log
@inject GroupPlanText Plan

<PageTitle>@(Texts["Common.PageTitle", Texts["Common.Screen.NewGroup"]])</PageTitle>

<div class="screen">
    <header class="header">
        @if (_wizard.Step == 1)
        {
            <a href="" class="back">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
                @Texts["Common.Cancel"]
            </a>
        }
        else
        {
            var shown = _wizard.Step;
            <button type="button" class="back" disabled="@_busy" @onclick="() => Back(shown)">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
                @Texts["Common.Back"]
            </button>
        }
        <span class="step-count">@Texts["Groups.New.Step", _wizard.Step, GroupWizard.StepCount]</span>
    </header>

    <div class="progress" aria-hidden="true">
        @for (var i = 1; i <= GroupWizard.StepCount; i++)
        {
            <span class="@(i <= _wizard.Step ? "done" : null)"></span>
        }
    </div>

    <main class="content">
        <div class="intro">
            <h1 tabindex="-1" @ref="_heading">@Texts[Steps[_wizard.Step - 1].Title]</h1>
            <p>@Texts[Steps[_wizard.Step - 1].Lead]</p>
        </div>

        @if (_wizard.Step == 1)
        {
            <div class="field">
                <label for="name">@Texts["Groups.New.Name"]</label>
                <input id="name" type="text" maxlength="@RelayGroup.NameMaxLength" placeholder="@Texts["Groups.New.NameExample"]" @bind="_wizard.Name" @bind:event="oninput" autocomplete="off" />
            </div>
            <fieldset class="field">
                <legend>@Texts["Groups.Icon"]</legend>
                <IconPicker @bind-Value="_wizard.Icon" />
            </fieldset>
        }
        else if (_wizard.Step == 2)
        {
            <div class="options">
                <p class="count" role="status">@SelectedText</p>
                @if (Several)
                {
                    @* With two or more boards: a section per board, in the boards' order, under its name. A group's relays
                       are all on one board, so once one is picked the other boards' relays wait. *@
                    @foreach (var board in Registry.Shown)
                    {
                        var relays = _candidates.Where(c => c.BoardId == board.BoardId).ToList();
                        if (relays.Count == 0)
                        {
                            continue;
                        }

                        <section class="board-options" aria-labelledby="@($"board-{board.BoardId}")" @key="board.BoardId">
                            <div class="board-head">
                                <h2 class="board-name" id="@($"board-{board.BoardId}")">@board.Name</h2>
                                <span class="model">@(board.Model?.Name ?? "")</span>
                            </div>
                            @if (!_wizard.FitsBoard(board.BoardId))
                            {
                                <p class="other-board">@Texts["Groups.OneBoard"]</p>
                            }
                            @foreach (var relay in relays)
                            {
                                @Option(relay)
                            }
                        </section>
                    }
                }
                else
                {
                    @foreach (var relay in _candidates)
                    {
                        @Option(relay)
                    }
                }
            </div>
        }
        else if (_wizard.Step == 3)
        {
            @if (BoardLabel is { } onBoard)
            {
                <p class="on-board label">@Texts["Groups.New.OnBoard", onBoard]</p>
            }
            @* The same step cards as the group's page: a relay can join a step or the step above, be added or removed, and a whole step moves. *@
            <div class="steps-editor">
                <GroupStepsEditor Editor="_wizard.Editor"
                                  CanAdd="Addable.Count > 0"
                                  Addable="Addable"
                                  OnMove="m => _wizard.Move(m.Step, m.By)"
                                  OnRemove="_wizard.Remove"
                                  OnJoin="_wizard.JoinStepAbove"
                                  OnAdd="AddRelay" />
            </div>
            <p class="info">@Texts["Groups.New.Interlock"]</p>
        }
        else
        {
            var draft = _wizard.Draft;
            <span class="label">@Texts["Groups.New.Preview"]</span>
            <div class="preview">
                <span class="icon" aria-hidden="true"><GroupIcon Icon="@draft.Icon" /></span>
                <span class="preview-text">
                    <span class="label">@PreviewLabel()</span>
                    <span class="name">@draft.Name.Trim()</span>
                    <span class="note">@Texts["Groups.Status.Off"]</span>
                </span>
                <span class="off" aria-hidden="true">@Texts["Common.Switch.Off"]</span>
            </div>
            <dl class="plan">
                <div>
                    <dt class="label">@Texts["Groups.New.WhenOn"]</dt>
                    <dd>@Plan.Start(_wizard.StepDrafts)</dd>
                </div>
                <div>
                    <dt class="label">@Texts["Groups.New.WhenOff"]</dt>
                    <dd>@Plan.Stop(_wizard.StepDrafts)</dd>
                </div>
                <div>
                    <dt class="label">@Texts["Groups.New.Interlock.Label"]</dt>
                    <dd>@Plan.Interlock(_wizard.StepDrafts)</dd>
                </div>
                <div>
                    <dt class="label">@Texts["Groups.New.AutoOff"]</dt>
                    <dd>@Texts["Groups.New.AutoOffAfter", EventText.Duration(RelayGroup.DefaultMaxOnMinutes)]</dd>
                </div>
            </dl>
        }
    </main>

    <div class="next">
        @if (_error is not null)
        {
            <p class="error" role="alert">@_error</p>
        }
        @if (_wizard.Step < GroupWizard.StepCount)
        {
            var shown = _wizard.Step;
            <button type="button" disabled="@(!_wizard.CanGoOn)" @onclick="() => GoOn(shown)">@Texts["Common.Next"]</button>
        }
        else
        {
            <button type="button" class="create" disabled="@_busy" @onclick="CreateAsync">@Texts["Groups.New.Create"]</button>
        }
    </div>
</div>

<TabBar Current="TabBar.Tab.Relays" SideMenuOnly="true" />

@code {
    // Each step's heading and the line under it, as keys of Texts.
    private static readonly (string Title, string Lead)[] Steps =
    [
        ("Groups.New.Title1", "Groups.New.Lead1"),
        ("Groups.New.Title2", "Groups.New.Lead2"),
        ("Groups.New.Title3", "Groups.New.Lead3"),
        ("Groups.New.Title4", "Groups.New.Lead4"),
    ];

    private readonly GroupWizard _wizard = new();

    // A relay to pick on "Which relays?".
    private RenderFragment Option(GroupCandidate relay) => __builder =>
    {
        var order = _wizard.OrderOf(relay.RelayId);
        <button type="button"
                id="@($"pick-{relay.RelayId}")"
                role="checkbox"
                class="option"
                aria-checked="@(order > 0 ? "true" : "false")"
                disabled="@(!relay.IsFree || (order == 0 && !_wizard.FitsBoard(relay.BoardId)))"
                @onclick="() => Pick(relay)">
            <span class="box" aria-hidden="true">
                @if (order > 0)
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"></path></svg>
                }
            </span>
            <span class="option-text">
                <span class="label">@Texts["Relays.RelayLabel", relay.Channel]</span>
                <span class="name">@relay.Name</span>
                <span class="note">@Plan.Note(relay)</span>
            </span>
            @if (order > 0)
            {
                <span class="order-number">#@order</span>
            }
        </button>
    };

    // Two or more boards: "Which relays?" is grouped by board, and the group's board is named.
    private bool Several => Registry.Shown.Count > 1;

    // The picked relays' board, in capitals, for "GROUP · WORKSHOP 1 → 2"; null with one board.
    private string? BoardLabel => Several && _wizard.BoardId is { } id && Registry.Find(id) is { } board ? board.Name.ToUpperInvariant() : null;
    private IReadOnlyList<GroupCandidate> _candidates = [];

    // What "+ Add a relay to this step" and "+ Add a step" offer: the free relays of the group's board not picked yet,
    // by channel, as step 2 offers them.
    private IReadOnlyList<EditRelay> Addable =>
        [.. _candidates
            .Where(c => c.IsFree && _wizard.FitsBoard(c.BoardId) && _wizard.OrderOf(c.RelayId) == 0)
            .OrderBy(c => c.Channel)
            .Select(c => new EditRelay(c.RelayId, c.Channel, c.Name))];
    private ElementReference _heading;
    private SignedInUser? _user;
    private string? _error;
    private bool _busy;
    private bool _moved;

    private string SelectedText => _wizard.RelayCount switch
    {
        0 => Texts["Groups.New.NoneChosen"],
        < RelayGroup.MinMembers => Texts["Groups.New.ChosenTooFew", _wizard.RelayCount, RelayGroup.MinMembers],
        _ => Texts["Groups.New.Chosen", _wizard.RelayCount],
    };

    protected override async Task OnInitializedAsync()
    {
        _user = await CurrentUser.GetAsync();
        _candidates = await Groups.CandidatesAsync(CancellationToken.None);
    }

    // A new step's heading takes the focus, so a screen reader reads where it is.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_moved)
        {
            _moved = false;
            await _heading.FocusAsync();
        }
    }

    // "GROUP · RELAY 1 + 2 → 3", or with two or more boards "GROUP · WORKSHOP 1 + 2 → 3", as the group's card shows it.
    private string PreviewLabel()
    {
        var channels = string.Join(" → ", _wizard.Editor.Steps.Select(s => string.Join(" + ", s.Relays.Select(r => r.Channel.ToString(CultureInfo.InvariantCulture)))));
        return Texts["Relays.GroupLabel", BoardLabel is { } board ? $"{board} {channels}" : Texts["Groups.Chain", channels].Value];
    }

    private void Pick(GroupCandidate relay)
    {
        if ((relay.IsFree && _wizard.FitsBoard(relay.BoardId)) || _wizard.OrderOf(relay.RelayId) > 0)
        {
            _wizard.Toggle(relay.RelayId, relay.Channel, relay.Name, relay.BoardId);
        }
    }

    private void AddRelay((int Step, EditRelay Relay) add)
    {
        if (_candidates.FirstOrDefault(c => c.RelayId == add.Relay.RelayId) is { IsFree: true } relay)
        {
            _wizard.Add(add.Step, add.Relay, relay.BoardId);
        }
    }

    private void GoOn(int fromStep)
    {
        if (_wizard.GoOn(fromStep))
        {
            _error = null;
            _moved = true;
        }
    }

    private void Back(int fromStep)
    {
        if (!_busy && _wizard.Back(fromStep))
        {
            _error = null;
            _moved = true;
        }
    }

    private async Task CreateAsync()
    {
        if (_user is null || _busy || _wizard.Step != GroupWizard.StepCount)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var (id, error) = await Groups.CreateAsync(_wizard.Draft, _user.Email, CancellationToken.None);
            _error = error;
            if (id is not null)
            {
                Navigation.NavigateTo("");
            }
        }
        catch (Exception ex)
        {
            // An exception that leaves the handler would end the page's live connection.
            Log.LogError(ex, "Creating a group failed");
            _error = Texts["Common.SomethingWrongTryAgain"];
        }
        finally
        {
            _busy = false;
        }
    }
}
