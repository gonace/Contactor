<!-- Pinned to 13.5.4 on purpose: later releases hang at startup on Windows. 13.5.4 has two advisories for its dashboard,
     both fixed in 13.6.5 (see issue #18):
     - GHSA-f7vh-h5g3-7jrh: the dashboard's login cookie can reach a container the developer opens from the dashboard.
       This AppHost runs no containers, only our own projects.
     - GHSA-4g86-54fm-h9h8: anyone who can reach the dashboard can delete its telemetry (a standalone dashboard can also
       leak its token; ours isn't standalone). Ours listens on localhost only (Properties/launchSettings.json), so only
       the developer's own machine can reach it, and at worst it loses development telemetry.
     The dashboard is for local development only and is not in the app's image, so both are suppressed here
     (NuGetAuditSuppress below). Raise it once a release starts on Windows, and drop both suppressions with it. The SDK
     brings Aspire.Hosting.AppHost in the same version: raise them together, with any Aspire.Hosting.* package added
     later. -->
<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Contactor.AppHost</RootNamespace>
    <!-- Plain `dotnet run` works without the Aspire CLI. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <!-- ASPIRE010 warns that the CLI bundle is off; that is on purpose, see above. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only these advisories, only here; see the top of this file. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-f7vh-h5g3-7jrh" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-4g86-54fm-h9h8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Overrides Aspire's vulnerable MessagePack; see Directory.Packages.props. -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contactor.Simulator\Contactor.Simulator.csproj" />
    <ProjectReference Include="..\Contactor.Web\Contactor.Web.csproj" />
  </ItemGroup>

</Project>
