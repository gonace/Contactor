<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Contactor.AppHost</RootNamespace>
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <!-- Overrides Aspire's vulnerable MessagePack; see Directory.Packages.props. -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>
  
  <ItemGroup>
    <Using Include="Aspire.Hosting" />
    <Using Include="Aspire.Hosting.ApplicationModel" />
    <Using Include="Aspire.Hosting.Dotnet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contactor.Simulator\Contactor.Simulator.csproj" />
    <!-- The demo builds Contactor.Web and Contactor.Simulator too, whose output it starts for each visitor. -->
    <ProjectReference Include="..\Contactor.Demo\Contactor.Demo.csproj" />
  </ItemGroup>

</Project>
