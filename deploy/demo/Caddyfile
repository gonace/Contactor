# The demo's forwarder (compose.yml): it only forwards port 8080 to the demo. See docs/DEMO.md.
{
	# No admin API, no saved config and no certificates: it only forwards plain HTTP from the tunnel's connector.
	admin off
	persist_config off
	auto_https off
}

# Everything on 8080 goes to the demo, WebSockets included (the app is Blazor Server). Caddy would set
# X-Forwarded-Proto to its own scheme, http; the demo gets the one the tunnel's connector sent instead, so a visitor
# who came in over HTTPS gets a Secure cookie. Without one, the demo gets none and takes the request as http.
:8080 {
	reverse_proxy demo:8080 {
		header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
	}
}

# Its own health check, inside the container only.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond "ok"
}
