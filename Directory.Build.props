<Project>
  <PropertyGroup>
    <!-- Every build that isn't a release (local runs, Aspire, tests) is "0.0.0-dev". A release overrides it with
         -p:Version=<YYYY.M.D[.N]> (see .github/workflows/images.yml and scripts/images-publish.sh),.
         The SDK adds "+<commit>" to the informational version; AppBuild reads both parts. -->
    <Version>0.0.0-dev</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
